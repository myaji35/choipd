<% content_for :title, "브랜드 관리" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-navy">🏷️ 브랜드 관리</h1>
    <p class="text-sm text-gray-500 mt-1">전체 <%= @brands.size %>개 브랜드</p>
  </div>
  <div class="flex items-center gap-2">
    <%= form_with url: admin_brands_path, method: :get, class: "flex gap-2" do |f| %>
      <%= f.text_field :business_type, value: params[:business_type], placeholder: "업종",
          class: "border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      <%= f.select :published, [["전체", ""], ["공개", "true"], ["비공개", "false"]],
          { selected: params[:published] }, class: "border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      <%= f.submit "필터", class: "bg-gray-100 text-gray-700 px-3 py-2 rounded-lg text-sm cursor-pointer" %>
    <% end %>
    <%= link_to "+ 새 브랜드", new_admin_brand_path,
        class: "bg-primary text-white px-4 py-2 rounded-lg text-sm font-medium hover:opacity-90" %>
  </div>
</div>

<!-- View 토글 -->
<div class="mb-3 flex gap-2">
  <a href="?<%= request.query_parameters.merge(view: 'card').to_query %>" class="text-xs px-2 py-1 <%= 'bg-primary text-white' if params[:view] != 'list' %> rounded">카드 뷰</a>
  <a href="?<%= request.query_parameters.merge(view: 'list').to_query %>" class="text-xs px-2 py-1 <%= 'bg-primary text-white' if params[:view] == 'list' %> rounded">리스트 뷰</a>
</div>

<% if params[:view] != 'list' && @brands.any? %>
  <!-- 카드 그리드 -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @brands.each do |brand| %>
      <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden hover:shadow-md transition-shadow">
        <% if brand.logo_url.present? %>
          <img src="<%= brand.logo_url %>" alt="" class="w-full h-40 object-contain bg-gray-50 p-4">
        <% else %>
          <div class="w-full h-40 bg-gradient-to-br from-blue-400 to-purple-500 flex items-center justify-center text-white text-4xl">🏷️</div>
        <% end %>
        <div class="p-4">
          <div class="flex items-start justify-between mb-2">
            <h3 class="font-bold text-navy line-clamp-1"><%= brand.name %></h3>
            <% if brand.published? %>
              <span class="text-xs px-2 py-0.5 bg-green-100 text-green-700 rounded shrink-0">공개</span>
            <% else %>
              <span class="text-xs px-2 py-0.5 bg-gray-100 text-gray-500 rounded shrink-0">비공개</span>
            <% end %>
          </div>
          <p class="text-xs text-gray-500 line-clamp-2 mb-3"><%= brand.description %></p>

          <div class="flex items-center justify-between text-xs">
            <span class="text-gray-500"><%= [brand.business_type, brand.region].compact_blank.join(" · ").presence || "—" %></span>
            <% if brand.website_url.present? %>
              <span class="font-bold text-navy"><%= brand.website_url.sub(/\Ahttps?:\/\//, "").split("/").first %></span>
            <% else %>
              <span class="text-gray-400">웹사이트 없음</span>
            <% end %>
          </div>

          <% if brand.website_url.present? %>
            <a href="<%= brand.website_url %>" target="_blank" rel="noopener noreferrer" class="text-xs text-blue-600 hover:underline mt-2 block">
              🌐 웹사이트 ↗
            </a>
          <% end %>

          <div class="mt-3 pt-3 border-t border-gray-100 flex gap-2">
            <% if brand.marketing_handoff_url.present? %>
              <%= link_to "12단계 마케팅", brand.marketing_handoff_url, target: "_blank", rel: "noopener noreferrer", class: "text-xs flex-1 text-center bg-primary text-white py-1.5 rounded hover:opacity-90" %>
            <% else %>
              <span class="text-xs flex-1 text-center bg-gray-100 text-gray-400 py-1.5 rounded cursor-not-allowed" title="12단계 마케팅을 시작하려면 웹사이트 URL이 필요합니다">웹사이트 URL 필요</span>
            <% end %>
            <%= link_to "수정", edit_admin_brand_path(brand), class: "text-xs flex-1 text-center bg-gray-100 text-gray-700 py-1.5 rounded hover:bg-gray-200" %>
            <%= button_to "삭제", admin_brand_path(brand), method: :delete,
                class: "text-xs text-red-600 hover:text-red-800",
                data: { turbo_confirm: "삭제하시겠습니까?" },
                form: { class: "inline" } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <!-- 리스트 뷰 -->
  <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b">
        <tr>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase">브랜드명</th>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase">업종</th>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase">지역</th>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase">웹사이트</th>
          <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600 uppercase">상태</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y">
        <% @brands.each do |brand| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <div class="flex items-center gap-3">
                <% if brand.logo_url.present? %>
                  <img src="<%= brand.logo_url %>" alt="" class="w-10 h-10 object-contain bg-gray-50 rounded">
                <% else %>
                  <div class="w-10 h-10 bg-gray-200 rounded flex items-center justify-center text-gray-400 text-xs">🏷️</div>
                <% end %>
                <div>
                  <span class="font-medium text-navy block"><%= brand.name %></span>
                  <span class="text-xs text-gray-400 line-clamp-1"><%= brand.description %></span>
                </div>
              </div>
            </td>
            <td class="px-4 py-3 text-gray-600"><%= brand.business_type.presence || "—" %></td>
            <td class="px-4 py-3 text-gray-600"><%= brand.region.presence || "—" %></td>
            <td class="px-4 py-3">
              <% if brand.website_url.present? %>
                <a href="<%= brand.website_url %>" target="_blank" rel="noopener noreferrer" class="text-xs text-blue-600 hover:underline"><%= brand.website_url.sub(/\Ahttps?:\/\//, "").split("/").first %> ↗</a>
              <% else %>
                <span class="text-gray-300 text-xs">—</span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <% if brand.published? %>
                <span class="text-xs px-2 py-0.5 bg-green-100 text-green-700 rounded-full">공개</span>
              <% else %>
                <span class="text-xs px-2 py-0.5 bg-gray-100 text-gray-500 rounded-full">비공개</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-right space-x-2">
              <% if brand.marketing_handoff_url.present? %>
                <%= link_to "12단계 마케팅", brand.marketing_handoff_url, target: "_blank", rel: "noopener noreferrer", class: "text-xs text-primary" %>
              <% else %>
                <span class="text-xs text-gray-400 cursor-not-allowed" title="12단계 마케팅을 시작하려면 웹사이트 URL이 필요합니다">웹사이트 URL 필요</span>
              <% end %>
              <%= link_to "수정", edit_admin_brand_path(brand), class: "text-xs text-primary" %>
              <%= button_to "삭제", admin_brand_path(brand), method: :delete,
                  class: "text-xs text-red-500",
                  data: { turbo_confirm: "삭제하시겠습니까?" } %>
            </td>
          </tr>
        <% end %>
        <% if @brands.empty? %>
          <tr><td colspan="6" class="px-4 py-12 text-center text-gray-400">등록된 브랜드가 없습니다.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
