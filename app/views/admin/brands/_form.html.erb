<%= form_with model: [:admin, brand], class: "space-y-4" do |f| %>
  <% if brand.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <% brand.errors.full_messages.each do |msg| %>
        <p class="text-red-600 text-sm"><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "브랜드명", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" %>
  </div>

  <div>
    <%= f.label :slug, "슬러그", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :slug, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" %>
    <p class="text-xs text-gray-500 mt-1">비워두면 브랜드명을 기준으로 자동 생성됩니다.</p>
  </div>

  <div>
    <%= f.label :website_url, "웹사이트 URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.url_field :website_url, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" %>
  </div>

  <div>
    <%= f.label :description, "설명", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :description, rows: 4, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary resize-none" %>
  </div>

  <div>
    <%= f.label :logo_url, "로고 URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.url_field :logo_url, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :business_type, "업종", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :business_type, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" %>
    </div>
    <div>
      <%= f.label :region, "지역", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :region, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" %>
    </div>
  </div>

  <div class="flex items-center space-x-2">
    <%= f.check_box :published, class: "rounded border-gray-300 text-primary" %>
    <%= f.label :published, "공개", class: "text-sm font-medium text-gray-700" %>
  </div>

  <div class="flex space-x-3">
    <%= f.submit brand.persisted? ? "수정" : "등록", class: "bg-primary text-white px-6 py-2 rounded-lg text-sm font-medium hover:bg-blue-600 transition-colors cursor-pointer" %>
    <%= link_to "취소", admin_brands_path, class: "bg-gray-100 text-gray-700 px-6 py-2 rounded-lg text-sm font-medium hover:bg-gray-200 transition-colors" %>
  </div>
<% end %>
