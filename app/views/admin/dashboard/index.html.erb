<% content_for :title, "대시보드" %>

<!-- KPI 카드 -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
  <% cards = [
    ["전체 회원", @total_members, admin_members_path, "text-navy"],
    ["승인 대기", @pending_members, admin_members_path(status: "pending_approval"), "text-yellow-500"],
    ["승인 완료", @approved_members, admin_members_path(status: "approved"), "text-green-500"],
    ["정지", @suspended_members, admin_members_path(status: "suspended"), "text-gray-600"]
  ] %>
  <% cards.each do |label, count, path, color| %>
    <%= link_to path, class: "block bg-white rounded-lg border border-gray-100 p-5 shadow-sm hover:border-primary" do %>
      <p class="text-xs text-gray-500 uppercase tracking-wider mb-1"><%= label %></p>
      <p class="text-3xl font-bold <%= color %>"><%= count %></p>
    <% end %>
  <% end %>
</div>

<!-- 승인 대기 회원 + 문의 -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-white rounded-lg border border-gray-100 shadow-sm">
    <div class="flex items-center justify-between p-5 border-b">
      <h2 class="font-semibold text-navy">승인 대기 회원</h2>
      <%= link_to "전체 보기", admin_members_path(status: "pending_approval"), class: "text-primary text-xs hover:text-primary-dark" %>
    </div>
    <div class="divide-y">
      <% @recent_pending_members.each do |member| %>
        <%= link_to admin_member_path(member), class: "flex items-center justify-between gap-2 p-4 hover:bg-gray-50" do %>
          <div>
            <p class="text-sm font-medium text-navy"><%= member.name %></p>
            <p class="text-xs text-gray-400"><%= member.email %></p>
          </div>
          <time class="text-xs text-gray-500" datetime="<%= member.created_at.iso8601 %>"><%= member.created_at.strftime("%Y.%m.%d") %></time>
        <% end %>
      <% end %>
      <% if @recent_pending_members.empty? %>
        <p class="text-center text-gray-400 text-sm py-8">승인을 기다리는 회원이 없습니다.</p>
      <% end %>
    </div>
  </div>

  <!-- 최근 문의 -->
  <div class="bg-white rounded-lg border border-gray-100 shadow-sm">
    <div class="flex items-center justify-between p-5 border-b">
      <h2 class="font-semibold text-navy">최근 문의</h2>
      <%= link_to "전체 보기", admin_inquiries_path, class: "text-primary text-xs hover:text-primary-dark" %>
    </div>
    <div class="divide-y">
      <% @recent_inquiries.each do |inquiry| %>
        <div class="p-4">
          <div class="flex items-center justify-between mb-1">
            <p class="text-sm font-medium text-navy"><%= inquiry.name %></p>
            <span class="text-xs px-2 py-0.5 rounded-full bg-primary/10 text-primary font-medium">
              <%= inquiry.inquiry_type == 'b2b' ? 'B2B' : '일반' %>
            </span>
          </div>
          <p class="text-xs text-gray-500 line-clamp-1"><%= inquiry.message %></p>
          <p class="text-xs text-gray-400 mt-1"><%= inquiry.created_at.strftime("%Y.%m.%d %H:%M") %></p>
        </div>
      <% end %>
      <% if @recent_inquiries.empty? %>
        <p class="text-center text-gray-400 text-sm py-8">접수된 문의가 없습니다.</p>
      <% end %>
    </div>
  </div>
</div>
