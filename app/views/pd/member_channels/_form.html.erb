<% editing = @brand_channel.persisted? %>
<% platforms = Pd::MemberChannelsController::CHANNEL_PLATFORMS %>
<% platform = @brand_channel.platform.presence_in(platforms.keys) %>
<% title = "#{platforms.fetch(platform)} 채널 등록" if @lock_platform %>
<% content_for :title, title %>
<% handle_help, url_placeholder = {
  "naver_blog" => ["블로그 아이디 — blog.naver.com/ 뒤에 오는 글자. 주소를 통째로 붙여 넣어도 됩니다.", "https://blog.naver.com/아이디"],
  "facebook_page" => ["페이지 이름 — facebook.com/ 뒤에 오는 글자. 주소를 통째로 붙여 넣어도 됩니다.", "https://www.facebook.com/페이지이름"],
  "instagram" => ["@ 뒤에 오는 이름. @ 를 붙이거나 주소를 통째로 붙여 넣어도 됩니다.", "https://www.instagram.com/이름"]
}.fetch(platform, ["블로그 아이디나 @ 뒤 이름. 주소를 통째로 붙여 넣어도 됩니다.", "https://"]) %>
<% form_url = editing ? pd_member_channel_path(@member, @brand_channel) : pd_member_channels_path(@member) %>
<% field_class = "w-full min-w-0 rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
<% control_height = "min-height: 44px;" %>
<% label_class = "mb-1 block text-sm font-medium text-gray-700" %>

<header class="mb-6 break-words">
  <%= link_to "← #{@member.name} 대행 등록", pd_member_path(@member), class: "inline-flex items-center text-sm text-primary", style: control_height %>
  <h1 class="mt-2 text-xl font-bold text-navy"><%= title %></h1>
  <p class="mt-1 text-sm text-gray-600"><%= @member.name %> (/<%= @member.slug %>)</p>
</header>

<div class="max-w-2xl rounded-lg border border-gray-100 bg-white p-4 shadow-sm sm:p-6">
  <%= form_with model: @brand_channel, url: form_url, scope: :brand_channel, class: "space-y-4" do |form| %>
    <%= hidden_field_tag :lock_platform, @lock_platform ? "1" : "0" unless editing %>
    <% if @brand_channel.errors.any? %>
      <ul class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-600" role="alert">
        <% @brand_channel.errors.each do |error| %>
          <li><%= error.message %></li>
        <% end %>
      </ul>
    <% end %>
    <div>
      <% if editing %>
        <p class="<%= label_class %>">채널 종류</p>
        <p class="text-sm text-navy"><%= platforms.fetch(@brand_channel.platform) %></p>
      <% elsif @lock_platform %>
        <%= form.hidden_field :platform %>
        <p class="text-sm text-navy">종류: <%= platforms.fetch(platform) %></p>
      <% else %>
        <%= form.label :platform, "채널 종류", class: label_class %>
        <%= form.select :platform, platforms.map { |platform, label| [label, platform] }, { include_blank: "선택해 주세요" }, required: true, class: field_class, style: control_height %>
      <% end %>
    </div>
    <div>
      <%= form.label :account_handle, "계정 이름(핸들)", class: label_class %>
      <%= form.text_field :account_handle, class: field_class, style: control_height, aria: { describedby: "channel-handle-help" } %>
      <p id="channel-handle-help" class="mt-1 text-xs text-gray-600"><%= handle_help %></p>
    </div>
    <div>
      <%= form.label :profile_url, "채널 주소", class: label_class %>
      <%= form.url_field :profile_url, placeholder: url_placeholder, class: field_class, style: control_height, aria: { describedby: "channel-url-help" } %>
      <p id="channel-url-help" class="mt-1 text-xs text-gray-600">비워 두면 계정 이름으로 자동으로 채워집니다.</p>
    </div>
    <div>
      <%= form.label :notes, "메모", class: label_class %>
      <%= form.text_area :notes, rows: 3, class: field_class, style: control_height, aria: { describedby: "channel-notes-help" } %>
      <p id="channel-notes-help" class="mt-1 text-xs text-gray-600">비밀번호는 여기에 적지 마세요.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= form.submit(editing ? "저장" : "등록", class: "rounded-lg bg-primary px-6 py-2 text-sm text-white cursor-pointer", style: control_height) %>
      <% unless editing %>
        <% remaining = remaining_channel_platforms %>
        <% next_platform = (remaining - [platform]).first if platform %>
        <% if next_platform || (!platform && remaining.size > 1) %>
          <% next_label = next_platform ? "등록하고 다음: #{platforms.fetch(next_platform)}" : "등록하고 다음 채널" %>
          <%= form.button next_label, name: "next", value: "1",
              class: "rounded-lg border border-gray-300 bg-white px-6 py-2 text-sm text-gray-700 cursor-pointer", style: control_height %>
        <% end %>
      <% end %>
      <%= link_to "취소", pd_member_path(@member), class: "inline-flex items-center rounded-lg bg-gray-100 px-6 py-2 text-sm text-gray-700", style: control_height %>
    </div>
  <% end %>
  <p class="mt-4 text-xs text-gray-600">등록 뒤 회원 본인이 '내 채널'에서 운영 위탁에 동의해야 글을 올릴 수 있습니다. 동의 안내는 대행 등록 화면에서 복사할 수 있습니다.</p>
</div>
