<div class="overflow-x-auto">
  <table class="w-full text-left text-sm" aria-label="<%= title %>">
    <thead class="bg-gray-50 text-gray-700">
      <tr>
        <% headings.each do |heading| %>
          <th scope="col" class="px-3 py-2 whitespace-nowrap"><%= heading %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <tr class="border-t border-gray-100 align-top">
          <% row.each do |value| %>
            <td class="px-3 py-2 break-words"><%= value.presence || "-" %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
