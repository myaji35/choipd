<% if @draft.errors.any? %>
  <ul class="mt-2 text-sm text-red-600" role="alert">
    <% @draft.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @draft, url: form_url, class: "mt-3 space-y-3 text-sm" do |f| %>
  <div>
    <%= f.label :newsletter_name, "뉴스레터 이름", class: "block font-medium text-navy" %>
    <%= f.text_field :newsletter_name, class: "w-full rounded-lg border border-gray-200 px-3 py-2" %>
  </div>
  <div>
    <%= f.label :title, "제목", class: "block font-medium text-navy" %>
    <%= f.text_field :title, required: true, maxlength: 200, class: "w-full rounded-lg border border-gray-200 px-3 py-2" %>
  </div>
  <div>
    <%= f.label :body, "본문", class: "block font-medium text-navy" %>
    <%= f.text_area :body, rows: 12, maxlength: 100_000, class: "w-full rounded-lg border border-gray-200 px-3 py-2" %>
  </div>
  <div class="flex items-center gap-3">
    <%= f.submit "저장", class: "bg-primary text-white px-4 py-2 rounded-lg cursor-pointer" %>
    <%= link_to "취소", pd_profile_account_path(@account, anchor: "newsletter-drafts"), class: "text-primary" %>
  </div>
<% end %>
