<% profile = profile_snapshots.first.last %>
<% presenter = Linkedin::ProfilePresenter.new(profile) %>
<% score = presenter.completeness_score %>
<section class="border border-gray-100 rounded-lg p-4">
  <h2 class="font-semibold text-navy">프로필 완성도 <%= score.nil? ? "확인 못 함" : "#{score}%" %></h2>
  <progress class="w-full mt-2" max="100" <%= "value=#{score}" unless score.nil? %> aria-label="프로필 완성도"></progress>
  <ul class="mt-3 space-y-2 text-sm">
    <% presenter.completeness.each do |check| %>
      <li>
        <% unless check[:filled].nil? %>
          <%= lni_icon(check[:filled] ? "check-circle-1" : "xmark-circle") %>
        <% end %>
        <%= check[:label] %>
        <% unless check[:filled] %><p class="text-gray-500"><%= check[:hint] %></p><% end %>
      </li>
    <% end %>
  </ul>
</section>
<% presenter.sections.each do |section| %>
  <section class="border border-gray-100 rounded-lg p-4">
    <h2 class="font-semibold text-navy"><%= section[:title] %></h2>
    <% values = section.values_at(:rows, :text, :items).compact.first %>
    <% if values.nil? %>
      <p class="text-sm text-gray-500 mt-2">확인 못 함</p>
    <% elsif values.empty? %>
      <p class="text-sm text-gray-500 mt-2">비어 있음</p>
    <% elsif section[:rows] %>
      <dl class="mt-2 text-sm">
        <% values.each do |row| %>
          <div><dt class="inline text-gray-500"><%= row[:label] %></dt> <dd class="inline"><%= row[:value] %></dd></div>
        <% end %>
      </dl>
    <% elsif section.key?(:text) %>
      <p class="mt-2 text-sm whitespace-pre-line"><%= values %></p>
    <% else %>
      <ul class="mt-2 text-sm list-disc list-inside">
        <% values.each do |item| %><li class="whitespace-pre-line"><%= item %></li><% end %>
      </ul>
    <% end %>
  </section>
<% end %>
<section class="border border-gray-100 rounded-lg p-4">
  <h2 class="font-semibold text-navy">프로필 변경 내역</h2>
  <% if profile_snapshots.size < 2 %>
    <p class="text-sm text-gray-500 mt-2">아직 비교할 이전 사본이 없습니다.</p>
  <% end %>
  <% profile_snapshots.each_cons(2) do |(newer, after), (older, before)| %>
    <h3 class="text-sm font-medium mt-3"><%= newer.captured_at.localtime.strftime("%Y-%m-%d %H:%M:%S") %> · 이전 사본 <%= older.captured_at.localtime.strftime("%Y-%m-%d %H:%M:%S") %></h3>
    <% changes = Linkedin::ProfileDiffer.new(before, after).changes %>
    <% if changes.empty? %>
      <p class="text-sm text-gray-500">항목별 변경이 없습니다.</p>
    <% else %>
      <ul class="text-sm list-disc list-inside">
        <% changes.each do |change| %>
          <li>
            <%= change[:section] %> · <%= { "added" => "추가", "removed" => "삭제", "changed" => "변경" }.fetch(change[:kind]) %> · <%= change[:label] %>
            <%= change[:before].presence || "-" %> → <%= change[:after].presence || "-" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</section>
<section class="border border-gray-100 rounded-lg p-4">
  <h2 class="font-semibold text-navy">네이버 인물정보와 다른 점</h2>
  <% if naver_snapshot.nil? %>
    <p class="text-sm text-gray-500 mt-2">비교할 네이버 인물정보 사본이 없습니다.</p>
  <% else %>
    <% comparison = Linkedin::NaverComparison.new(profile, NaverPeople::Presenter.new(naver_snapshot.data)) %>
    <% if !comparison.comparable? %>
      <p class="text-sm text-gray-500 mt-2">LinkedIn 프로필을 아직 읽지 못해 비교하지 못했습니다</p>
    <% elsif (mismatches = comparison.mismatches).empty? %>
      <p class="text-sm text-gray-500 mt-2">다른 점이 없습니다.</p>
    <% else %>
      <ul class="mt-2 text-sm space-y-2">
        <% mismatches.each do |item| %>
          <li>
            <p class="font-medium"><%= item[:topic] %> · <%= item[:note] %></p>
            <p>LinkedIn <%= item[:linkedin].presence || "-" %> · 네이버 <%= item[:naver].presence || "-" %></p>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</section>
