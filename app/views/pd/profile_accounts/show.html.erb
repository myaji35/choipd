<% content_for :title, "인물정보 계정 상세" %>
<div class="mb-6"><%= link_to "← 인물정보 계정", pd_profile_accounts_path, class: "text-primary text-sm" %><h1 class="text-xl font-bold text-navy mt-2"><%= @account.display_name %></h1></div>
<div class="bg-white rounded-lg border border-gray-100 shadow-sm p-6 space-y-4">
  <dl class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
    <% { "플랫폼" => @account.platform_label, "로그인 아이디" => @account.login_id, "외부 ID" => @account.external_id, "직함/직업" => @account.headline, "권한" => @account.auth_status, "상태" => @account.session_status_label, "마지막 점검" => @account.last_checked_at&.localtime&.strftime("%Y-%m-%d %H:%M"), "활성화" => (@account.is_active? ? "활성" : "비활성"), "메모" => @account.notes, "최근 오류" => @account.last_error }.each do |label, value| %><div class="min-w-0"><dt class="text-gray-500"><%= label %></dt><dd class="text-navy break-all"><%= value.presence || "-" %></dd></div><% end %>
    <div class="min-w-0"><dt class="text-gray-500">프로필 링크</dt><dd class="break-all"><% if (url = http_url(@account.profile_url)) %><%= link_to url, url, target: "_blank", rel: "noopener", class: "text-primary" %><% else %>-<% end %></dd></div>
  </dl>
  <div class="flex gap-3"><%= link_to "수정", edit_pd_profile_account_path(@account), class: "text-primary text-sm" %><%= button_to "삭제", pd_profile_account_path(@account), method: :delete, class: "text-red-600 text-sm", data: { turbo_confirm: "삭제하시겠습니까?" } %></div>
  <% if @account.platform == "naver_people" && @latest_snapshot %>
    <% presenter = NaverPeople::Presenter.new(@latest_snapshot.data) %>
    <section class="border border-gray-100 rounded-lg p-4">
      <h2 class="font-semibold text-navy">완성도 <%= presenter.completeness_score %>%</h2><progress class="w-full mt-2" max="100" value="<%= presenter.completeness_score %>" aria-label="네이버 완성도"></progress>
      <ul class="mt-3 space-y-2 text-sm"><% presenter.completeness.each do |check| %>
        <li><%= lni_icon(check[:filled] ? "check-circle-1" : "xmark-circle") %> <%= check[:label] %><% unless check[:filled] %><p class="text-gray-500 ml-5"><%= check[:hint] %></p><% end %></li>
      <% end %></ul>
    </section>
    <% presenter.sections.each do |section| %>
      <section class="border border-gray-100 rounded-lg p-4">
        <h2 class="font-semibold text-navy"><%= section[:title] %></h2>
        <% values = section[:rows] || section[:items] %>
        <% if values.empty? %><p class="text-sm text-gray-500 mt-2">비어 있음</p>
        <% elsif section[:rows] %><dl class="mt-2 text-sm"><% values.each do |row| %><div><dt class="inline text-gray-500"><%= row[:label] %></dt> <dd class="inline"><%= row[:value] %></dd></div><% end %></dl>
        <% else %><ul class="mt-2 text-sm list-disc list-inside"><% values.each do |item| %><li><%= item %></li><% end %></ul><% end %>
      </section>
    <% end %>
    <section class="border border-gray-100 rounded-lg p-4">
      <h2 class="font-semibold text-navy">변경 내역</h2>
      <% if @snapshots.size < 2 %><p class="text-sm text-gray-500 mt-2">아직 비교할 이전 사본이 없습니다.</p>
      <% else %><% @snapshots.first(10).each_cons(2) do |newer, older| %>
        <h3 class="text-sm font-medium mt-3"><%= newer.captured_at.localtime.strftime("%Y-%m-%d %H:%M:%S") %> · 이전 사본 <%= older.captured_at.localtime.strftime("%Y-%m-%d %H:%M:%S") %></h3>
        <% changes = NaverPeople::Differ.new(older.data, newer.data).changes %>
        <% if changes.empty? %><p class="text-sm text-gray-500">항목별 변경이 없습니다.</p><% else %><ul class="text-sm list-disc list-inside"><% changes.each do |change| %><li><%= change[:section] %> · <%= { "added" => "추가", "removed" => "삭제", "changed" => "변경" }[change[:kind]] %> · <%= change[:label] %>: <%= change[:before].presence || "-" %> → <%= change[:after].presence || "-" %></li><% end %></ul><% end %>
      <% end %><% end %>
    </section>
  <% end %>
  <h2 class="font-semibold text-navy">최근 사본</h2>
  <% if @snapshots.empty? %><p class="text-sm text-gray-500">저장된 사본이 없습니다.</p><% else %><ul class="text-sm text-gray-700"><% @snapshots.each do |snapshot| %><li><%= snapshot.captured_at.localtime.strftime("%Y-%m-%d %H:%M:%S") %> · <%= snapshot.source %></li><% end %></ul><details><summary class="cursor-pointer text-primary text-sm">최신 사본 데이터 보기</summary><pre class="overflow-auto max-h-96 bg-gray-50 p-4 text-xs"><%= JSON.pretty_generate(@latest_snapshot.data) %></pre></details><% end %>
</div>
