<% content_for :title, "인물정보 계정 상세" %>
<div class="mb-6"><%= link_to "← 인물정보 계정", pd_profile_accounts_path, class: "text-primary text-sm" %><h1 class="text-xl font-bold text-navy mt-2"><%= @account.display_name %></h1></div>
<div class="bg-white rounded-lg border border-gray-100 shadow-sm p-6 space-y-4">
  <dl class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
    <% { "플랫폼" => @account.platform_label, "로그인 아이디" => @account.login_id, "외부 ID" => @account.external_id, "직함/직업" => @account.headline, "권한" => @account.auth_status, "상태" => @account.session_status_label, "마지막 점검" => @account.last_checked_at&.localtime&.strftime("%Y-%m-%d %H:%M"), "활성화" => (@account.is_active? ? "활성" : "비활성"), "메모" => @account.notes, "최근 오류" => @account.last_error }.each do |label, value| %><div class="min-w-0"><dt class="text-gray-500"><%= label %></dt><dd class="text-navy break-all"><%= value.presence || "-" %></dd></div><% end %>
    <div class="min-w-0"><dt class="text-gray-500">프로필 링크</dt><dd class="break-all"><% if @account.profile_url.present? %><%= link_to @account.profile_url, @account.profile_url, target: "_blank", rel: "noopener", class: "text-primary" %><% else %>-<% end %></dd></div>
  </dl>
  <div class="flex gap-3"><%= link_to "수정", edit_pd_profile_account_path(@account), class: "text-primary text-sm" %><%= button_to "삭제", pd_profile_account_path(@account), method: :delete, class: "text-red-600 text-sm", data: { turbo_confirm: "삭제하시겠습니까?" } %></div>
  <h2 class="font-semibold text-navy">최근 사본</h2>
  <% if @snapshots.empty? %><p class="text-sm text-gray-500">저장된 사본이 없습니다.</p><% else %><ul class="text-sm text-gray-700"><% @snapshots.each do |snapshot| %><li><%= snapshot.captured_at.localtime.strftime("%Y-%m-%d %H:%M:%S") %> · <%= snapshot.source %></li><% end %></ul><details><summary class="cursor-pointer text-primary text-sm">최신 사본 데이터 보기</summary><pre class="overflow-auto max-h-96 bg-gray-50 p-4 text-xs"><%= JSON.pretty_generate(@latest_snapshot.data) %></pre></details><% end %>
</div>
