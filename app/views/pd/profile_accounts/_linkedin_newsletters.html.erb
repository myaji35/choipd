<% newsletters = monitor.newsletters %>
<% series = monitor.newsletter_series %>
<% names = series.flat_map { |row| row[:values].keys }.uniq %>
<% authors = newsletters.select { |entry| entry[:role] == "author" } %>
<% archived, active = drafts.partition { |draft| draft.status == "archived" } %>

<section class="border border-gray-100 rounded-lg p-4">
  <h2 class="font-semibold text-navy">LinkedIn 뉴스레터</h2>
  <% if newsletters.empty? %>
    <p class="mt-2 text-sm text-gray-500"><%= monitor.newsletters_collected? ? "저장된 뉴스레터가 없습니다." : "다음 점검부터 뉴스레터를 모읍니다." %></p>
  <% end %>
  <% newsletters.each do |entry| %>
    <% delta = entry[:subscribers_delta] %>
    <article class="mt-3 rounded-lg border border-gray-100 p-3 text-sm">
      <h3 class="font-medium text-navy">
        <%= link_to entry[:name], entry[:url], target: "_blank", rel: "noopener", class: "text-primary" %>
        · <%= entry[:role] == "author" ? "글쓴이" : "구독 중" %>
      </h3>
      <dl class="mt-2 grid grid-cols-1 md:grid-cols-2 gap-2">
        <div><dt class="text-gray-500">구독자 수</dt><dd><%= number_with_delimiter(entry[:subscribers]) || "—" %></dd></div>
        <div><dt class="text-gray-500">이전 사본 날짜 대비</dt><dd><%= delta.nil? ? "비교 자료 없음" : (delta.zero? ? "변화 없음" : format("%+d", delta)) %></dd></div>
        <div><dt class="text-gray-500">최근 7일 신규 구독자</dt><dd><%= number_with_delimiter(entry[:new_subscribers_7d]) || "—" %></dd></div>
        <div><dt class="text-gray-500">발행 주기</dt><dd><%= entry[:cadence] || "—" %></dd></div>
      </dl>
      <% if entry[:role] == "author" %>
        <h4 class="mt-3 font-medium text-navy">발행 글</h4>
        <% if entry[:editions].empty? %>
          <p class="mt-2 text-gray-500">저장된 발행 글이 없습니다.</p>
        <% else %>
          <div class="mt-2 overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-gray-50 text-navy">
                <tr><th scope="col" class="p-2 text-left">제목</th><th scope="col" class="p-2 text-left">발행일</th><th scope="col" class="p-2 text-right">조회(노출) 수</th></tr>
              </thead>
              <tbody>
                <% entry[:editions].each do |edition| %>
                  <tr class="border-t border-gray-100">
                    <th scope="row" class="p-2 text-left font-medium">
                      <% if edition[:url] %>
                        <%= link_to edition[:title], edition[:url], target: "_blank", rel: "noopener", class: "text-primary" %>
                      <% else %>
                        <%= edition[:title] %>
                      <% end %>
                    </th>
                    <td class="p-2"><%= edition[:published_relative] %></td>
                    <td class="p-2 text-right"><%= number_with_delimiter(edition[:impressions]) || "—" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      <% end %>
    </article>
  <% end %>

  <h3 class="mt-4 text-sm font-medium text-navy">구독자 날짜별 추이</h3>
  <% if series.empty? %>
    <p class="mt-2 text-sm text-gray-500">최근 30일 동안 저장된 뉴스레터 사본이 없습니다.</p>
  <% else %>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-navy">
          <tr>
            <th scope="col" class="p-2 text-left">날짜</th>
            <% names.each do |name| %>
              <th scope="col" class="p-2 text-right"><%= name %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% series.each do |row| %>
            <tr class="border-t border-gray-100">
              <th scope="row" class="p-2 text-left font-medium"><%= row[:date].iso8601 %></th>
              <% names.each do |name| %>
                <td class="p-2 text-right"><%= number_with_delimiter(row[:values][name]) || "—" %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>

<section id="newsletter-drafts" class="border border-gray-100 rounded-lg p-4">
  <h2 class="font-semibold text-navy">뉴스레터 글 초안</h2>
  <p class="mt-2 text-sm text-gray-500">저장한 글은 승인하면 LinkedIn에 발행됩니다.</p>
  <%= form_with model: LinkedinNewsletterDraft.new, url: pd_profile_account_newsletter_drafts_path(account), class: "mt-3 space-y-3 text-sm" do |f| %>
    <div>
      <%= f.label :newsletter_name, "뉴스레터 이름", class: "block font-medium text-navy" %>
      <%= f.select :newsletter_name, authors.pluck(:name).uniq, { include_blank: "선택 안 함" }, class: "w-full rounded-lg border border-gray-200 px-3 py-2" %>
    </div>
    <div>
      <%= f.label :title, "제목", class: "block font-medium text-navy" %>
      <%= f.text_field :title, required: true, maxlength: 200, class: "w-full rounded-lg border border-gray-200 px-3 py-2" %>
    </div>
    <div>
      <%= f.label :body, "본문", class: "block font-medium text-navy" %>
      <%= f.text_area :body, rows: 6, maxlength: 100_000, class: "w-full rounded-lg border border-gray-200 px-3 py-2" %>
    </div>
    <%= f.submit "저장", class: "bg-primary text-white px-4 py-2 rounded-lg cursor-pointer" %>
  <% end %>

  <h3 class="mt-4 text-sm font-medium text-navy">뉴스레터 글</h3>
  <% if active.empty? %>
    <p class="mt-2 text-sm text-gray-500">저장된 글이 없습니다.</p>
  <% else %>
    <% labels = { "draft" => "초안", "publishing" => "발행 중", "published" => "발행됨", "failed" => "실패" } %>
    <ul class="mt-2 divide-y divide-gray-100 break-words text-sm">
      <% active.each do |draft| %>
        <li class="py-2">
          <p class="font-medium text-navy"><%= draft.title %></p>
          <p class="text-gray-500"><%= draft.newsletter_name.presence || "—" %> · 수정 <%= draft.updated_at.in_time_zone(Linkedin::Monitor::TIME_ZONE).strftime("%Y-%m-%d %H:%M") %></p>
          <p class="text-gray-600">
            <strong><%= (draft.status == "published") && draft.published_url.blank? ? "게시됨(확인 필요)" : labels[draft.status] %></strong>
            <% if draft.published_at %>
              · 발행 <%= draft.published_at.in_time_zone(Linkedin::Monitor::TIME_ZONE).strftime("%Y-%m-%d %H:%M") %>
            <% end %>
          </p>
          <% if (url = http_url(draft.published_url)) %>
            <%= link_to "발행 글 열기", url, target: "_blank", rel: "noopener", class: "text-primary" %>
          <% elsif draft.status.in?(%w[failed published]) %>
            <p class="<%= draft.status == "failed" ? "text-red-600" : "text-gray-600" %>"><%= draft.result_message %></p>
          <% end %>
          <% unless draft.publishing_locked? %>
            <div class="mt-1 flex flex-wrap items-center gap-3">
              <%= link_to "수정", edit_pd_profile_account_newsletter_draft_path(account, draft), class: "text-primary" %>
              <%= button_to "승인하고 발행", publish_pd_profile_account_newsletter_draft_path(account, draft), method: :patch, class: "text-primary cursor-pointer", form: { data: { turbo_confirm: "LinkedIn에 실제로 게시됩니다. 계속할까요?" } } %>
              <%= button_to "보관", archive_pd_profile_account_newsletter_draft_path(account, draft), method: :patch, class: "text-gray-700 cursor-pointer" %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <details class="mt-4 text-sm">
    <summary class="cursor-pointer font-medium text-navy">보관함 (<%= archived.size %>)</summary>
    <% if archived.empty? %>
      <p class="mt-2 text-gray-500">보관된 초안이 없습니다.</p>
    <% else %>
      <ul class="mt-2 divide-y divide-gray-100 break-words">
        <% archived.each do |draft| %>
          <li class="py-2">
            <p class="font-medium text-navy"><%= draft.title %> · <%= draft.newsletter_name.presence || "—" %></p>
            <%= button_to "되살리기", restore_pd_profile_account_newsletter_draft_path(account, draft), method: :patch, class: "mt-1 text-primary cursor-pointer" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </details>
</section>
