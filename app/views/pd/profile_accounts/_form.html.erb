<% member_registration = @lock_member && @member %>
<%= form_with model: [:pd, account], class: "space-y-4" do |f| %>
  <%= hidden_field_tag :lock_member, @lock_member ? "1" : "0" %>
  <%= hidden_field_tag :lock_platform, @lock_platform ? "1" : "0" %>
  <% if account.errors.any? %><div class="bg-red-50 border border-red-200 rounded-lg p-4"><% account.errors.full_messages.each do |message| %><p class="text-red-600 text-sm"><%= message %></p><% end %></div><% end %>
  <% if @lock_platform %>
    <%= f.hidden_field :platform %>
    <p class="text-sm text-gray-700">종류: <%= account.platform_label %></p>
  <% else %>
    <div><%= f.label :platform, "플랫폼", class: "block text-sm font-medium text-gray-700 mb-1" %><%= f.select :platform, ProfileAccount::PLATFORMS.map { |key, value| [value, key] }, {}, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %></div>
  <% end %>
  <% if member_registration %>
    <%= f.hidden_field :member_id %>
    <p class="break-words text-sm text-gray-700">회원: <%= @member.name %> (/<%= @member.slug %>)</p>
  <% else %>
    <div>
      <%= f.label :member_id, "회원", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <% member_options = Member.for_tenant.publicly_visible.order(:name, :slug).pluck(:id, :name, :slug).map { |id, name, slug| ["#{name} (#{slug})", id] } %>
      <% if @member && member_options.none? { |_, id| id == @member.id } %>
        <% member_options << ["#{@member.name} (#{member_status_label(@member.status)})", @member.id] %>
      <% end %>
      <%= f.select :member_id, member_options,
          { include_blank: "연결 안 함" }, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>
  <% end %>
  <% field_help = {
    display_name: "네이버 인물정보·LinkedIn 에 나오는 이름 그대로 적어 주세요.",
    login_id: "회원이 알려 준 로그인 아이디(이메일)입니다. 비밀번호는 여기에 적지 않습니다.",
    external_id: "모르면 비워 두세요. 점검이 찾아낸 계정에는 자동으로 채워져 있습니다."
  } %>
  <% text_field = ->(field, label) { capture do %>
    <% help_id = field_help.key?(field) ? f.field_id(field, :help) : nil %>
    <div>
      <%= f.label field, label, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field field, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm", aria: { describedby: help_id } %>
      <% if help_id %>
        <p id="<%= help_id %>" class="mt-1 text-xs text-gray-600"><%= field_help.fetch(field) %></p>
      <% end %>
    </div>
  <% end } %>
  <%= text_field.call(:display_name, "프로필에 표시되는 이름") %>
  <%= text_field.call(:login_id, "로그인 아이디") %>
  <% optional_fields = capture do %>
    <%= text_field.call(:external_id, "외부 ID") %>
    <%= text_field.call(:headline, "직함/직업") %>
  <% end %>
  <%= optional_fields unless member_registration %>
  <%= text_field.call(:profile_url, "프로필 링크") %>
  <div><%= f.label :notes, "메모", class: "block text-sm font-medium text-gray-700 mb-1" %><%= f.text_area :notes, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %></div>
  <% active_field = capture do %>
    <div><%= f.check_box :is_active, class: "rounded border-gray-300 text-primary" %> <%= f.label :is_active, "활성화", class: "text-sm text-gray-700" %></div>
  <% end %>
  <% if member_registration %>
    <% extra_fields = [:external_id, :headline, :is_active] %>
    <% show_extra_fields = account.errors.any? && (account.external_id.present? || account.headline.present? ||
        account.will_save_change_to_is_active? || extra_fields.any? { |field| account.errors[field].any? }) %>
    <%= tag.details open: show_extra_fields do %>
      <summary class="cursor-pointer py-3 text-sm text-primary" style="min-height: 44px;">더 적기 (외부 ID·직함 — 비워 둬도 등록됩니다)</summary>
      <div class="space-y-4">
        <%= optional_fields %>
        <%= active_field %>
      </div>
    <% end %>
    <% submit_label = "계정 등록" %>
    <% cancel_path = pd_member_path(@member, anchor: "accounts") %>
  <% else %>
    <%= active_field %>
    <% submit_label = account.persisted? ? "수정" : "추가" %>
    <% cancel_path = pd_profile_accounts_path %>
  <% end %>
  <% button_height = "min-height: 44px;" if member_registration %>
  <div class="<%= member_registration ? "flex flex-wrap gap-3" : "flex gap-3" %>">
    <%= f.submit submit_label, class: "bg-primary text-white px-6 py-2 rounded-lg text-sm cursor-pointer", style: button_height %>
    <% if member_registration && more_registrations? %>
      <%= button_tag "등록하고 다음", name: "next", value: "1",
          class: "rounded-lg border border-gray-300 px-6 py-2 text-sm text-primary cursor-pointer", style: button_height %>
    <% end %>
    <%= link_to "취소", cancel_path, class: "#{member_registration ? "inline-flex items-center " : ""}bg-gray-100 text-gray-700 px-6 py-2 rounded-lg text-sm", style: button_height %>
  </div>
<% end %>
