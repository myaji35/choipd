<% content_for :title, "#{@member.name} 대행 등록" %>

<header class="mb-6">
  <%= link_to "← 회원 대행 등록", pd_members_path, class: "text-sm text-primary" %>
  <div class="mt-2 flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0 max-w-full break-words">
      <h1 class="text-xl font-bold text-navy"><%= @member.name %> 대행 등록</h1>
      <p class="text-sm text-gray-500">/<%= @member.slug %></p>
    </div>
    <% if @member.slug.present? %>
      <%= link_to "회원 화면에서 확인", slug_admin_dashboard_path(slug: @member.slug), class: "bg-primary text-white px-4 py-2 rounded-lg text-sm" %>
    <% end %>
  </div>
</header>

<section id="accounts" class="mb-6 rounded-lg border border-gray-100 bg-white p-4 shadow-sm">
  <h2 class="font-semibold text-navy">프로필 계정</h2>
  <ul class="mt-2 divide-y divide-gray-100 text-sm">
    <% ProfileAccount::PLATFORMS.each do |platform, label| %>
      <% if (accounts = @accounts_by_platform[platform]) %>
        <% accounts.each do |account| %>
          <li class="flex flex-wrap items-center gap-x-4 gap-y-1 py-2">
            <p class="min-w-0 max-w-full grow break-words text-navy"><%= label %> · <%= account.display_name %></p>
            <span class="text-gray-600"><%= account.session_status_label %></span>
            <%= link_to "계정 상세", pd_profile_account_path(account), class: "text-primary hover:underline" %>
          </li>
        <% end %>
      <% else %>
        <li class="flex flex-wrap items-center justify-between gap-2 py-2">
          <p class="text-gray-600"><%= label %> 등록 전</p>
          <%= link_to "계정 등록", new_pd_profile_account_path(member_id: @member.id, platform: platform), class: "text-primary hover:underline" %>
        </li>
      <% end %>
    <% end %>
  </ul>
</section>

<section id="channels" class="rounded-lg border border-gray-100 bg-white p-4 shadow-sm">
  <h2 class="font-semibold text-navy">채널</h2>
  <p class="mt-2 text-sm text-gray-600">등록하면 회원 대시보드 '내 채널 운영 현황'과 '내 채널'에 바로 보입니다.</p>
  <ul class="mt-2 divide-y divide-gray-100 text-sm">
    <% Pd::MembersController::CHANNEL_PLATFORMS.each do |platform, label| %>
      <% if (channels = @channels_by_platform[platform]) %>
        <% channels.each do |channel| %>
          <li class="flex flex-wrap items-start justify-between gap-2 py-2">
            <div class="min-w-0 max-w-full break-words">
              <p class="text-navy"><%= label %> · <%= channel.account_handle.presence || "계정 이름 미입력" %></p>
              <p class="mt-1 text-gray-600">
                <% if channel.delegated? %>
                  운영 위탁 동의함 · <%= channel.delegation_consent_at.in_time_zone("Asia/Seoul").strftime("%Y.%m.%d") %>
                <% else %>
                  운영 위탁 동의 대기 — 회원이 '내 채널'에서 직접 동의해야 글을 올릴 수 있습니다.
                <% end %>
              </p>
            </div>
            <%= link_to "수정", edit_pd_member_channel_path(@member, channel), class: "text-primary hover:underline" %>
          </li>
        <% end %>
      <% else %>
        <li class="flex flex-wrap items-center justify-between gap-2 py-2">
          <p class="text-gray-600"><%= label %> 등록 전</p>
          <%= link_to "채널 등록", new_pd_member_channel_path(@member, platform: platform), class: "text-primary hover:underline" %>
        </li>
      <% end %>
    <% end %>
  </ul>
</section>

<p class="mt-4 text-xs text-gray-600">위탁 동의는 회원 본인만 할 수 있습니다. 채널 삭제와 로그인 보관 설정은 운영자 화면에서 합니다.</p>
