<% content_for :title, "회원 대행 등록" %>

<header class="mb-6">
  <h1 class="text-xl font-bold text-navy">회원 대행 등록</h1>
  <p class="mt-2 text-sm text-gray-600">회원 대신 프로필 계정(네이버 인물정보·LinkedIn)과 채널(네이버 블로그·페이스북·인스타그램)을 등록하는 곳입니다.</p>
</header>

<%= form_with url: pd_members_path, method: :get, class: "mb-6 flex flex-wrap items-center gap-2" do |form| %>
  <%= hidden_field_tag :filter, @filter if @filter %>
  <%= form.label :q, "이름·이메일·주소(슬러그) 검색", class: "sr-only" %>
  <%= form.search_field :q, value: params[:q], placeholder: "이름·이메일·주소(슬러그) 검색", class: "min-w-0 max-w-full flex-1 basis-52 rounded-lg border border-gray-300 px-3 py-2 text-sm", style: "min-height: 44px;" %>
  <%= form.submit "검색", class: "rounded-lg bg-primary px-4 py-2 text-sm text-white cursor-pointer", style: "min-height: 44px;" %>
<% end %>

<div class="mb-4 flex flex-wrap gap-3">
  <% { nil => ["전체", :all], "progress" => ["등록 중", :progress], "todo" => ["등록 남음", :todo], "consent" => ["위탁 동의 대기", :consent] }.each do |filter, (label, count_key)| %>
    <% selected = @filter == filter %>
    <%= link_to "#{label} #{@counts.fetch(count_key)}", pd_members_path(q: params[:q].presence, filter: filter),
        aria: { current: ("true" if selected) }, style: "min-height: 44px;",
        class: ["inline-flex items-center text-sm text-primary hover:underline", ("font-bold" if selected)] %>
  <% end %>
</div>

<% if @rows.empty? %>
  <p class="rounded-lg border border-gray-100 bg-white p-4 text-sm text-gray-600 shadow-sm">
    <%= case @filter
        when "progress" then "등록하다 만 회원이 없습니다."
        when "todo" then "등록이 남은 회원이 없습니다."
        when "consent" then "위탁 동의를 기다리는 회원이 없습니다."
        else "조건에 맞는 회원이 없습니다."
        end %>
  </p>
<% else %>
  <ul class="divide-y divide-gray-100 rounded-lg border border-gray-100 bg-white shadow-sm">
    <% @rows.each do |row| %>
      <% member, account_count, channel_count, consent_waiting = row.values_at(:member, :account_count, :channel_count, :consent_waiting) %>
      <li class="flex flex-wrap items-center gap-x-2 gap-y-1 sm:gap-x-4 px-4 py-3 text-sm">
        <div class="w-full min-w-0 max-w-full grow break-words sm:w-auto">
          <strong class="text-navy"><%= member.name %></strong>
          <span class="text-gray-500">/<%= member.slug %></span>
          <% if registration_in_progress?(row) %>
            <span class="inline-flex rounded border border-gray-400 px-2 py-0.5 text-xs text-gray-700">등록 중</span>
          <% end %>
          <% unless member.can_sign_in? %>
            <span class="inline-flex rounded border border-gray-400 px-2 py-0.5 text-xs text-gray-700"><%= member_login_status_label(member) %> · 로그인 불가</span>
          <% end %>
        </div>
        <span class="text-gray-600">프로필 계정 <%= account_count %>/2</span>
        <span class="text-gray-600">채널 <%= channel_count %>/3</span>
        <% if consent_waiting.positive? %>
          <span class="text-gray-600">동의 대기 <%= consent_waiting %></span>
        <% elsif account_count == 2 && channel_count == 3 %>
          <span class="text-gray-600">등록 완료</span>
        <% end %>
        <%= link_to "등록·확인", pd_member_path(member), class: "ml-auto inline-flex items-center text-primary hover:underline", style: "min-height: 44px;" %>
      </li>
    <% end %>
  </ul>
<% end %>
