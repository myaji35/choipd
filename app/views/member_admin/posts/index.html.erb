<% content_for :title, "소식 — #{@member.name}" %>
<% posts = @posts.to_a %>

<div class="impd-wrap" style="max-width: 1120px; margin: 0 auto; padding: 40px;">
  <header style="margin-bottom: 32px;">
    <p class="impd-label-muted">내 페이지 › 소식</p>
    <h1 class="impd-display" style="font-size: 44px; margin-top: 12px;">소식</h1>
    <p style="margin-top: 12px; color: var(--impd-ink2); font-size: 14px; line-height: 1.7;">
      요즘 하는 일을 짧게 적어 두세요. 공개한 소식이 있으면 내 페이지에 '오늘도 활동 중' 표시가 7일 동안 켜져요.
    </p>
    <% if posts.any? %>
      <a href="#new-post" class="impd-btn impd-btn-accent impd-jump-new">+ 새 소식 쓰기</a>
    <% end %>
  </header>

  <div class="posts-layout<%= ' is-empty' if posts.empty? %>" style="display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 32px; align-items: start;">
    <section>
      <div class="impd-section-header">
        <h2 class="impd-display" style="font-size: 24px; flex: 1;">내 소식</h2>
        <span class="impd-label-muted"><%= posts.size %>개</span>
      </div>

      <% if posts.any? %>
        <div style="display: grid; gap: 14px;">
          <%= render partial: "post_card", collection: posts.first(5), as: :post %>
        </div>
        <% older = posts.drop(5) %>
        <% if older.any? %>
          <% older_open = older.any? { |post| flash[:saved_item] == "post-#{post.id}" || (@post == post && @post.errors.any?) } %>
          <details class="posts-older"<%= " open" if older_open %>>
            <summary>지난 소식 <%= older.size %>개 더 보기</summary>
            <div style="display: grid; gap: 14px; margin-top: 14px;">
              <%= render partial: "post_card", collection: older, as: :post %>
            </div>
          </details>
        <% end %>
      <% else %>
        <div class="impd-card" style="padding: 40px 24px; text-align: center;">
          <p style="font-size: 14px; color: var(--impd-ink2); line-height: 1.7;">아직 올린 소식이 없어요. '새 소식 쓰기'에 요즘 하는 일을 한두 줄 적어 보세요.</p>
        </div>
      <% end %>
    </section>

    <section id="new-post" class="impd-card" style="position: sticky; top: 88px; scroll-margin-top: 16px;">
      <div class="impd-section-header" style="margin-bottom: 20px;">
        <h2 class="impd-display" style="font-size: 24px;">새 소식 쓰기</h2>
      </div>
      <%= form_with model: (@new_post || MemberPost.new), url: slug_admin_posts_path(slug: @member.slug), data: { controller: "unsaved-guard" } do |form| %>
        <%= render "post_fields", form: form %>
        <label class="impd-check">
          <%= form.check_box :is_published, { checked: @new_post.nil? || @new_post.is_published.to_i == 1, aria: { describedby: "post-visibility-help" } }, 1, 0 %>
          내 페이지에 바로 보이기
        </label>
        <p id="post-visibility-help" class="impd-field-help">체크를 풀면 나만 보는 글로 저장돼요.</p>
        <%= form.submit "소식 올리기", class: "impd-btn impd-btn-primary", style: "width: 100%; height: 48px; margin-top: 16px;" %>
      <% end %>
    </section>
  </div>
</div>

<style>
  .post-preview { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; margin-top: 6px; font-size: 14px; color: var(--impd-ink2); }
  .posts-older { margin-top: 14px; }
  .posts-older > summary { cursor: pointer; display: flex; align-items: center; justify-content: center; min-height: 48px; border: 1px dashed var(--impd-rule); color: var(--impd-ink2); font-size: 14px; font-weight: 600; }
  @media (max-width: 820px) {
    .posts-layout.is-empty > section:last-child { order: -1; }
    .impd-wrap { padding: 28px 20px !important; }
    .posts-layout { grid-template-columns: minmax(0, 1fr) !important; }
    #new-post { position: static !important; }
  }
</style>
