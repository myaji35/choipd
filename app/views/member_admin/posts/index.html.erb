<% content_for :title, "소식 — #{@member.name}" %>

<div class="impd-wrap" style="max-width: 1120px; margin: 0 auto; padding: 40px;">
  <header style="margin-bottom: 32px;">
    <p class="impd-label-muted">내 페이지 › 소식</p>
    <h1 class="impd-display" style="font-size: 44px; margin-top: 12px;">소식</h1>
    <p style="margin-top: 12px; color: var(--impd-ink2); font-size: 14px; line-height: 1.7;">
      요즘 하는 일을 짧게 적어 두세요. 공개한 소식이 있으면 내 페이지에 '오늘도 활동 중' 표시가 7일 동안 켜져요.
    </p>
    <% if @posts.any? %>
      <a href="#new-post" class="impd-btn impd-btn-accent impd-jump-new">+ 새 소식 쓰기</a>
    <% end %>
  </header>

  <div class="posts-layout<%= ' is-empty' if @posts.empty? %>" style="display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 32px; align-items: start;">
    <section>
      <div class="impd-section-header">
        <h2 class="impd-display" style="font-size: 24px; flex: 1;">내 소식</h2>
        <span class="impd-label-muted"><%= @posts.size %>개</span>
      </div>

      <% if @posts.any? %>
        <div style="display: grid; gap: 14px;">
          <% @posts.each do |post| %>
            <% published = post.is_published.to_i == 1 %>
            <% edit_failed = @post == post && @post.errors.any? %>
            <% item_id = "post-#{post.id}" %>
            <% just_saved = flash[:saved_item] == item_id %>
            <article id="<%= item_id %>" class="impd-card<%= ' is-just-saved' if just_saved %>" style="padding: 20px; overflow-wrap: anywhere;">
              <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center;">
                <h3 style="font-size: 17px; line-height: 1.45;<%= " color: var(--impd-muted);" unless published %>"><%= post.title %></h3>
                <span style="border: 1px solid <%= published ? 'var(--impd-accent)' : 'var(--impd-rule)' %>; color: <%= published ? 'var(--impd-accent)' : 'var(--impd-muted)' %>; padding: 3px 7px; font-size: 12px; font-weight: 600;">
                  <%= published ? "보이는 중" : "나만 보기" %>
                </span>
                <% if just_saved %><span class="impd-just-saved-tag">방금 저장</span><% end %>
              </div>
              <p style="margin-top: 6px; font-size: 13px; color: var(--impd-muted);">
                <% if post.published_at %>
                  <%= post.published_at.in_time_zone("Asia/Seoul").strftime("%Y.%m.%d %H:%M") %>에 올림
                <% else %>
                  아직 고객에게 보이지 않아요
                <% end %>
                <% if post.category.present? %> · <%= post.category %><% end %>
              </p>
              <p class="post-preview"><%= truncate(post.content, length: 90) %></p>

              <div class="impd-item-actions">
                <details<%= " open" if edit_failed %>>
                  <summary>수정</summary>
                  <%= form_with model: (edit_failed ? @post : post), namespace: "edit_post_#{post.id}", url: slug_admin_post_path(slug: @member.slug, id: post), method: :patch, style: "margin: 8px 0;" do |form| %>
                    <%= render "post_fields", form: form %>
                    <%= form.submit "변경사항 저장", class: "impd-btn impd-btn-primary", style: "margin-top: 15px; height: 44px;" %>
                  <% end %>
                </details>
                <%= button_to(published ? "내 페이지에서 숨기기" : "내 페이지에 보이기",
                      toggle_publish_slug_admin_post_path(slug: @member.slug, id: post), method: :post,
                      class: "impd-btn impd-btn-secondary impd-btn-sm") %>
                <%= button_to "삭제", slug_admin_post_path(slug: @member.slug, id: post), method: :delete,
                      class: "impd-btn impd-btn-danger impd-btn-sm",
                      form: { class: "impd-item-delete", data: { turbo_confirm: "이 소식을 지울까요? 지우면 되돌릴 수 없어요." } } %>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="impd-card" style="padding: 40px 24px; text-align: center;">
          <p style="font-size: 14px; color: var(--impd-ink2); line-height: 1.7;">아직 올린 소식이 없어요. '새 소식 쓰기'에 요즘 하는 일을 한두 줄 적어 보세요.</p>
        </div>
      <% end %>
    </section>

    <section id="new-post" class="impd-card" style="position: sticky; top: 88px; scroll-margin-top: 16px;">
      <div class="impd-section-header" style="margin-bottom: 20px;">
        <h2 class="impd-display" style="font-size: 24px;">새 소식 쓰기</h2>
      </div>
      <%= form_with model: MemberPost.new, url: slug_admin_posts_path(slug: @member.slug) do |form| %>
        <%= render "post_fields", form: form %>
        <label class="impd-check">
          <%= form.check_box :is_published, { checked: true, aria: { describedby: "post-visibility-help" } }, 1, 0 %>
          내 페이지에 바로 보이기
        </label>
        <p id="post-visibility-help" class="impd-field-help">체크를 풀면 나만 보는 글로 저장돼요.</p>
        <%= form.submit "소식 올리기", class: "impd-btn impd-btn-primary", style: "width: 100%; height: 48px; margin-top: 16px;" %>
      <% end %>
    </section>
  </div>
</div>

<style>
  .post-preview { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; margin-top: 6px; font-size: 14px; color: var(--impd-ink2); }
  @media (max-width: 820px) {
    .posts-layout.is-empty > section:last-child { order: -1; }
    .impd-wrap { padding: 28px 20px !important; }
    .posts-layout { grid-template-columns: minmax(0, 1fr) !important; }
    #new-post { position: static !important; }
  }
</style>
