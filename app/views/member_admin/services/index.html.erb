<% content_for :title, "서비스·가격 — #{@member.name}" %>

<div class="impd-wrap" style="max-width: 1120px; margin: 0 auto; padding: 40px;">
  <%= render "member_admin/shared/checklist_arrival" %>
  <header style="margin-bottom: 32px;">
    <p class="impd-label-muted">내 페이지 › 서비스</p>
    <h1 class="impd-display" style="font-size: 44px; margin-top: 12px;">서비스·가격</h1>
    <p style="margin-top: 12px; color: var(--impd-ink2); font-size: 14px; line-height: 1.7;">
      내 페이지의 '서비스' 칸에 보여요. 고객이 무엇을 얼마에 받을 수 있는지 적어 주세요.
    </p>
    <% active_service_count = @services.to_a.count { |service| service.is_active.to_i == 1 } %>
    <% if active_service_count.positive? %>
      <%= render "member_admin/shared/public_section_link", label: "서비스", anchor: "classes" %>
      <% if active_service_count >= 7 %>
        <p class="impd-label-muted">내 페이지에는 위에서부터 6개까지 보여요.</p>
      <% end %>
    <% end %>
    <% if @services.any? %>
      <a href="#new-service" class="impd-btn impd-btn-accent impd-jump-new">+ 새 서비스 추가</a>
    <% end %>
  </header>

  <div class="services-layout<%= ' is-empty' if @services.empty? %>" style="display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 32px; align-items: start;">
    <section>
      <div class="impd-section-header">
        <h2 class="impd-display" style="font-size: 24px; flex: 1;">내 서비스</h2>
        <span class="impd-label-muted"><%= @services.size %>개</span>
      </div>

      <% if @services.any? %>
        <div style="display: grid; gap: 14px;">
          <% @services.each do |service| %>
            <% visible = service.is_active.to_i == 1 %>
            <% item_id = "service-#{service.id}" %>
            <% just_saved = flash[:saved_item] == item_id %>
            <article id="<%= item_id %>" class="impd-card<%= ' is-just-saved' if just_saved %>" style="padding: 20px; overflow-wrap: anywhere;">
              <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center;">
                <h3 style="font-size: 17px; line-height: 1.45;<%= " color: var(--impd-muted);" unless visible %>"><%= service.title %></h3>
                <span style="border: 1px solid <%= visible ? 'var(--impd-accent)' : 'var(--impd-rule)' %>; color: <%= visible ? 'var(--impd-accent)' : 'var(--impd-muted)' %>; padding: 3px 7px; font-size: 12px; font-weight: 600;">
                  <%= visible ? "보이는 중" : "숨김" %>
                </span>
                <% if just_saved %><span class="impd-just-saved-tag">방금 저장</span><% end %>
              </div>
              <p style="margin-top: 8px; color: var(--impd-ink2); font-size: 14px;">
                <%= [service.price_label.presence, service.price.presence].compact.join(" · ").presence || "가격 미정" %>
              </p>

              <div class="impd-item-actions">
                <% edit_failed = @service == service && @service.errors.any? %>
                <details<%= " open" if edit_failed %>>
                  <summary>수정</summary>
                  <%= form_with model: (edit_failed ? @service : service), url: slug_admin_service_path(slug: @member.slug, id: service), method: :patch, style: "margin-top: 18px;", data: { controller: "unsaved-guard" } do |form| %>
                    <%= render "service_fields", form: form, submit_label: "변경사항 저장" %>
                  <% end %>
                </details>
                <%= button_to(visible ? "내 페이지에서 숨기기" : "내 페이지에 보이기",
                      slug_admin_service_path(slug: @member.slug, id: service), method: :patch,
                      params: { member_service: { is_active: visible ? 0 : 1 }, visibility_toggle: 1 },
                      class: "impd-btn impd-btn-quiet impd-btn-sm") %>
                <%= button_to "삭제", slug_admin_service_path(slug: @member.slug, id: service), method: :delete,
                      class: "impd-btn impd-btn-danger impd-btn-sm",
                      form: { class: "impd-item-delete", data: { turbo_confirm: "이 서비스를 지울까요? 지우면 되돌릴 수 없어요." } } %>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="impd-card" style="padding: 40px 24px; text-align: center;">
          <p style="font-size: 14px; color: var(--impd-ink2); line-height: 1.7;">아직 서비스가 없어요. '새 서비스 추가'에 적으면 내 페이지에 바로 보여요.</p>
        </div>
      <% end %>
    </section>

    <section id="new-service" class="impd-card checklist-target" style="position: sticky; top: 88px; scroll-margin-top: 16px;">
      <div class="impd-section-header" style="margin-bottom: 20px;">
        <h2 class="impd-display" style="font-size: 24px;">새 서비스 추가</h2>
      </div>
      <%= form_with model: (@new_service || MemberService.new), url: slug_admin_services_path(slug: @member.slug), data: { controller: "unsaved-guard" } do |form| %>
        <%= render "service_fields", form: form, submit_label: "서비스 저장" %>
      <% end %>
    </section>
  </div>
</div>

<style>
  @media (max-width: 820px) {
    .services-layout.is-empty > section:last-child { order: -1; }
    .impd-wrap { padding: 28px 20px !important; }
    .services-layout { grid-template-columns: minmax(0, 1fr) !important; }
    .services-layout > section:last-child { position: static !important; }
  }
</style>
