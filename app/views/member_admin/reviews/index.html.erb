<% content_for :title, "후기 — #{@member.name}" %>

<div class="impd-wrap" style="max-width: 1120px; margin: 0 auto; padding: 40px;">
  <header style="margin-bottom: 32px;">
    <p class="impd-label-muted">고객 › 후기</p>
    <div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 12px;">
      <h1 class="impd-display" style="font-size: 44px;">후기</h1>
      <% if @pending_count.positive? %>
        <span style="background: var(--impd-accent); color: var(--impd-card); padding: 5px 9px; font-size: 12px; font-weight: 700;">
          확인할 후기 <%= @pending_count %>건
        </span>
      <% end %>
    </div>
    <p style="margin-top: 12px; color: var(--impd-ink2); font-size: 14px; line-height: 1.7;">고객이 남긴 후기를 읽어 보고, 내 페이지에 보여 줄 것만 '공개하기'를 눌러 주세요.</p>
  </header>

  <section class="impd-card" style="margin-bottom: 28px;">
    <p class="impd-label" style="font-size: 12px;">후기 받기</p>
    <h2 style="margin-top: 10px; font-size: 20px;">이 주소를 고객에게 보내 주세요</h2>
    <p style="margin-top: 8px; font-size: 13px; line-height: 1.7; color: var(--impd-muted);">고객이 쓴 후기는 내가 '공개하기'를 누르기 전에는 내 페이지에 보이지 않아요.</p>
    <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px;">
      <input id="review-request-url" type="text" readonly value="<%= @review_request_url %>" style="flex: 1 1 100%; min-width: 0; border: 1px solid var(--impd-rule); padding: 10px 12px; font-size: 14px; color: var(--impd-ink); background: var(--impd-card); min-height: 44px;">
      <button type="button" class="impd-btn impd-btn-secondary" onclick="navigator.clipboard.writeText(document.getElementById('review-request-url').value); this.textContent='복사했어요';">주소 복사</button>
      <%= link_to "후기 쓰는 화면 보기", member_review_new_path(slug: @member.slug), target: "_blank", class: "impd-btn impd-btn-primary" %>
    </div>
  </section>

  <% if @reviews.any? %>
    <div style="display: grid; gap: 32px;">
      <% group_descriptions = {
        "확인할 후기" => "아직 내 페이지에 보이지 않아요. 읽어 보고 정해 주세요.",
        "내 페이지에 보이는 후기" => "고객이 내 페이지에서 볼 수 있어요.",
        "숨긴 후기" => "내 페이지에는 안 보이고 여기에만 남아 있어요. 언제든 다시 공개할 수 있어요."
      } %>
      <% @review_groups.each do |group_label, reviews| %>
        <% next if reviews.empty? %>
        <section>
          <header style="margin-bottom: 14px;">
            <div class="impd-section-header" style="margin-bottom: 0;">
              <h2 style="font-size: 20px; flex: 1;"><%= group_label %></h2>
              <span style="font-size: 12px; color: var(--impd-muted);"><%= reviews.size %>건</span>
            </div>
            <p style="margin-top: 4px; font-size: 13px; color: var(--impd-muted);"><%= group_descriptions.fetch(group_label) %></p>
          </header>
          <div style="display: grid; gap: 14px;">
            <% reviews.each do |review| %>
              <% status_label = { "new" => "확인할 후기", "triaged" => "보이는 중", "responded" => "보이는 중", "archived" => "숨김" }.fetch(review.status, review.status) %>
              <% status_color = review.status == "new" ? "var(--impd-accent-2)" : (review.status.in?(%w[triaged responded]) ? "var(--impd-accent)" : "var(--impd-muted)") %>
              <% item_id = "review-#{review.id}" %>
              <% just_saved = flash[:saved_item] == item_id %>
              <article id="<%= item_id %>" class="<%= 'is-just-saved' if just_saved %>" style="background: var(--impd-card); border: 1px solid var(--impd-rule); padding: 24px; overflow-wrap: anywhere;">
                <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px;">
                  <strong style="font-size: 15px;"><%= review.reviewer_name %></strong>
                  <% unless review.rating.nil? %>
                    <% rating = review.rating.clamp(0, 5) %>
                    <span class="review-stars" aria-label="별점 5점 만점에 <%= rating %>점"><span aria-hidden="true"><%= "★" * rating + "☆" * (5 - rating) %></span> <span class="review-stars-num"><%= rating %>점</span></span>
                  <% end %>
                  <span style="padding: 4px 8px; border: 1px solid <%= status_color %>; color: <%= status_color %>; font-size: 12px; font-weight: 700;"><%= status_label %></span>
                  <% if just_saved %><span class="impd-just-saved-tag">방금 저장</span><% end %>
                  <time datetime="<%= review.created_at.iso8601 %>" style="margin-left: auto; font-size: 12px; color: var(--impd-muted);"><%= review.created_at.in_time_zone("Asia/Seoul").strftime("%Y.%m.%d %H:%M") %></time>
                </div>
                <p style="margin-top: 14px; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 14px; line-height: 1.75; color: var(--impd-ink2);"><%= review.content.presence || "별점만 남긴 후기예요." %></p>
                <div class="impd-item-actions">
                  <% unless review.status.in?(%w[triaged responded]) %>
                    <%= button_to(review.status == "archived" ? "다시 공개하기" : "공개하기", approve_slug_admin_review_path(slug: @member.slug, id: review), method: :post, class: "impd-btn impd-btn-primary") %>
                  <% end %>
                  <% unless review.status == "archived" %>
                    <%= button_to "숨기기", reject_slug_admin_review_path(slug: @member.slug, id: review), method: :post, class: "impd-btn impd-btn-secondary" %>
                  <% end %>
                  <%= button_to "삭제", slug_admin_review_path(slug: @member.slug, id: review), method: :delete, class: "impd-btn impd-btn-danger impd-btn-sm", form: { class: "impd-item-delete", data: { turbo_confirm: "이 후기를 완전히 지울까요? 지우면 되돌릴 수 없어요. 내 페이지에서만 안 보이게 하려면 '숨기기'를 눌러 주세요." } } %>
                </div>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state", icon: "star-fat", title: "아직 받은 후기가 없어요", text: "위 주소를 고객에게 보내 보세요." %>
  <% end %>
</div>

<style>
  .review-stars { color: #9a6b00; font-size: 15px; }
  .review-stars-num { color: var(--impd-ink2); font-size: 13px; font-weight: 600; }

  @media (max-width: 820px) {
    .impd-wrap { padding: 28px 20px !important; }
  }
</style>
