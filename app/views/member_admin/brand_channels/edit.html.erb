<% content_for :title, "채널 수정" %>
<section class="impd-card" style="max-width: 640px; margin: 32px auto;">
  <h1>채널 수정</h1>
  <p><%= @brand_channel.brand.name %> · <%= BrandChannel::PLATFORMS.fetch(@brand_channel.platform) %></p>
  <%= form_with model: @brand_channel, url: slug_admin_brand_brand_channel_path(slug: @member.slug, id: @brand_channel.id) do |f| %>
    <% if @brand_channel.errors.any? %>
      <ul role="alert">
        <% @brand_channel.errors.each do |error| %>
          <li><%= error.message %></li>
        <% end %>
      </ul>
    <% end %>
    <p style="margin: 12px 0;">
      <%= f.label :account_handle, "계정 핸들" %>
      <%= f.text_field :account_handle, class: "border border-gray-300 rounded-lg px-3 py-2 w-full" %>
    </p>
    <p style="margin: 12px 0;">
      <%= f.label :profile_url, "채널 주소" %>
      <%= f.url_field :profile_url, class: "border border-gray-300 rounded-lg px-3 py-2 w-full" %>
    </p>
    <p style="margin: 12px 0;">
      <%= f.check_box :delegation_consent, { checked: @brand_channel.delegated? } %>
      <%= f.label :delegation_consent, "이 채널의 운영 위탁에 동의합니다." %>
    </p>
    <%= f.submit "저장", class: "impd-btn impd-btn-primary" %>
    <%= link_to "취소", slug_admin_brand_path(slug: @member.slug), class: "impd-btn impd-btn-secondary" %>
  <% end %>
</section>
