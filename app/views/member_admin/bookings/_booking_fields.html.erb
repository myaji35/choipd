<%= render "member_admin/shared/unsaved_guard_errors", record: form.object %>
<div class="impd-field">
  <%= form.label :booking_type, "예약 받는 곳 이름" %>
  <%= form.text_field :booking_type, class: "impd-input", placeholder: "예: 네이버 예약, 카카오 예약" %>
</div>

<div class="impd-field">
  <%= form.label :description, "설명 (선택)" %>
  <%= form.text_area :description, class: "impd-input", rows: 3, placeholder: "예: 평일 10시~18시 예약 가능" %>
</div>

<div class="impd-field">
  <%= form.label :external_url, "예약 주소 (필수)" %>
  <%= form.url_field :external_url, class: "impd-input", required: true, placeholder: "예: https://booking.naver.com/..." %>
</div>

<%= form.submit submit_label, class: "impd-btn impd-btn-primary", style: "width: 100%; justify-content: center; margin-top: 20px;" %>
