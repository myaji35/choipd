<% content_for :title, "예약 링크 — #{@member.name}" %>

<div class="impd-wrap" style="max-width: 1120px; margin: 0 auto; padding: 40px;">
  <header style="margin-bottom: 32px;">
    <p class="impd-label-muted">고객 › 예약 링크</p>
    <h1 class="impd-display" style="font-size: 44px; margin-top: 12px;">예약 링크</h1>
    <p style="margin-top: 12px; color: var(--impd-ink2); font-size: 14px; line-height: 1.7;">
      이미 쓰는 예약 주소(네이버 예약, 카카오 예약 등)를 적어 두면 내 페이지에 '예약하기' 버튼이 생겨요.
    </p>
    <% if @bookings.any? %>
      <a href="#new-booking" class="impd-btn impd-btn-accent impd-jump-new">+ 새 예약 링크 추가</a>
    <% end %>
  </header>

  <div class="bookings-layout<%= ' is-empty' if @bookings.empty? %>" style="display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 32px; align-items: start;">
    <section>
      <div class="impd-section-header">
        <h2 class="impd-display" style="font-size: 24px; flex: 1;">내 예약 링크</h2>
        <span class="impd-label-muted"><%= @bookings.size %>개</span>
      </div>

      <% if @bookings.any? %>
        <div style="display: grid; gap: 14px;">
          <% @bookings.each do |booking| %>
            <% item_id = "booking-#{booking.id}" %>
            <% just_saved = flash[:saved_item] == item_id %>
            <article id="<%= item_id %>" class="impd-card<%= ' is-just-saved' if just_saved %>" style="padding: 20px; overflow-wrap: anywhere;">
              <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center;">
                <h3 style="font-size: 17px; line-height: 1.45;"><%= booking.booking_type.presence || "예약 링크" %></h3>
                <% if just_saved %><span class="impd-just-saved-tag">방금 저장</span><% end %>
              </div>
              <% if http_url(booking.external_url).present? %>
                <%= link_to booking.external_url, http_url(booking.external_url), target: "_blank", rel: "noopener", style: "display: block; min-height: 44px; padding-block: 12px; color: var(--impd-accent); font-size: 13px; line-height: 1.5; overflow-wrap: anywhere;" %>
              <% else %>
                <span style="display: block; margin-top: 8px; font-size: 13px; color: var(--impd-muted); overflow-wrap: anywhere;"><%= booking.external_url %></span>
              <% end %>
              <% if booking.description.present? %>
                <p style="margin-top: 8px; color: var(--impd-ink2); font-size: 14px; line-height: 1.6;"><%= booking.description %></p>
              <% end %>

              <div class="impd-item-actions">
                <% edit_failed = @booking == booking && @booking.errors.any? %>
                <details<%= " open" if edit_failed %>>
                  <summary>수정</summary>
                  <%= form_with model: (edit_failed ? @booking : booking), url: slug_admin_booking_path(slug: @member.slug, id: booking), method: :patch, class: "booking-form", style: "margin-top: 18px;", data: { controller: "unsaved-guard" } do |form| %>
                    <%= render "booking_fields", form: form, submit_label: "변경사항 저장" %>
                  <% end %>
                </details>
                <%= button_to "삭제", slug_admin_booking_path(slug: @member.slug, id: booking), method: :delete,
                      class: "impd-btn impd-btn-danger impd-btn-sm",
                      form: { class: "impd-item-delete", data: { turbo_confirm: "이 예약 링크를 지울까요? 지우면 되돌릴 수 없어요." } } %>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="impd-card" style="padding: 40px 24px; text-align: center;">
          <p style="font-size: 14px; color: var(--impd-ink2); line-height: 1.7;">아직 예약 링크가 없어요. 쓰는 예약 주소가 있으면 하나 적어 보세요.</p>
        </div>
      <% end %>
    </section>

    <section id="new-booking" class="impd-card" style="position: sticky; top: 88px; scroll-margin-top: 16px;">
      <div class="impd-section-header" style="margin-bottom: 20px;">
        <h2 class="impd-display" style="font-size: 24px;">새 예약 링크 추가</h2>
      </div>
      <%= form_with model: (@new_booking || MemberBooking.new), url: slug_admin_bookings_path(slug: @member.slug), class: "booking-form", data: { controller: "unsaved-guard" } do |form| %>
        <%= render "booking_fields", form: form, submit_label: "예약 링크 저장" %>
      <% end %>
    </section>
  </div>
</div>

<style>
  @media (max-width: 820px) {
    .bookings-layout.is-empty > section:last-child { order: -1; }
    .impd-wrap { padding: 28px 20px !important; }
    .bookings-layout { grid-template-columns: minmax(0, 1fr) !important; }
    .bookings-layout > section:last-child { position: static !important; }
  }
</style>
