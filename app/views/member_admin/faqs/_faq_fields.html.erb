<%= render "member_admin/shared/unsaved_guard_errors", record: form.object %>
<div class="impd-field">
  <%= form.label :question, "질문 (필수)" %>
  <%= form.text_field :question, required: true, class: "impd-input", placeholder: "예: 상담은 어떻게 진행되나요?" %>
</div>
<div class="impd-field">
  <%= form.label :answer, "답변 (필수)" %>
  <%= form.text_area :answer, required: true, rows: 6, class: "impd-input", placeholder: "예: 전화나 카카오톡으로 먼저 이야기 나눈 뒤, 편한 시간에 만나요." %>
</div>
<% if form.object.persisted? %>
  <div class="impd-field">
    <%= form.label :sort_order, "보이는 순서" %>
    <%= form.number_field :sort_order, class: "impd-input", min: 0 %>
    <p class="impd-field-help">숫자가 작을수록 위에 보여요. 같으면 먼저 쓴 질문이 위예요.</p>
  </div>
<% end %>
<label class="impd-check">
  <%= form.check_box :is_published, { checked: (form.object.new_record? && form.object.errors.empty?) || form.object.is_published.to_i == 1 }, 1, 0 %>
  내 페이지에 보이기
</label>
<%= form.submit submit_label, class: "impd-btn impd-btn-primary", style: "width: 100%; justify-content: center; margin-top: 20px;" %>
