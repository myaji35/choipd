<% content_for :title, "스캔 정리 — #{@member.name}" %>
<% input_style = "width: 100%; border: 1px solid var(--impd-rule); background: var(--impd-paper); padding: 10px 12px; color: var(--impd-ink);" %>
<% card_style = "display: grid; gap: 12px; margin-bottom: 16px;" %>
<% settings_path = slug_admin_scan_organizer_path(slug: @member.slug) %>
<article class="impd-wrap" style="max-width: 900px; margin: 0 auto; padding: 40px 20px;">
  <header style="margin-bottom: 32px;">
    <h1 class="impd-display" style="font-size: 36px;">스캔 정리</h1>
  </header>

  <%= form_with model: @setting, url: settings_path, method: :patch do |form| %>
    <section class="impd-card" style="<%= card_style %>">
      <h2 style="font-size: 20px;">클라우드 선택</h2>
      <%= form.label :cloud_provider, "클라우드" %>
      <%= form.select :cloud_provider, ScanOrganizer::Clouds::ALL.map { |cloud|
        label = "#{cloud.fetch(:label)} · #{cloud.fetch(:ai_label)}"
        label += " (준비 중)" unless cloud.fetch(:available)
        [label, cloud.fetch(:key), { disabled: !cloud.fetch(:available) }]
      }, {}, style: input_style %>
    </section>

    <section class="impd-card" style="<%= card_style %>">
      <h2 style="font-size: 20px;">정리 규칙</h2>
      <%= form.label :receipts_sheet_name, "영수증 시트 이름" %>
      <%= form.text_field :receipts_sheet_name, maxlength: 80, placeholder: "#{@member.name} 영수증", style: input_style %>
      <%= form.label :documents_folder_name, "문서 폴더 이름" %>
      <%= form.text_field :documents_folder_name, maxlength: 80, placeholder: "스캔 문서", style: input_style %>
      <%= form.label :review_folder_name, "확인 필요 폴더 이름" %>
      <%= form.text_field :review_folder_name, maxlength: 80, placeholder: "스캔 확인 필요", style: input_style %>
      <%= form.label :run_frequency, "실행 주기" %>
      <%= form.select :run_frequency, ScanOrganizerSetting::RUN_FREQUENCIES.invert, {}, style: input_style %>
      <p><%= form.submit "정리 규칙 저장", class: "impd-btn impd-btn-primary" %></p>
    </section>
  <% end %>

  <section class="impd-card" style="<%= card_style %>">
    <h2 style="font-size: 20px;"><%= label_tag "scan-prompt", "정리 프롬프트 미리보기" %></h2>
    <%= text_area_tag "scan-prompt", @prompt, rows: 12, readonly: true, style: input_style %>
    <p><%= button_tag "프롬프트 복사", type: "button", id: "scan-prompt-copy", class: "impd-btn impd-btn-secondary" %></p>
    <p id="scan-prompt-status" role="status" hidden></p>
  </section>

  <section class="impd-card" style="<%= card_style %>">
    <h2 style="font-size: 20px;"><%= @cloud.fetch(:ai_label) %> 주기 실행 안내</h2>
    <ol style="list-style: decimal; padding-inline-start: 1.5em;">
      <% @cloud.fetch(:instructions).each do |instruction| %>
        <li><%= instruction % { frequency: ScanOrganizerSetting::RUN_FREQUENCIES.fetch(@setting.run_frequency) } %></li>
      <% end %>
    </ol>
    <p>플랫폼 기능 이름과 지원 범위는 계정에 따라 다르거나 바뀔 수 있습니다.</p>
  </section>

  <%= form_with model: @setting, url: settings_path, method: :patch do |form| %>
    <section class="impd-card" style="<%= card_style %>">
      <h2 style="font-size: 20px;">AI 키 등록</h2>
      <%= form.label :ai_provider, "AI 제공자" %>
      <%= form.select :ai_provider, [["Gemini", "gemini"], ["OpenAI", "openai"], ["Anthropic", "anthropic"]],
          { include_blank: "제공자를 선택해 주세요" }, style: input_style %>
      <%= form.label :ai_api_key, "AI 키" %>
      <%= form.password_field :ai_api_key, value: "", autocomplete: "new-password", style: input_style %>
      <% if @setting.ai_api_key.present? %>
        <p>••••<%= "#{@setting.ai_key_last4} " if @setting.ai_key_last4.present? %>등록됨</p>
      <% end %>
      <p style="display: flex; flex-wrap: wrap; gap: 8px;">
        <%= form.submit "AI 키 저장", class: "impd-btn impd-btn-primary" %>
        <%= button_tag "연결 시험", type: "submit", form: "scan-ai-key-test", class: "impd-btn impd-btn-secondary" %>
      </p>
    </section>
  <% end %>
  <%= form_with url: test_ai_key_slug_admin_scan_organizer_path(slug: @member.slug), id: "scan-ai-key-test" do %>
  <% end %>
</article>

<script>
  (() => {
    const button = document.getElementById("scan-prompt-copy");
    const prompt = document.getElementById("scan-prompt");
    const status = document.getElementById("scan-prompt-status");

    button.onclick = async () => {
      try {
        await navigator.clipboard.writeText(prompt.value);
        button.textContent = "복사됨";
        status.hidden = true;
      } catch {
        button.textContent = "프롬프트 복사";
        prompt.focus();
        prompt.select();
        status.textContent = "프롬프트를 선택했습니다. 키보드나 기기의 복사 메뉴로 복사해 주세요.";
        status.hidden = false;
      }
    };
  })();
</script>
