<% content_for :title, "내 브랜드" %>
<%= stylesheet_link_tag "brand_ops" %>
<div class="impd-wrap" style="max-width: 1120px; margin: 0 auto; padding: 40px;">
  <header style="margin-bottom: 32px;">
    <p class="impd-label-muted">홍보 › 내 브랜드</p>
    <h1 class="impd-display" style="font-size: 44px; margin-top: 12px;">내 브랜드</h1>
    <p style="margin-top: 12px; color: var(--impd-ink2); font-size: 14px; line-height: 1.7;">내 홍보가 얼마나 닿고 있는지, 내 정보가 어디에 실리는지 한눈에 보는 곳이에요.</p>
  </header>

  <section class="impd-card" style="margin-bottom: 32px; min-width: 0; overflow-wrap: anywhere;">
    <h2>내 브랜드 운영 현황</h2>
    <p style="margin:12px 0;">최근 4주 활동과 그전 4주와의 차이예요.</p>
    <div class="ops-key-grid ops-owner-stats">
      <% [[:visits, "방문", "회"], [:inquiries, "문의", "건"], [:posts, "올린 소식", "건"], [:sns_posts, "SNS에 올린 글", "건"]].each do |key, label, unit| %>
        <% stat = @four_week_stats[key]; delta = stat[:delta] %>
        <section class="ops-surface-card"><p><%= label %></p><strong><%= number_with_delimiter(stat[:value]) %><%= unit %></strong><p><%= delta.zero? ? "그전 4주와 같아요" : "그전 4주보다 #{number_with_delimiter(delta.abs)}#{unit} #{delta.positive? ? '늘었어요' : '줄었어요'}" %></p></section>
      <% end %>
    </div>
    <% current_week = @series.last %>
    <p style="margin:12px 0;">아래 그래프는 최근 12주 동안의 흐름이에요.<% if current_week %> 맨 오른쪽(<%= current_week[:week_start].strftime("%-m/%-d") %> 주)은 이번 주라 아직 세는 중이에요. 낮게 보여도 괜찮아요.<% end %></p>
    <%= ops_line_chart @series, keys: %i[visits inquiries posts sns_posts], labels: ["방문", "문의", "올린 소식", "SNS에 올린 글"] %>
    <% if current_week %>
      <p class="impd-label-muted" style="font-size: 13px;">이번 주(월요일부터 지금까지): 방문 <%= number_with_delimiter(current_week[:visits]) %>회 · 문의 <%= number_with_delimiter(current_week[:inquiries]) %>건 · 소식 <%= number_with_delimiter(current_week[:posts]) %>건</p>
    <% end %>
    <details style="margin-top: 16px;">
      <summary style="cursor: pointer; min-height: 44px; display: flex; align-items: center; color: var(--impd-accent); font-weight: 600;">이 숫자는 누가 볼 수 있나요?</summary>
      <p style="margin-top:12px;line-height:1.7;">공개 페이지(<%= member_brand_ops_path(slug: @member.slug) %>)에는 주간 방문·게시 그래프, 최근 4주 문의 수(1~2건은 '3건 미만'), 연결 매체, 최근 게시물 제목만 보여요. 문의 내용·연락처·방문자 정보는 공개하지 않아요.</p>
      <p style="margin-top:12px;">로봇·운영자·본인 방문 제외. 집계 시점: <%= Time.current.in_time_zone("Asia/Seoul").strftime("%Y.%m.%d %H:%M") %> (한국 시간)</p>
      <p style="margin-top:12px;padding:12px;background:var(--impd-paper);">공개 상태: <% if brand_ops_public? %>공개 중<% if brand_ops_gate[:reason] == "early" %> (회원 <%= brand_ops_gate[:members_threshold] %>명 전까지는 항상 공개 — 지금 <%= brand_ops_gate[:members_total] %>명)<% end %><% else %>아직 비공개 (imPD 전체 활성 회원 <%= brand_ops_gate[:active] %>/<%= brand_ops_gate[:active_required] %>명 · 최근 4주 소통 <%= brand_ops_gate[:communication_4w] %>/<%= brand_ops_gate[:communication_required] %>건이 되면 자동 공개) · 회원 <%= brand_ops_gate[:members_threshold] %>명 이상이라 기준을 적용 중<% end %></p>
    </details>
    <% if brand_ops_public? %>
      <p style="margin-top: 12px; font-size: 14px; color: var(--impd-ink2);">고객도 볼 수 있는 내 활동 화면이 따로 있어요. 방문·게시 그래프만 보이고, 문의 내용과 연락처는 보이지 않아요.</p>
      <p style="margin-top: 12px;">
        <% if @consented && @member.approved? %>
          <%= link_to member_brand_ops_path(slug: @member.slug), class: "impd-btn impd-btn-secondary" do %>공개 페이지 보기 <%= lni_icon "arrow-right" %><% end %>
        <% else %>
          <%= link_to "공개하려면 노출 동의하기", slug_admin_brand_consents_path(slug: @member.slug), class: "impd-btn impd-btn-secondary" %>
        <% end %>
      </p>
    <% end %>
  </section>

  <section style="margin-bottom: 32px;">
    <h2>내 정보가 실리는 곳</h2>
    <p class="impd-label-muted" style="margin: 8px 0 12px;">동의한 곳에만 내 페이지와 소식이 실려요. 언제든 바꿀 수 있어요.</p>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 12px;">
      <% placements = [
        ["SNS 대신 운영", "SocialDoctors", "socialdoctors_exposure", "운영팀이 블로그·YouTube·인스타그램·페이스북·스레드에 내 소식을 대신 올려 드려요.", "맡기는 중", "아직 맡기지 않았어요"],
        ["우리 동네 광고", "Townin", "townin_local_ads", "가까운 동네 주민에게 내 페이지를 광고로 보여 드려요.", "광고에 실리는 중", "아직 실리지 않아요"]
      ] %>
      <% placements.each do |title, service, type, description, active_label, inactive_label| %>
        <% consented = ProConsent.current_for(@member.id, type) %>
        <section class="impd-card" style="overflow-wrap: anywhere;">
          <h3><%= title %></h3>
          <span class="impd-label-muted"><%= service %></span>
          <p style="margin-top: 12px;"><%= description %></p>
          <p style="margin: 12px 0;"><%= lni_icon(consented ? 'check-circle-1' : 'xmark-circle') %> <%= consented ? active_label : inactive_label %></p>
          <%= link_to (consented ? "동의 내용 보기·바꾸기" : "동의하러 가기"), slug_admin_brand_consents_path(slug: @member.slug), class: "impd-btn impd-btn-secondary" %>
        </section>
      <% end %>
      <section class="impd-card">
        <h3>이번 달 올린 글</h3>
        <p style="margin-top: 12px;">이번 달 소식 <%= number_with_delimiter(@month_posts) %>건 · SNS에 올린 글 <%= number_with_delimiter(@month_sns_posts) %>건</p>
        <p class="impd-label-muted" style="margin: 8px 0 12px;">SNS 종류별 숫자는 준비되면 여기에 함께 보여요.</p>
        <%= link_to "소식 쓰러 가기", slug_admin_posts_path(slug: @member.slug), class: "impd-btn impd-btn-secondary" %>
      </section>
    </div>
  </section>

  <section style="overflow-wrap: anywhere;">
    <h2>내 브랜드 정보</h2>
    <p class="impd-label-muted" style="margin: 8px 0 12px;">운영팀이 홍보할 때 쓰는 기본 정보예요.</p>
    <% inquiry_link_style = 'color: var(--impd-accent); text-decoration: underline; display: inline-flex; align-items: center; min-height: 44px;' %>
    <% if @brands.empty? %><div class="impd-card">아직 등록된 브랜드가 없어요.</div><% end %>
    <div style="display: grid; gap: 12px;">
      <% @brands.each do |brand| %>
        <article class="impd-card">
          <h3><%= brand.name %> <% if brand.personal? %><span class="impd-label">개인(기본)</span><% end %></h3>
          <% industry_and_region = [['업종', brand.business_type], ['지역', brand.region]].filter_map { |label, value| "#{label}: #{value}" if value.present? }.join(' · ') %>
          <% if industry_and_region.present? %>
            <p style="margin-top: 8px;"><%= industry_and_region %></p>
          <% end %>
          <% if brand.description.present? %>
            <p style="margin-top: 8px; white-space: pre-line;"><%= brand.description %></p>
          <% end %>
          <% if (url = http_url(brand.website_url)) %>
            <p style="margin-top: 8px;"><%= link_to url, url, target: '_blank', rel: 'noopener', style: 'color: var(--impd-accent); text-decoration: underline; display: inline-flex; align-items: center; min-height: 44px; overflow-wrap: anywhere;' %></p>
          <% end %>
          <% if (brand.personal? || @brands.size == 1) && industry_and_region.blank? && brand.description.blank? %>
            <% profession = @member.profession_label if @member.profession.present? %>
            <% member_line = [["직업", profession == "custom" ? nil : profession], ["지역", @member.region]].filter_map { |label, value| "#{label}: #{value}" if value.present? }.join(" · ") %>
            <% if member_line.present? || @member.bio.present? %>
              <% if member_line.present? %>
                <p style="margin-top: 8px;"><%= member_line %></p>
              <% end %>
              <% if @member.bio.present? %>
                <p style="margin-top: 8px;"><%= truncate(@member.bio, length: 120) %></p>
              <% end %>
              <p class="impd-label-muted" style="margin-top: 8px;">내 페이지에 적은 정보를 그대로 써요.</p>
              <%= link_to "내 정보 고치기", slug_admin_editor_path(slug: @member.slug, step: 2), class: "impd-btn impd-btn-secondary", style: "margin-top: 12px;" %>
            <% else %>
              <p class="impd-label-muted" style="margin-top: 8px;">아직 직업·지역·소개를 적지 않았어요. 적어 두면 운영팀이 홍보할 때 그대로 써요.</p>
              <%= link_to "내 정보 적으러 가기", slug_admin_editor_path(slug: @member.slug, step: 2, anchor: "bio"), class: "impd-btn impd-btn-secondary", style: "margin-top: 12px;" %>
            <% end %>
          <% elsif industry_and_region.blank? && brand.description.blank? && brand.website_url.blank? %>
            <p class="impd-label-muted" style="margin-top: 8px;">업종·지역·소개가 아직 비어 있어요. 운영팀에 알려 주시면 채워 드려요 — <%= link_to '문의하기', new_inquiry_path, style: inquiry_link_style %></p>
          <% end %>
          <%= render "channels", brand: brand if @show_brand_channels %>
        </article>
      <% end %>
    </div>
    <% if @brands.empty? %><p style="margin: 16px 0 32px;">브랜드는 운영팀이 등록을 도와드려요 — <%= link_to '문의하기', new_inquiry_path, style: inquiry_link_style %></p><% end %>
  </section>
</div>

<style>
  .impd-admin .ops-surface-card { border-radius: 0; border-color: var(--impd-rule); }
  .impd-admin .ops-surface-card > p:first-child { font-size: 13px; color: var(--impd-muted); }
  .impd-admin .ops-surface-card > p:last-child { font-size: 13px; color: var(--impd-ink2); }
</style>
