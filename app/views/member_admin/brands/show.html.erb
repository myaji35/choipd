<% content_for :title, "내 브랜드" %>
<%= stylesheet_link_tag "brand_ops" %>
<div style="max-width: 1000px; margin: auto; padding: 40px 20px;">
  <header style="margin-bottom: 28px;"><h1 class="impd-display" style="font-size: 36px;">내 브랜드</h1><p style="margin-top: 12px;">브랜드 정보와 홍보 연결 상태를 확인하세요.</p></header>
  <section class="impd-card" style="margin-bottom: 24px;">
    <h2>채널 운영</h2>
    <p>블로그·YouTube·인스타그램·페이스북·스레드는 운영팀이 SocialDoctors 에서 관리합니다.</p>
  </section>
  <h2 style="margin-bottom: 12px;">브랜드</h2>
  <% if @brands.empty? %><div class="impd-card">아직 등록된 브랜드가 없어요.</div><% end %>
  <div style="display: grid; gap: 12px;">
    <% @brands.each do |brand| %>
      <article class="impd-card">
        <h3><%= brand.name %> <% if brand.personal? %><span class="impd-label">개인(기본)</span><% end %></h3>
        <p style="margin-top: 8px;"><%= [['업종', brand.business_type], ['지역', brand.region]].filter_map { |label, value| "#{label}: #{value}" if value.present? }.join(' · ') %></p>
        <p style="margin-top: 8px; white-space: pre-line;"><%= brand.description %></p>
        <% if (url = http_url(brand.website_url)) %>
          <p style="margin-top: 8px;"><%= link_to url, url, target: '_blank', rel: 'noopener', style: 'color: var(--impd-accent); text-decoration: underline;' %></p>
        <% end %>
        <%= render "channels", brand: brand if @show_brand_channels %>
      </article>
    <% end %>
  </div>
  <% if @brands.empty? %><p style="margin: 16px 0 32px;">브랜드는 운영팀이 등록을 도와드려요 — <%= link_to '문의하기', new_inquiry_path, style: 'color: var(--impd-accent); text-decoration: underline;' %></p><% end %>
  <section class="impd-card" style="margin:32px 0;">
    <h2>내 브랜드 운영 현황</h2>
    <p style="margin:12px 0;">최근 4주 활동과 그전 4주와의 차이예요.</p>
    <div class="ops-key-grid ops-owner-stats">
      <% [[:visits, "방문", "회"], [:inquiries, "문의", "건"], [:posts, "게시", "건"], [:sns_posts, "SNS 발행", "건"]].each do |key, label, unit| %>
        <% stat = @four_week_stats[key]; delta = stat[:delta] %>
        <section class="ops-surface-card"><p><%= label %></p><strong><%= number_with_delimiter(stat[:value]) %><%= unit %></strong><p><%= delta.zero? ? "그전 4주와 같아요" : "그전 4주보다 #{number_with_delimiter(delta.abs)}#{unit} #{delta.positive? ? '늘었어요' : '줄었어요'}" %></p></section>
      <% end %>
    </div>
    <p style="margin:12px 0;">최근 12주 활동이에요.</p>
    <%= ops_line_chart @series, keys: %i[visits inquiries posts sns_posts], labels: ["방문", "문의 건수", "게시", "SNS 발행"] %>
    <p style="margin-top:12px;line-height:1.7;">공개 페이지(<%= member_brand_ops_path(slug: @member.slug) %>)에는 주간 방문·게시 그래프, 최근 4주 문의 수(1~2건은 '3건 미만'), 연결 매체, 최근 게시물 제목만 보여요. 문의 내용·연락처·방문자 정보는 공개하지 않아요.</p>
    <p style="margin-top:12px;">로봇·운영자·본인 방문 제외. 집계 시점: <%= Time.current.in_time_zone("Asia/Seoul").strftime("%Y.%m.%d %H:%M") %> (한국 시간)</p>
    <p style="margin-top:12px;padding:12px;background:#f3f7f4;">공개 상태: <% if brand_ops_public? %>공개 중<% if brand_ops_gate[:reason] == "early" %> (회원 <%= brand_ops_gate[:members_threshold] %>명 전까지는 항상 공개 — 지금 <%= brand_ops_gate[:members_total] %>명)<% end %><% else %>아직 비공개 (imPD 전체 활성 회원 <%= brand_ops_gate[:active] %>/<%= brand_ops_gate[:active_required] %>명 · 최근 4주 소통 <%= brand_ops_gate[:communication_4w] %>/<%= brand_ops_gate[:communication_required] %>건이 되면 자동 공개) · 회원 <%= brand_ops_gate[:members_threshold] %>명 이상이라 기준을 적용 중<% end %></p>
    <% if brand_ops_public? %><p style="margin-top:12px;"><% if @consented && @member.approved? %><%= link_to member_brand_ops_path(slug: @member.slug), class: "impd-btn impd-btn-secondary" do %>공개 페이지 보기 <%= lni_icon "arrow-right" %><% end %><% else %><%= link_to "공개하려면 노출 동의하기", slug_admin_brand_consents_path(slug: @member.slug), class: "impd-btn impd-btn-secondary" %><% end %></p><% end %>
  </section>
  <h2 style="margin-bottom: 12px;">연결 상태</h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 12px;">
    <% [['SocialDoctors', 'socialdoctors_exposure'], ['Townin 지역 광고', 'townin_local_ads']].each do |label, type| %><section class="impd-card"><h3><%= label %></h3><p style="margin: 12px 0;"><%= lni_icon(ProConsent.current_for(@member.id, type) ? 'check-circle-1' : 'xmark-circle') %> <%= ProConsent.current_for(@member.id, type) ? '동의함' : '동의 안 함' %></p><%= link_to '동의 상태 확인', slug_admin_brand_consents_path(slug: @member.slug), style: 'color: var(--impd-accent); text-decoration: underline;' %></section><% end %>
    <section class="impd-card"><h3>콘텐츠·성과</h3><p style="margin-top: 12px;">이번 달 imPD 게시 <%= number_with_delimiter(@month_posts) %>건 · SNS 발행 <%= number_with_delimiter(@month_sns_posts) %>건</p><p style="margin-top: 8px; line-height: 1.6; color: var(--impd-muted);">SocialDoctors 매체별 발행 수는 연동되면 여기에 함께 보여요.</p></section>
  </div>
</div>
