<% display_src = photo.display_url %>
<% thumb_src   = photo.thumbnail_url || display_src %>

<figure data-controller="member-photo-card"
        data-member-photo-card-delete-url-value="<%= slug_admin_photo_path(slug: member.slug, id: photo.id, format: :json) %>"
        data-member-photo-card-update-url-value="<%= slug_admin_photo_path(slug: member.slug, id: photo.id, format: :json) %>"
        data-member-photo-card-csrf-value="<%= form_authenticity_token %>"
        data-member-photo-card-id-value="<%= photo.id %>"
        style="position: relative; margin: 0; overflow: hidden; background: var(--impd-ink); border: 1px solid var(--impd-rule);">
  <% if photo.image.attached? %>
    <% if photo.video? %>
      <video src="<%= display_src %>"
             style="width: 100%; height: 140px; object-fit: cover; display: block; background: #000;"
             preload="metadata" muted playsinline></video>
      <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none;">
        <%= lni_icon "camera-1", size: 20 %>
      </div>
    <% else %>
      <img src="<%= thumb_src %>"
           data-fallback="<%= display_src %>"
           onerror="if(this.dataset.fallback && this.src !== this.dataset.fallback){this.src=this.dataset.fallback;this.dataset.fallback='';}else{this.style.display='none';}"
           alt="<%= photo.caption %>"
           style="width: 100%; height: 140px; object-fit: cover; display: block;" loading="lazy">
    <% end %>
  <% end %>

  <figcaption style="padding: 10px; background: var(--impd-paper); color: var(--impd-ink);">
    <% category_options = member_photo_category_options(photo.category) %>
    <span data-category-chip style="border-radius: 999px; background: var(--impd-card); color: var(--impd-ink); padding: 5px 10px; font-size: 13px;"><%= category_options.find { |_, value| value == photo.category }&.first || "일상" %></span>
    <label>분류 바꾸기
      <select data-action="change->member-photo-card#updateCategory" style="width: 100%;">
        <%= options_for_select(category_options, photo.category) %>
      </select>
    </label>
    <button type="button" data-action="click->member-photo-card#destroy" style="width: 100%; margin-top: 6px;">빼기</button>
  </figcaption>
</figure>
