<%# 단일 업로드 허브 — 자료·사진·영상을 하나의 카드 UI에서 탭으로 전환 %>
<% gallery = member.gallery_photos %>
<% photo_count = gallery.count %>
<% photos = gallery.ordered.limit(24) %>
<% initial_tab = params[:tab] == "media" ? "media" : "docs" %>

<section data-controller="upload-hub"
         style="background: var(--impd-card); border: 1px solid var(--impd-rule);">
  <%# Tab bar %>
  <div style="display: flex; align-items: stretch; border-bottom: 1px solid var(--impd-ink);">
    <button type="button" data-action="click->upload-hub#switch" data-upload-hub-tab-param="docs"
            data-upload-hub-target="tab" data-tab-id="docs" aria-controls="docs" aria-pressed="<%= initial_tab == "docs" %>"
            style="flex: 1; padding: 18px 20px; background: <%= initial_tab == "docs" ? "var(--impd-ink)" : "transparent" %>; color: <%= initial_tab == "docs" ? "var(--impd-paper)" : "var(--impd-ink)" %>; border: 0; cursor: pointer; text-align: left; border-right: 1px solid var(--impd-ink);">
      <div class="impd-label" style="margin-bottom: 4px;">자료</div>
      <div style="font-family: var(--impd-font-display); font-weight: 800; font-size: 18px; letter-spacing: -0.4px;">이력 · 수료증 · 후기 글</div>
      <div style="font-size: 13px; color: var(--impd-muted); margin-top: 6px;">글 <%= member.member_documents.count %>개</div>
    </button>
    <button type="button" data-action="click->upload-hub#switch" data-upload-hub-tab-param="media"
            data-upload-hub-target="tab" data-tab-id="media" aria-controls="media" aria-pressed="<%= initial_tab == "media" %>"
            style="flex: 1; padding: 18px 20px; background: <%= initial_tab == "media" ? "var(--impd-ink)" : "transparent" %>; color: <%= initial_tab == "media" ? "var(--impd-paper)" : "var(--impd-ink)" %>; border: 0; cursor: pointer; text-align: left;">
      <div class="impd-label" style="margin-bottom: 4px;">사진·영상</div>
      <div style="font-family: var(--impd-font-display); font-weight: 800; font-size: 18px; letter-spacing: -0.4px;">일상·작업·후기 장면</div>
      <div style="font-size: 13px; color: var(--impd-muted); margin-top: 6px;">사진·영상 <%= photo_count %>개</div>
    </button>
  </div>

  <%# Tab panels %>
  <div id="docs" class="checklist-target" data-upload-hub-target="panel" data-panel-id="docs"
       style="padding: 28px 24px;" <%= "hidden" unless initial_tab == "docs" %>>
    <%= render "member_admin/editor/dropzone", member: member %>
  </div>

  <div id="media" class="checklist-target" data-upload-hub-target="panel" data-panel-id="media"
       style="padding: 28px 24px;" <%= "hidden" unless initial_tab == "media" %>>
    <%= render "member_admin/editor/photo_dropzone", member: member %>

    <% profile_photo_note = tag.p("프로필 사진은 여기에 안 보여요. 2단계 '정보 확인'에서 바꿀 수 있어요.",
      data: { profile_photo_note: true }, style: "font-size: 13px; color: var(--impd-muted); margin: 10px 0;") if member.profile_photo_record.present? %>
    <% if photo_count.positive? %>
      <div style="margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--impd-rule);">
        <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px;">
          <span class="impd-label-muted">갤러리 · <%= photo_count %>장</span>
          <% if photo_count > 24 %>
            <span style="font-size: 11px; color: var(--impd-muted);">최근 24개</span>
          <% end %>
        </div>
        <%= profile_photo_note %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 6px;">
          <% photos.each do |photo| %>
            <%= render "member_admin/editor/photo_card", photo: photo, member: member %>
          <% end %>
        </div>
      </div>
    <% else %>
      <%= profile_photo_note %>
    <% end %>
  </div>
</section>
