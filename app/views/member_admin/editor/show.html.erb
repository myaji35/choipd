<% content_for :title, "페이지 만들기 — #{@member.name}" %>

<div class="admin-page editor-page">
  <%= render "member_admin/shared/checklist_arrival" %>
  <!-- 4단계 progress rail — 모두 클릭 가능. 각 단계별 완료 상태 표시. -->
  <%
    step1_done = @doc_count.to_i > 0 || @member.member_photos.exists?
    style_name = ThemePreset.find(@member.theme_preset)&.dig(:name)
    step4_done = @member.published_at.present?

    editor_path = slug_admin_editor_path(slug: @member.slug) if @info_draft
    steps = [
      [1, "자료 올리기", "", step1_done],
      [2, "정보 확인", "", @can_publish],
      [3, "스타일", style_name || "기본 스타일로 준비됐어요", true],
      [4, "공개", "", step4_done],
    ]
  %>
  <div style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--impd-ink); margin-bottom: 48px;">
    <% steps.each_with_index do |(n, label, desc, done), i| %>
      <% current = @step == n %>
      <a href="<%= editor_path %>?step=<%= n %>" <%= 'aria-current="step"'.html_safe if current %>
         style="display: block; padding: 16px 20px; text-decoration: none; <%= 'border-left: 1px solid var(--impd-rule);' if i > 0 %> position: relative; background: <%= current ? 'var(--impd-card)' : 'transparent' %>; transition: background .15s;"
         onmouseover="if(!<%= current %>)this.style.background='var(--impd-card)';"
         onmouseout="if(!<%= current %>)this.style.background='transparent';">
        <% if current %>
          <div style="position: absolute; top: -2px; left: 0; right: 0; height: 3px; background: var(--impd-accent);"></div>
        <% end %>
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
          <div class="impd-label" style="color: <%= current ? 'var(--impd-accent)' : (done ? 'var(--impd-ink)' : 'var(--impd-muted)') %>;"><%= n %></div>
          <% if done && !current %>
            <span style="width: 18px; height: 18px; display: inline-flex; align-items: center; justify-content: center; background: #16a34a; color: #fff; font-size: 11px; font-weight: 700; border-radius: 50%;"><%= lni_icon "check" %></span>
          <% elsif current %>
            <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--impd-accent);"></span>
          <% end %>
        </div>
        <p style="font-family: var(--impd-font-display); font-weight: 800; font-size: 20px; margin-top: 6px; color: var(--impd-ink);"><%= label %><% if done && !current %> <span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">(마침)</span><% end %></p>
        <% if desc.present? %>
          <p style="font-size: 12px; color: var(--impd-muted); margin-top: 4px;"><%= desc %></p>
        <% end %>
      </a>
    <% end %>
  </div>

  <% if @step == 1 %>
    <!-- ── Step 1: 업로드 허브 ───────────────────────── -->
    <div style="display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.5fr); column-gap: 56px; row-gap: 0; grid-template-rows: auto 1fr;" class="editor-grid editor-upload-grid">
      <div class="editor-intro">
        <div class="impd-label">자료 올리기</div>
        <h1 class="impd-display" style="font-size: 54px; margin-top: 18px; line-height: 0.95;">
          뭘 올려야<br class="editor-br-wide"> 할지<br>
          <span class="impd-serif" style="color: var(--impd-accent); font-weight: 400;">고민 마세요.</span>
        </h1>
        <p style="margin-top: 22px; font-size: 15px; color: var(--impd-ink2); line-height: 1.65; max-width: 34ch;">
          이력·수료증·후기 글부터 일상 사진, 작업 영상까지 — <strong>무엇이든 그냥 올리세요.</strong> 종류는 알아서 나눠서 내 페이지에 넣어 드려요.
        </p>
      </div>

      <div class="editor-upload-card">
        <%= render "member_admin/editor/upload_hub", member: @member %>
      </div>

      <ul class="editor-file-rules">
        <li><strong>글</strong> — 이력·경력을 칸에 바로 적으면 돼요. 한글·워드 문서는 내용을 복사해 붙여 넣어 주세요. 글 파일(.txt)이 있으면 그대로 올려도 돼요.</li>
        <li><strong>사진</strong> — 휴대폰 사진 그대로 올려도 돼요. 한 장에 25MB까지.</li>
        <li><strong>영상</strong> — 한 개에 100MB까지.</li>
      </ul>
    </div>

  <% elsif @step == 2 %>
    <div class="impd-section-header">
      <div style="flex: 1 1 auto;">
        <h1 class="impd-display" style="font-size: 28px;">내 정보 확인하기</h1>
        <p class="impd-label-muted" style="margin-top: 8px;">올린 자료에서 찾은 내용을 확인하고 빈칸을 채워 주세요.</p>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 40px;" class="editor-grid">
      <%# 좌: 기본 프로필 입력 폼 %>
      <section class="impd-card" aria-labelledby="basic-info-heading" data-controller="editor-info">
        <h2 id="basic-info-heading" class="impd-label">기본 정보</h2>
        <p style="margin-top: 6px; font-size: 13px; color: var(--impd-muted);">(필수)는 자기소개와 이메일 두 칸이에요. 나머지는 나중에 채워도 돼요.</p>
        <%= render "member_admin/editor/profile_photo" %>
        <%= form_with url: slug_admin_editor_update_info_path(slug: @member.slug), method: :patch, local: true, class: "editor-fields", data: { turbo: false, controller: "unsaved-guard" } do %>
          <% from_checklist = params[:from] == "checklist" %>
          <% if from_checklist %>
            <%= hidden_field_tag :from, "checklist" %>
            <% if MemberAdmin::ChecklistHelper::CHECKLIST_LABELS.key?(params[:task]) %>
              <%= hidden_field_tag :task, params[:task] %>
            <% end %>
          <% end %>
          <%
            info = @info_draft || @member
            errors = @info_errors || {}
            field_errors = ->(field, description = nil) do
              error_id = "member_#{field}_error" if errors.key?(field)
              tag.attributes(aria: { invalid: ("true" if error_id), describedby: [description, error_id].compact.join(" ").presence })
            end
            error_message = ->(field) do
              if errors.key?(field)
                tag.p(errors[field], id: "member_#{field}_error", style: "color:#b42318; font-size:14px; margin-top:6px;")
              end
            end
          %>
          <% if @info_errors %>
            <div id="info-errors" role="alert" style="border-left: 3px solid #b42318; background: #fff; padding: 14px 16px; margin-top: 16px;">
              <strong>저장하지 못했어요. 쓴 내용은 그대로 남아 있어요.</strong>
              <ul>
                <% errors.each_value do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <div id="bio" class="checklist-target" style="margin-top: 16px;">
            <label for="member_bio" class="impd-label-muted">자기소개 <span style="font-weight: 400; color: var(--impd-muted);">(필수)</span></label>
            <p id="member_bio_guide" class="impd-label-muted" style="margin-top: 6px; font-size: 14px;">어떤 분께 무엇을 해 드리는지 두세 줄(50자 넘게) 적어 주세요. 고객이 내 페이지 맨 위에서 읽어요.</p>
            <textarea id="member_bio" name="member[bio]" rows="6" maxlength="200"
                      <%= field_errors.call(:bio, "member_bio_guide member_bio_count") %> data-editor-info-target="bio" data-action="input->editor-info#updateBioCount"
                      placeholder="예: 분당에서 15년째 보험 설계를 하고 있어요. 꼭 필요한 보장만 쉽게 설명해 드리고, 보험금 청구도 끝까지 도와드려요."><%= info.bio %></textarea>
            <%= error_message.call(:bio) %>
            <% bio_count = info.bio.to_s.length %>
            <% bio_hint = if bio_count < 20
              "20자를 넘기면 내 페이지를 공개할 수 있어요."
            elsif bio_count < 50
              "공개할 수 있어요. 50자를 넘기면 준비 항목 '자기소개'가 채워져요."
            else
              "충분해요."
            end %>
            <p id="member_bio_count" class="impd-label-muted" style="margin-top: 6px;"><span data-editor-info-target="bioCount"><%= bio_count %></span> / 200자 · <span data-editor-info-target="bioHint"><%= bio_hint %></span></p>
            <% if from_checklist && params[:task] == "bio" %>
              <div data-task-save="bio" style="margin-top: 12px;">
                <button type="submit" class="impd-btn impd-btn-accent" style="height: 48px; padding: 0 20px; font-size: 15px; width: 100%; justify-content: center;">저장하고 다음 할 일로 →</button>
                <p class="impd-label-muted" style="font-size: 13px; margin-top: 8px; text-align: center;">아래 칸은 지금 안 채워도 돼요. 나중에 채울 수 있어요.</p>
              </div>
            <% end %>
          </div>

          <div id="profession-region" class="checklist-target editor-pair" style="margin-top: 14px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px;">
            <div>
              <% submitted_profession = params.dig(:member, :profession) if @info_draft %>
              <% preset_profession = submitted_profession || (Member::PROFESSIONS.include?(info.profession) ? info.profession : "custom") %>
              <% custom_profession = params.dig(:member, :custom_profession) if @info_draft %>
              <% custom_profession ||= info.profession unless Member::PROFESSIONS.include?(info.profession) %>
              <label for="member_profession" class="impd-label-muted">직업 <span style="font-weight: 400; color: var(--impd-muted);">(선택)</span></label>
              <select id="member_profession" name="member[profession]" data-editor-info-target="profession" data-action="change->editor-info#toggleProfession" <%= field_errors.call(:profession) %>>
                <% [["목록에 없어요 (직접 적기)", "custom"], ["보험 설계사", "insurance_agent"], ["공인중개사", "realtor"], ["강사", "educator"], ["작가", "author"], ["자영업자", "shopowner"], ["프리랜서", "freelancer"]].each do |label, value| %>
                  <option value="<%= value %>" <%= "selected" if preset_profession == value %>><%= label %></option>
                <% end %>
              </select>
              <%= error_message.call(:profession) %>
              <div data-editor-info-target="customProfession" style="margin-top: 12px;" <%= "hidden" if preset_profession != "custom" %>>
                <label for="member_custom_profession" class="impd-label-muted">직업 이름 적기 <span style="font-weight: 400; color: var(--impd-muted);">(선택)</span></label>
                <input type="text" id="member_custom_profession" name="member[custom_profession]" <%= field_errors.call(:custom_profession, "member_custom_profession_help") %>
                       value="<%= custom_profession %>" placeholder="예: 스마트폰 강사">
                <p id="member_custom_profession_help" class="impd-label-muted" style="margin-top: 6px; font-size: 13px;">비워 두면 내 페이지에 직업이 안 보여요.</p>
                <%= error_message.call(:custom_profession) %>
              </div>
            </div>
            <div>
              <label for="member_region" class="impd-label-muted">지역 <span style="font-weight: 400; color: var(--impd-muted);">(선택)</span></label>
              <input type="text" id="member_region" name="member[region]" value="<%= info.region %>" placeholder="예: 서울 · 성북" <%= field_errors.call(:region) %>>
              <%= error_message.call(:region) %>
            </div>
          </div>

          <% if from_checklist && params[:task] == "profession-region" %>
            <div data-task-save="profession-region" style="margin-top: 12px;">
              <button type="submit" class="impd-btn impd-btn-accent" style="height: 48px; padding: 0 20px; font-size: 15px; width: 100%; justify-content: center;">저장하고 다음 할 일로 →</button>
              <p class="impd-label-muted" style="font-size: 13px; margin-top: 8px; text-align: center;">아래 칸은 지금 안 채워도 돼요. 나중에 채울 수 있어요.</p>
            </div>
          <% end %>

          <div class="editor-pair" style="margin-top: 14px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px;">
            <div>
              <label for="member_email" class="impd-label-muted">이메일 <span style="font-weight: 400; color: var(--impd-muted);">(필수)</span></label>
              <input type="text" inputmode="email" autocomplete="email" id="member_email" name="member[email]" value="<%= info.email %>" <%= field_errors.call(:email) %>>
              <%= error_message.call(:email) %>
            </div>
            <div>
              <label for="member_phone" class="impd-label-muted">전화번호 <span style="font-weight: 400; color: var(--impd-muted);">(선택)</span></label>
              <input type="tel" inputmode="tel" autocomplete="tel" id="member_phone" name="member[phone]" value="<%= info.phone %>" placeholder="010-0000-0000" <%= field_errors.call(:phone) %>>
              <%= error_message.call(:phone) %>
            </div>
          </div>

          <div style="margin-top: 14px;">
            <label for="member_kakao_channel" class="impd-label-muted">카카오톡 채널 주소 <span style="font-weight: 400; color: var(--impd-muted);">(선택)</span></label>
            <input type="url" id="member_kakao_channel" name="member[kakao_channel]" value="<%= (@info_draft && params.dig(:member, :kakao_channel)) || info.social["kakao_channel"] %>" placeholder="https://pf.kakao.com/..." <%= field_errors.call(:kakao_channel) %>>
            <%= error_message.call(:kakao_channel) %>
          </div>

          <div style="margin-top: 14px;">
            <label for="member_career_note" class="impd-label-muted">경력·이력 <span style="font-weight: 400; color: var(--impd-muted);">(선택)</span></label>
            <div id="member_career_note_hint" class="impd-label-muted" style="margin-top: 6px;">학력·경력·수상·자격 등을 자유롭게 쓰세요. 정해진 형식은 없습니다.</div>
            <textarea id="member_career_note" name="member[career_note]" rows="6" <%= field_errors.call(:career_note, "member_career_note_hint") %>
                      placeholder="예시)
1970년생
학력 - OO대 신문방송학과 졸업 (1995)
경력 - KBS PD (1996~2015), 한국환경저널 발행인 (2016~)
수상 - 방송대상 (2010)
자격 - 사회복지사 2급"><%= info.career_note %></textarea>
            <%= error_message.call(:career_note) %>
          </div>

          <button type="submit" class="impd-btn impd-btn-accent" style="margin-top: 20px; height: 52px; padding: 0 28px; font-size: 15px; width: 100%; justify-content: center;">
            <%= from_checklist ? "저장하고 다음 할 일로 →" : "정보 저장하고 다음 →" %>
          </button>
          <p class="impd-label-muted" style="font-size: 14px; margin-top: 10px; text-align: center;">저장을 눌러야 내 페이지에 반영돼요.</p>
        <% end %>
      </section>

      <%# 우: AI 추출 달란트 요약 %>
      <div>
        <div class="impd-card" style="margin-bottom: 14px;">
          <div class="impd-label-muted" style="margin-bottom: 10px;">올린 글에서 찾은 강점<% if @skills.any? %> · <%= @skills.size %>개<% end %></div>
          <% if @skills.any? %>
            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
              <% @skills.each do |ms| %>
                <span style="display: inline-flex; align-items: center; gap: 3px; padding: 5px 10px; background: <%= ms.weight >= 60 ? 'var(--impd-ink)' : 'var(--impd-paper)' %>; color: <%= ms.weight >= 60 ? 'var(--impd-paper)' : 'var(--impd-ink)' %>; border: 1px solid var(--impd-ink); font-size: 12px;">
                  <%= ms.skill.canonical_name %>
                  <% if ms.weight >= 60 %><span style="font-size: 12px; opacity: 0.7;">· <%= ms.weight %></span><% end %>
                </span>
              <% end %>
            </div>
            <p class="impd-label-muted" style="margin-top: 14px;">
              올린 글 <%= @doc_count %>개에서 찾았어요. 숫자가 클수록 글에 자주 나온 강점이에요.
            </p>
          <% elsif @doc_count == 0 %>
            <p style="font-size: 13px; color: var(--impd-muted); margin: 12px 0;">
              이력서나 경력을 적은 글을 올리면, 그 안에서 강점을 찾아 여기에 보여 드려요.
            </p>
            <a href="<%= editor_path %>?step=1&amp;tab=docs#docs" class="impd-btn impd-btn-secondary" style="margin-top: 6px;">← 글 올리러 가기</a>
          <% else %>
            <p style="font-size: 13px; color: var(--impd-muted); margin: 12px 0;">
              올린 글 <%= @doc_count %>개에서는 아직 강점을 찾지 못했어요. 자격·수상·전문 분야를 적은 글을 더 올리면 찾기 쉬워요. 없어도 페이지는 공개할 수 있어요.
            </p>
            <a href="<%= editor_path %>?step=1&amp;tab=docs#docs" class="impd-btn impd-btn-secondary" style="margin-top: 6px;">글 더 올리기</a>
          <% end %>
        </div>

        <div class="impd-card" aria-labelledby="editor-added-materials-title">
          <h2 id="editor-added-materials-title" class="impd-label-muted" style="margin-bottom: 10px;">지금까지 넣은 것</h2>
          <p class="impd-label-muted" style="font-size: 13px; margin-bottom: 6px;">눌러서 더 넣거나 고칠 수 있어요.</p>
          <ul style="list-style: none; padding: 0; margin: 0; font-size: 13px; color: var(--impd-ink);">
            <% [
              ["file-multiple", "글", @doc_count, "?step=1&tab=docs#docs"],
              ["camera-1", "사진·영상", @photos_count, "?step=1&tab=media#media"],
              ["service-bell-1", "서비스", @services_count, slug_admin_services_path(slug: @member.slug)]
            ].each do |icon, label, count, path| %>
              <li style="border-bottom: 1px dashed var(--impd-rule);">
                <a href="<%= path %>" style="min-height: 44px; display: flex; align-items: center; gap: 8px; color: inherit; text-decoration: none;">
                  <%= lni_icon icon, size: 20 %><span><%= label %> <strong><%= count %></strong>개</span>
                  <span style="margin-left: auto; color: var(--impd-accent); font-weight: 600; font-size: 13px;"><%= count.zero? ? "넣으러 가기 →" : "더 넣기 →" %></span>
                </a>
              </li>
            <% end %>
            <li>
              <a href="?step=1&amp;tab=media#media" style="min-height: 44px; display: flex; align-items: center; gap: 8px; color: inherit; text-decoration: none;">
                <%= lni_icon "folder-1", size: 20 %><span>작업 사진·사례 <strong><%= @portfolio_count %></strong>개</span>
                <span style="margin-left: auto; color: var(--impd-accent); font-weight: 600; font-size: 13px;">사진 올리러 가기 →</span>
              </a>
              <p class="impd-label-muted" style="font-size: 13px;">작업 사진은 1단계 '사진·영상'에서 올릴 수 있어요.</p>
            </li>
          </ul>
        </div>
      </div>
    </div>

  <% elsif @step == 3 %>
    <% current_theme_key = ThemePreset.find(@member.theme_preset) ? @member.theme_preset : "editorial" %>
    <% current_layout_key = LayoutPreset.find(@member.layout_preset) ? @member.layout_preset : "editorial" %>
    <!-- ── Step 3: 스타일 선택 (5개 스타일) ───────────── -->
    <div class="impd-section-header">
      <span class="impd-label">스타일</span>
      <h1 class="impd-display" style="font-size: 36px; flex: 1; margin: 0;">스타일 선택</h1>
      <span class="impd-label-muted"><%= (ThemePreset.find(@member.theme_preset)&.dig(:name)).then { |n| n ? "지금: #{n}" : "지금: 잡지형 (기본)" } %></span>
    </div>

    <p style="font-size: 15px; color: var(--impd-ink2); margin-bottom: 24px; max-width: 60ch;">
      내 페이지의 색과 분위기를 골라 주세요. 나중에 언제든 바꿀 수 있어요.
    </p>

    <%= form_with url: slug_admin_editor_update_style_path(slug: @member.slug), method: :patch, local: true, data: { turbo: false } do |f| %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px;">
        <% @presets.each do |p| %>
          <label style="cursor: pointer; display: block;">
            <input type="radio" name="theme_preset" value="<%= p[:key] %>" <%= "checked" if current_theme_key == p[:key] %> style="position: absolute; opacity: 0;" class="theme-radio">
            <div class="theme-card<%= " is-saved" if current_theme_key == p[:key] %>" style="background: <%= p[:paper] %>; color: <%= p[:ink] %>; border: 1px solid var(--impd-rule); padding: 20px; min-height: 180px; display: flex; flex-direction: column; justify-content: space-between; transition: all .15s;">
              <div>
                <div style="font-family: var(--impd-font-sans); font-size: 13px; color: inherit; opacity: .75;">
                  <%= "지금 내 페이지" if current_theme_key == p[:key] %>
                </div>
                <div style="font-family: var(--impd-font-display); font-weight: 800; font-size: 28px; letter-spacing: -0.5px; line-height: 1; margin-top: 8px;">
                  <%= p[:name] %>
                </div>
              </div>
              <div style="height: 36px; margin: 12px 0; border-top: 3px solid <%= p[:accent] %>; border-bottom: 1px solid <%= p[:ink] %>; opacity: .6;"></div>
              <div style="font-size: 13px; opacity: 0.75; line-height: 1.5; display: flex; align-items: center; justify-content: space-between; gap: 12px;">
                <span><%= p[:desc] %></span>
                <span style="display: inline-flex; flex-shrink: 0; gap: 4px;" aria-label="강조색과 배경색">
                  <span style="width: 14px; height: 14px; border-radius: 50%; background: <%= p[:accent] %>; border: 1px solid rgba(0,0,0,0.16);"></span>
                  <span style="width: 14px; height: 14px; border-radius: 50%; background: <%= p[:paper] %>; border: 1px solid rgba(0,0,0,0.16);"></span>
                </span>
              </div>
            </div>
          </label>
        <% end %>
      </div>

      <div class="impd-section-header" style="margin-top: 48px;">
        <span class="impd-label">페이지 구성</span>
        <span class="impd-display" style="font-size: 28px; flex: 1;">내용을 어떻게 늘어놓을까요</span>
        <span class="impd-label-muted">지금: <%= LayoutPreset.find(@member.layout_preset)&.dig(:name) || "길게 읽는 형" %></span>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px;">
        <% @layout_presets.each do |p| %>
          <label style="cursor: pointer; display: block;">
            <input type="radio" name="layout_preset" value="<%= p[:key] %>" <%= "checked" if current_layout_key == p[:key] %> style="position: absolute; opacity: 0;" class="layout-radio">
            <div class="layout-card<%= " is-saved" if current_layout_key == p[:key] %>" style="background: var(--impd-card); color: var(--impd-ink); border: 1px solid var(--impd-rule); padding: 20px; min-height: 140px; display: flex; flex-direction: column; justify-content: space-between; transition: all .15s;">
              <div>
                <div style="font-family: var(--impd-font-sans); font-size: 13px; color: inherit; opacity: .75;">
                  <%= "지금 내 페이지" if current_layout_key == p[:key] %>
                </div>
                <div style="font-family: var(--impd-font-display); font-weight: 800; font-size: 28px; letter-spacing: -0.5px; line-height: 1; margin-top: 8px;">
                  <%= p[:name] %>
                </div>
              </div>
              <% preview_theme = ThemePreset.find(@member.theme_preset) || @presets.first %>
              <div style="background: <%= preview_theme[:paper] %>; color: <%= preview_theme[:ink] %>; border-top: 6px solid <%= preview_theme[:accent] %>; padding: 12px; margin: 12px 0; min-height: 60px;"><strong><%= p[:name] %></strong><div style="border-top: 1px solid; margin-top: 8px; opacity: .5;"></div></div>
              <div style="font-size: 13px; opacity: 0.75; line-height: 1.5;">
                <%= p[:desc] %>
              </div>
            </div>
          </label>
        <% end %>
      </div>

      <button type="submit" class="impd-btn impd-btn-primary" style="margin-top: 28px; height: 52px; padding: 0 28px; font-size: 15px;">
        이 스타일로 저장하고 다음 →
      </button>
      <p class="impd-label-muted" style="margin-top: 10px;">'✓ 골랐어요'가 붙은 카드는 아직 저장 전이에요. 이 버튼을 눌러야 내 페이지에 반영돼요.</p>
    <% end %>

  <% else %>
    <!-- ── Step 4: 공개 준비 항목 ─────────────── -->
    <div class="impd-section-header">
      <span class="impd-label">공개</span>
      <h1 class="impd-display" style="font-size: 36px; flex: 1; margin: 0;"><%= step4_done ? "내 페이지가 공개돼 있어요" : "내 페이지 공개하기" %></h1>
      <% if @member.published_at %>
        <span class="impd-label-muted" style="color: var(--impd-accent);">● 공개 중 · <%= @member.published_at.in_time_zone("Asia/Seoul").strftime("%Y.%m.%d") %>부터</span>
      <% end %>
    </div>

    <div style="display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 40px;" class="editor-grid">
      <%# 좌: 체크리스트 %>
      <div style="background: var(--impd-paper); border: 1px solid var(--impd-rule); padding: 24px;">
        <% done_count = @checklist.count { |c| c[:done] } %>
        <% pct = (done_count * 100.0 / @checklist.size).round %>

        <h2 class="impd-label">내 페이지 준비 항목</h2>
        <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 14px;">
          <span class="impd-display" style="font-size: 36px;"><%= done_count %><span style="color: var(--impd-muted); font-weight: 400;">/<%= @checklist.size %></span></span>
          <span class="impd-label-muted"><%= @checklist.size %>개 중 <%= done_count %>개 마쳤어요</span>
        </div>
        <p class="impd-label-muted" style="margin-bottom: 14px;">대시보드의 '다음 할 일'과 같은 목록이에요. 많이 채울수록 고객이 믿고 연락해요.</p>
        <div style="height: 6px; background: var(--impd-card); border: 1px solid var(--impd-ink); margin-bottom: 18px;">
          <div style="height: 100%; width: <%= pct %>%; background: var(--impd-accent); transition: width .3s;"></div>
        </div>

        <ul style="list-style: none; padding: 0; margin: 0;">
          <% @checklist.each do |item| %>
            <li style="display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px dashed var(--impd-rule); font-size: 14px; color: <%= item[:done] ? 'var(--impd-ink)' : 'var(--impd-muted)' %>;">
              <span aria-hidden="true" style="flex: 0 0 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; border: 1.5px <%= item[:done] ? 'solid var(--impd-accent)' : 'dashed var(--impd-rule)' %>; color: <%= item[:done] ? 'var(--impd-accent)' : 'transparent' %>; font-weight: 700; font-size: 13px;"><%= lni_icon "check" %></span>
              <span style="flex: 1;"><%= item[:label] %> <span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);"><%= item[:done] ? "(마침)" : "(아직)" %></span></span>
              <% unless item[:done] %>
                <a href="<%= item[:path] %>"
                   style="font-family: var(--impd-font-sans); font-size: 13px; color: var(--impd-accent); display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline;"><%= item[:action] %> →</a>
              <% end %>
            </li>
          <% end %>
        </ul>
        <p class="impd-label-muted" style="margin-top: 14px;">
          스타일: <%= ThemePreset.find(@member.theme_preset)&.dig(:name) || "잡지형 (기본)" %> · <a href="<%= editor_path %>?step=3" style="color: var(--impd-accent); text-decoration: underline; display: inline-flex; align-items: center; min-height: 44px;">바꾸기</a>
        </p>
      </div>

      <%# 우: 공개 카드 %>
      <div>
        <div style="background: var(--impd-ink); color: var(--impd-paper); padding: 28px; margin-bottom: 14px; position: relative;">
          <div class="impd-stripe" style="position: absolute; inset: 0; opacity: 0.15;"></div>
          <div style="position: relative;">
            <div class="impd-label" style="color: var(--impd-paper);">내 페이지 주소</div>
            <div class="impd-display" style="font-size: 28px; margin-top: 10px; word-break: break-all;">
              impd.townin.net/<%= @member.slug %>
            </div>
            <div style="margin-top: 14px; font-size: 13px; color: rgba(239,236,228,.7); line-height: 1.55;">
              <%= step4_done ? "지금" : "공개하면" %> 누구나 이 주소로 내 페이지를 볼 수 있어요. 카카오톡·문자로 주소를 보내면 내 명함 그림이 함께 보여요.
            </div>
          </div>
        </div>

        <% if step4_done %>
          <% if params[:published] == "1" %>
            <div id="publish-done" role="status" style="border-left: 3px solid var(--impd-accent); background: #fff; padding: 16px; margin-bottom: 14px;">
              <strong>공개했어요.</strong>
              <p>이제 주소를 복사해 카카오톡이나 문자로 고객에게 보내 보세요. 명함에 QR 그림을 넣어도 좋아요.</p>
            </div>
          <% end %>
          <div id="publish-next-actions">
            <% page_path = public_profile_path(slug: @member.slug) %>
            <button type="button" class="impd-btn impd-btn-primary" data-page-path="<%= page_path %>"
                    onclick="navigator.clipboard.writeText(window.location.origin + this.dataset.pagePath).then(() => { this.textContent = '복사했어요' })">주소 복사</button>
            <%= link_to "내 페이지 보기", page_path, target: "_blank", rel: "noopener", class: "impd-btn impd-btn-secondary" %>
          </div>
          <p class="impd-label-muted" style="font-size: 14px; margin-top: 12px;">고친 내용은 저장하면 바로 내 페이지에 반영돼요. 다시 공개할 필요는 없어요.</p>
          <div class="editor-publish-links">
            <%= link_to "QR 그림 저장", member_qr_path(slug: @member.slug, format: :svg), download: "#{@member.slug}-qr.svg" %>
            <span aria-hidden="true">·</span>
            <%= link_to "대시보드로 가기", slug_admin_dashboard_path(slug: @member.slug) %>
          </div>
        <% else %>
          <% if !@can_publish %>
            <p style="margin-bottom: 12px; font-size: 14px; color: var(--impd-ink2); line-height: 1.55;">
              공개하려면 아직 필요해요: <strong><%= @publish_missing.join(" · ") %></strong>
            </p>
            <a href="<%= slug_admin_editor_path(slug: @member.slug, step: 2, anchor: @publish_missing.include?("자기소개 20자 이상") ? "bio" : "profession-region") %>"
               class="impd-btn impd-btn-secondary" style="width: 100%; height: 48px; margin-bottom: 12px; justify-content: center;">내 정보 적으러 가기 →</a>
          <% else %>
            <% remaining_count = @checklist.size - done_count %>
            <p id="publish-ready-hint" style="font-size: 14px; color: var(--impd-ink2); line-height: 1.55; margin-bottom: 12px;">
              <% if remaining_count.positive? %>
                <strong>지금 공개할 수 있어요.</strong> 남은 준비 항목 <%= remaining_count %>개는 공개한 뒤에 채워도 돼요.
              <% else %>
                <strong>준비를 모두 마쳤어요.</strong> 이제 공개만 하면 돼요.
              <% end %>
            </p>
          <% end %>

          <%= form_with url: slug_admin_editor_publish_path(slug: @member.slug), method: :patch, local: true, data: { turbo: false } do %>
            <button type="submit" class="impd-btn impd-btn-primary"
                    style="width: 100%; height: 56px; font-size: 16px; justify-content: center;"
                    <%= "disabled" if !@can_publish %>>
              지금 공개하기
            </button>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- 단계 네비 -->
  <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; margin-top: 60px; padding-top: 24px; border-top: 1px solid var(--impd-rule);">
    <% if @step > 1 %><a href="<%= editor_path %>?step=<%= @step - 1 %>" class="impd-btn impd-btn-secondary">← 이전</a><% else %>
      <span class="impd-label-muted" style="align-self: center;">올린 파일은 바로 저장돼요. 다 올렸으면 다음으로 가세요.</span>
    <% end %>
    <% if @step == 1 %>
      <a href="<%= editor_path %>?step=2" class="impd-btn impd-btn-primary">다음 →</a>
    <% elsif @step < 4 %>
      <a href="<%= editor_path %>?step=<%= @step + 1 %>" class="editor-skip-link" style="color: var(--impd-muted); font-size: 13px; text-decoration: underline; min-height: 44px; display: inline-flex; align-items: center;">저장하지 않고 다음 단계 보기 →</a>
    <% end %>
  </div>
</div>

<style>
  .profile-photo { margin-top: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--impd-rule); }
  .profile-photo-row { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-block: 12px; }
  .profile-photo-preview { width: 6rem; height: 6rem; border-radius: 50%; object-fit: cover; display: grid; place-items: center; background: var(--impd-paper); font-size: 2rem; }
  .profile-photo-picker { position: relative; cursor: pointer; }
  .profile-photo-picker input { position: absolute; inset: 0; width: 100%; opacity: 0; cursor: pointer; }
  .profile-photo-picker:focus-within, .profile-photo-choice:focus-visible { outline: 2px solid var(--impd-accent); outline-offset: 2px; }
  #profile-photo-hint, .profile-photo-reassurance { margin-top: 6px; font-size: 13px; color: var(--impd-muted); }
  .profile-photo-status { margin-top: 8px; font-size: 13px; color: var(--impd-ink2); }
  .profile-photo-error { margin-top: 8px; font-weight: 600; }
  .profile-photo-choices { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .profile-photo-choice { padding: 0; border: 1px solid var(--impd-rule); background: var(--impd-paper); cursor: pointer; }
  .profile-photo-choice img { display: block; width: 3.5rem; height: 3.5rem; object-fit: cover; }
  .editor-file-rules {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--impd-muted);
  }
  .editor-file-rules strong { color: var(--impd-ink); font-weight: 600; }
  .editor-file-rules li + li { margin-top: 8px; }
  @media (min-width: 769px) {
    .editor-file-rules { grid-column: 1; grid-row: 2; }
    .editor-upload-card { grid-column: 2; grid-row: 1 / span 2; }
  }
  @media (max-width: 768px) {
    #member_bio { min-height: 240px; }
    .editor-page .impd-section-header > .impd-display { flex: 1 1 100% !important; font-size: 28px !important; word-break: keep-all; }
    .editor-page .impd-section-header > .impd-label-muted { flex: 1 1 100%; }
    .editor-upload-grid { grid-template-rows: auto !important; }
    .editor-intro h1 { font-size: 32px !important; line-height: 1.15 !important; margin-top: 10px !important; }
    .editor-br-wide { display: none; }
    .editor-intro p { margin-top: 12px !important; }
    .editor-file-rules { margin-top: 0; }
  }
  .editor-page button, .editor-page select, .editor-page .impd-btn { min-height: 44px; }
  .editor-fields { min-inline-size: 0; }
  .editor-fields label.impd-label-muted { font-size: 14px; font-weight: 600; color: var(--impd-ink2); }
  .editor-page select, .editor-fields :is(input, textarea) {
    max-width: 100%;
    border: 1px solid var(--impd-rule);
    background: #fff;
    color: var(--impd-ink);
    font-family: var(--impd-font-sans);
    font-size: 16px;
  }
  .editor-fields :is(input, select, textarea) {
    width: 100%;
    margin-top: 6px;
    box-sizing: border-box;
    min-height: 48px;
    padding: 11px 12px;
    border-radius: 0;
    line-height: 1.5;
  }
  .editor-page select:focus, .editor-fields :is(input, textarea):focus {
    border-color: var(--impd-accent);
    outline: 2px solid var(--impd-accent);
    outline-offset: 1px;
  }
  .editor-fields textarea { resize: vertical; }
  .editor-fields [aria-invalid="true"] { border-color: #b42318; }
  #publish-next-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  #publish-next-actions .impd-btn { height: 52px; justify-content: center; }
  .editor-publish-links { display: flex; flex-wrap: wrap; align-items: center; gap: 0 8px; }
  .editor-publish-links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--impd-accent); text-decoration: underline; }
  @media (max-width: 480px) { #publish-next-actions { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 768px) { .editor-grid { grid-template-columns: minmax(0, 1fr) !important; gap: 24px !important; } .editor-page > div:first-of-type a { padding: 12px 4px !important; min-width: 0; } .editor-page > div:first-of-type a p { font-size: 13px !important; word-break: keep-all; overflow-wrap: break-word; } .editor-page .impd-section-header { flex-wrap: wrap; } }
  @media (max-width: 480px) { .editor-pair { grid-template-columns: minmax(0, 1fr) !important; } }
  .theme-card, .layout-card { position: relative; }
  .theme-radio:checked + .theme-card, .layout-radio:checked + .layout-card {
    border-color: var(--impd-accent) !important;
    box-shadow: 0 0 0 3px var(--impd-accent);
  }
  .theme-radio:checked + .theme-card::after, .layout-radio:checked + .layout-card::after {
    content: "✓ 골랐어요";
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 4px 8px;
    background: var(--impd-accent);
    color: #fff;
    font-family: var(--impd-font-sans);
    font-size: 12px;
    font-weight: 700;
  }
  .theme-radio:checked + .theme-card > :first-child,
  .layout-radio:checked + .layout-card > :first-child { padding-top: 22px; }
  .theme-radio:checked + .theme-card.is-saved::after,
  .layout-radio:checked + .layout-card.is-saved::after { content: none; }
  .theme-radio:checked + .theme-card.is-saved > :first-child,
  .layout-radio:checked + .layout-card.is-saved > :first-child { padding-top: 0; }
  .theme-radio:focus-visible + .theme-card, .layout-radio:focus-visible + .layout-card { outline: 3px solid var(--impd-accent); }
</style>
