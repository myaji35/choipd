<% doc_categories = MemberDocument::CATEGORIES %>
<% has_docs = member.member_documents.any? %>

<%# 파일이 이미 있으면 목록을 먼저 표시. 드롭존은 컴팩트 모드. %>
<% if has_docs %>
  <div style="display: grid; gap: 10px;">
    <% member.member_documents.order(uploaded_at: :desc).each do |d| %>
      <article data-controller="member-doc-row"
        data-member-doc-row-delete-url-value="<%= slug_admin_document_path(slug: member.slug, id: d.id, format: :json) %>"
        data-member-doc-row-update-url-value="<%= slug_admin_document_path(slug: member.slug, id: d.id, format: :json) %>"
        data-member-doc-row-csrf-value="<%= form_authenticity_token %>" data-member-doc-row-filename-value="<%= d.filename %>"
        style="border: 1px solid var(--impd-rule); padding: 14px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; min-width: 0;">
        <%= lni_icon "file-multiple", size: 20 %>
        <strong style="flex: 1; min-width: 120px; overflow-wrap: anywhere;"><%= d.filename %></strong>
        <span hidden data-category-chip style="border-radius: 999px; background: var(--impd-card); color: var(--impd-ink); padding: 5px 10px; font-size: 13px;"><%= { "bio" => "이력", "career" => "이력", "certificate" => "자격증", "awards" => "자격증", "review" => "후기", "portfolio" => "작품", "curriculum" => "작품", "course" => "작품", "interview" => "이력", "press" => "이력", "other" => "일상" }[d.category] || "일상" %></span>
        <div style="display: flex; align-items: center; gap: 10px; margin-left: auto;">
          <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--impd-muted);">종류
            <select data-action="change->member-doc-row#updateCategory" style="max-width: 100%; height: 44px; padding: 0 10px; border: 1px solid var(--impd-rule); background: #fff; color: var(--impd-ink); font-family: var(--impd-font-sans); font-size: 16px;">
              <% doc_categories.each do |cat| %>
                <option value="<%= cat %>" <%= "selected" if d.category == cat %>><%= { "bio" => "이력", "career" => "이력", "certificate" => "자격증", "awards" => "자격증", "review" => "후기", "portfolio" => "작품", "curriculum" => "작품", "course" => "작품", "interview" => "이력", "press" => "이력", "other" => "일상" }[cat] %></option>
              <% end %>
            </select>
          </label>
          <button type="button" class="impd-btn impd-btn-danger impd-btn-sm" aria-label="<%= d.filename %> 지우기" data-action="click->member-doc-row#destroy">지우기</button>
        </div>
      </article>
    <% end %>
  </div>
<% end %>

<% checklist_upload = params[:from] == "checklist" %>
<div data-controller="member-doc-uploader"
     data-member-doc-uploader-create-url-value="<%= slug_admin_documents_path(slug: member.slug, format: :json, from: ("checklist" if checklist_upload)) %>"
     <% if checklist_upload %>
       data-member-doc-uploader-done-url-value="<%= slug_admin_dashboard_path(slug: member.slug) %>"
     <% end %>
     data-member-doc-uploader-csrf-value="<%= form_authenticity_token %>">
  <div id="write-doc" style="margin-top: <%= has_docs ? '18px' : '0' %>; padding: 20px; border: 1px solid var(--impd-rule); background: var(--impd-paper); text-align: left;">
    <label for="doc_paste_text" style="font-size: 16px; font-weight: 700; color: var(--impd-ink);">이력·경력을 여기에 바로 적어 주세요</label>
    <p id="doc_paste_help" style="font-size: 14px; color: var(--impd-muted); margin-top: 6px;">이력·경력·자격·수상을 생각나는 대로 적어 주세요. 한글·워드 문서는 내용을 복사해 여기에 붙여 넣으면 돼요.</p>
    <textarea id="doc_paste_text" rows="6" aria-describedby="doc_paste_help" data-member-doc-uploader-target="pasteText"
      placeholder="예: 2010년부터 보험 설계사로 일하고 있어요. 우수 설계사상(2019), 손해사정사 자격."
      style="width: 100%; box-sizing: border-box; margin-top: 10px; min-height: 140px; padding: 11px 12px; border: 1px solid var(--impd-rule); background: #fff; color: var(--impd-ink); font-family: var(--impd-font-sans); font-size: 16px; line-height: 1.5; border-radius: 0; resize: vertical;"></textarea>
    <button type="button" class="impd-btn impd-btn-primary" data-action="click->member-doc-uploader#uploadText" data-member-doc-uploader-target="pasteButton" style="margin-top: 10px; min-height: 48px;">이 글 올리기</button>
    <p role="status" data-member-doc-uploader-target="pasteStatus" style="font-size: 14px; margin-top: 8px; min-height: 20px;"></p>
  </div>

  <div style="border: 1px dashed var(--impd-ink); padding: 20px 24px; text-align: center; background: var(--impd-card); margin-top: 18px;"
       data-action="dragover->member-doc-uploader#dragover dragleave->member-doc-uploader#dragleave drop->member-doc-uploader#drop">
    <p style="font-family: var(--impd-font-display); font-size: 15px; font-weight: 600;">글 파일(.txt)이 있으면 올려도 돼요</p>
    <label style="margin-top: 10px; display: inline-block; cursor: pointer;">
      <span class="impd-btn impd-btn-secondary" style="height: 44px; font-size: 14px;">파일 선택</span>
      <input type="file" multiple class="hidden" style="display:none;" accept=".md,.markdown,.txt"
             data-member-doc-uploader-target="fileInput"
             data-action="change->member-doc-uploader#fileSelected">
    </label>
    <input type="hidden" data-member-doc-uploader-target="title" value="">
    <select data-member-doc-uploader-target="category" style="display:none;"><option value="other">other</option></select>
    <% unless has_docs %>
      <p style="font-size: 12px; color: var(--impd-muted); margin-top: 12px;">여러 개를 한 번에 골라도 돼요. 한글·워드·PDF 는 내용을 복사해 위 칸에 붙여 넣어 주세요.</p>
    <% end %>

    <div data-member-doc-uploader-target="progress" style="display: none; margin-top: 14px;">
      <div style="background: var(--impd-rule); height: 4px; overflow: hidden;">
        <div data-member-doc-uploader-target="progressBar" style="background: var(--impd-accent); height: 100%; width: 0%; transition: width 0.2s ease;"></div>
      </div>
    </div>

    <div data-member-doc-uploader-target="error" style="display: none; margin-top: 12px; padding: 10px; background: rgba(180,35,24,.08); color: #b42318; font-size: 14px; text-align: left; overflow-wrap: anywhere; line-height: 1.5;"></div>
    <p data-member-doc-uploader-target="status" class="impd-label-muted" style="margin-top: 10px; min-height: 14px; overflow-wrap: anywhere;"></p>
  </div>
</div>
