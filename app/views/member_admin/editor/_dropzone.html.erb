<% doc_categories = MemberDocument::CATEGORIES %>
<% has_docs = member.member_documents.any? %>

<%# 파일이 이미 있으면 목록을 먼저 표시. 드롭존은 컴팩트 모드. %>
<% if has_docs %>
  <div style="display: grid; gap: 10px;">
    <% member.member_documents.order(uploaded_at: :desc).each do |d| %>
      <article data-controller="member-doc-row"
        data-member-doc-row-delete-url-value="<%= slug_admin_document_path(slug: member.slug, id: d.id, format: :json) %>"
        data-member-doc-row-update-url-value="<%= slug_admin_document_path(slug: member.slug, id: d.id, format: :json) %>"
        data-member-doc-row-csrf-value="<%= form_authenticity_token %>" data-member-doc-row-filename-value="<%= d.filename %>"
        style="border: 1px solid var(--impd-rule); padding: 14px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; min-width: 0;">
        <%= lni_icon "file-multiple", size: 20 %>
        <strong style="flex: 1; min-width: 120px; overflow-wrap: anywhere;"><%= d.filename %></strong>
    <span data-category-chip style="border-radius: 999px; background: var(--impd-card); color: var(--impd-ink); padding: 5px 10px; font-size: 13px;"><%= { "bio" => "이력", "career" => "이력", "certificate" => "자격증", "awards" => "자격증", "review" => "후기", "portfolio" => "작품", "curriculum" => "작품", "course" => "작품", "interview" => "이력", "press" => "이력", "other" => "일상" }[d.category] || "일상" %></span>
        <label>분류 바꾸기
          <select data-action="change->member-doc-row#updateCategory" style="max-width: 100%;">
            <% doc_categories.each do |cat| %>
              <option value="<%= cat %>" <%= "selected" if d.category == cat %>><%= { "bio" => "이력", "career" => "이력", "certificate" => "자격증", "awards" => "자격증", "review" => "후기", "portfolio" => "작품", "curriculum" => "작품", "course" => "작품", "interview" => "이력", "press" => "이력", "other" => "일상" }[cat] %></option>
            <% end %>
          </select>
        </label>
        <button type="button" data-action="click->member-doc-row#destroy">빼기</button>
      </article>
    <% end %>
  </div>
<% end %>

<%# 드롭존 — 파일 있으면 컴팩트, 없으면 full %>
<div style="border: <%= has_docs ? '1px' : '2px' %> dashed var(--impd-ink); padding: <%= has_docs ? '20px 24px' : '48px 24px' %>; text-align: center; background: var(--impd-card); margin-top: <%= has_docs ? '18px' : '0' %>;"
     data-controller="member-doc-uploader"
     data-member-doc-uploader-create-url-value="<%= slug_admin_documents_path(slug: member.slug, format: :json) %>"
     data-member-doc-uploader-csrf-value="<%= form_authenticity_token %>"
     data-action="dragover->member-doc-uploader#dragover dragleave->member-doc-uploader#dragleave drop->member-doc-uploader#drop">
  <% unless has_docs %>
    <%= lni_icon "cloud-upload", size: 20 %>
  <% end %>
  <p style="font-family: var(--impd-font-display); font-size: <%= has_docs ? '15px' : '22px' %>; font-weight: <%= has_docs ? '600' : '800' %>;">
    <%= has_docs ? "+ 새 파일 추가" : "아직 올린 자료가 없어요" %>
  </p>
  <% unless has_docs %>
    <p style="font-size: 14px; color: var(--impd-muted); margin-top: 8px;">또는 클릭해서 선택 — 여러 개 한 번에 OK</p>
  <% end %>
  <label style="margin-top: <%= has_docs ? '10px' : '20px' %>; display: inline-block; cursor: pointer;">
    <span class="<%= has_docs ? 'impd-btn impd-btn-secondary' : 'impd-btn impd-btn-primary' %>" style="<%= 'height: 44px; font-size: 14px;' if has_docs %>">파일 선택</span>
    <input type="file" multiple class="hidden" style="display:none;" accept=".md,.markdown,.txt"
           data-member-doc-uploader-target="fileInput"
           data-action="change->member-doc-uploader#fileSelected">
  </label>
  <input type="hidden" data-member-doc-uploader-target="title" value="">
  <select data-member-doc-uploader-target="category" style="display:none;"><option value="other">other</option></select>
  <% unless has_docs %>
    <p style="font-size: 12px; color: var(--impd-muted); margin-top: 12px;">파일명에 <strong>이력 / 수료 / 후기 / 강의 / 언론 / 작품</strong> 키워드가 있으면 자동 분류됩니다.</p>
  <% end %>

  <div data-member-doc-uploader-target="progress" style="display: none; margin-top: 14px;">
    <div style="background: var(--impd-rule); height: 4px; overflow: hidden;">
      <div data-member-doc-uploader-target="progressBar" style="background: var(--impd-accent); height: 100%; width: 0%; transition: width 0.2s ease;"></div>
    </div>
  </div>

  <div data-member-doc-uploader-target="error" style="display: none; margin-top: 12px; padding: 10px; background: rgba(255,90,31,.1); color: var(--impd-accent-2); font-size: 12px; text-align: left; line-height: 1.5;"></div>
  <p data-member-doc-uploader-target="status" class="impd-label-muted" style="margin-top: 10px; min-height: 14px;"></p>
</div>
