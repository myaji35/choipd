<section id="channel-status" aria-labelledby="channel-status-title" style="background: #fff; border: 1px solid var(--impd-rule); padding: 24px; margin-bottom: 24px;">
  <p class="impd-label">내 채널 운영 현황</p>
  <h2 id="channel-status-title" style="font-size: 24px; margin-top: 10px;">블로그 · 페이스북 · 인스타그램</h2>
  <p style="font-size: 14px; color: var(--impd-muted); margin: 8px 0 18px;">운영팀이 내 채널에 글을 대신 올려 드려요. 여기서는 어떻게 되고 있는지만 보시면 돼요.</p>
  <div class="channel-overview-grid">
    <% items.each do |item| %>
      <% channel = item[:channel] %>
      <article class="channel-overview-row">
        <% if channel %>
          <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px;">
            <h3 style="font-size: 16px; font-weight: 700;"><%= item[:label] %></h3>
            <%= render "member_admin/channels/state_badge", item: item %>
            <% if channel.account_handle.present? %>
              <span style="font-size: 13px; color: var(--impd-muted); overflow-wrap: anywhere;">계정 <%= channel.account_handle %></span>
            <% end %>
          </div>
          <%= render "member_admin/channels/state_note", item: item unless item[:state] == :running %>
          <%= render "member_admin/channels/progress", item: item, compact: true %>
          <% facts = channel_overview_facts(item) %>
          <% if facts.any? %>
            <dl class="channel-overview-facts">
              <% facts.each do |label, value| %>
                <div><dt><%= label %></dt> <dd><%= value %></dd></div>
              <% end %>
            </dl>
          <% end %>
        <% else %>
          <h3 style="font-size: 16px; font-weight: 700;"><%= item[:label] %> 등록 전</h3>
          <p style="color: var(--impd-muted); margin-top: 4px;">등록하면 운영팀이 글을 대신 올려 드려요. 등록은 운영자·PD에게 요청해 주세요.</p>
        <% end %>
        <% if channel || impersonating_admin_user&.admin? %>
          <div style="display: flex; flex-wrap: wrap; gap: 0 16px;">
            <% if channel %>
              <%= link_to "자세히 보기", slug_admin_channels_path(slug: @member.slug, anchor: "channel-#{channel.id}"), style: channel_link_style %>
              <% if (profile_url = http_url(channel.profile_url)) %>
                <%= link_to "프로필 열기 ↗", profile_url, target: "_blank", rel: "noopener", style: channel_link_style %>
              <% end %>
            <% end %>
            <% if impersonating_admin_user&.admin? %>
              <%= link_to "관리 화면에서 열기", channel_management_path(item), style: "#{channel_link_style} font-size: 12px; margin-left: auto;" %>
            <% end %>
          </div>
        <% end %>
      </article>
    <% end %>
  </div>
  <p style="margin-top: 12px;"><%= link_to "올린 글·예약된 글 모두 보기 →", slug_admin_channels_path(slug: @member.slug), style: channel_link_style %></p>
</section>
