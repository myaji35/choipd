<% content_for :title, "imPD를 쓰는 사람들" %>
<% content_for :description, "직업군과 지역으로 imPD의 공개 프로필을 찾아보세요." %>
<% content_for :head do %>
  <link rel="canonical" href="<%= public_base_url %><%= explore_path %>">
  <%= stylesheet_link_tag "impd_explore", "data-turbo-track": "reload" %>
<% end %>

<section class="explore-wrap impd-wrap">
  <header class="impd-enter">
    <p class="impd-label">회원 둘러보기</p>
    <h1 class="impd-display explore-title">imPD를 쓰는 사람들</h1>
    <% if @total_count.positive? %><p class="explore-subtitle">지금 <%= public_member_number(@total_count) %>명이 페이지를 운영 중이에요</p><% end %>
  </header>

  <div class="explore-filters" aria-label="회원 필터">
    <div class="explore-filter-row">
      <span class="explore-filter-label">분야</span>
      <div class="explore-chips">
        <%= link_to explore_path(region: @current_region), class: ["explore-chip", ("is-active" unless @selected_profession)], aria: { pressed: !@selected_profession } do %>
          전체 <span class="impd-chip-count"><%= @total_count %></span>
        <% end %>
        <% @profession_groups.each do |group| %>
          <% active = @selected_profession == group %>
          <%= link_to explore_path(profession: group[:key], region: @current_region), class: ["explore-chip", ("is-active" if active)], aria: { pressed: active } do %>
            <%= lni_icon group[:icon], size: 14 %> <%= group[:label] %> <span class="impd-chip-count"><%= group[:count] %></span>
          <% end %>
        <% end %>
      </div>
    </div>
    <% if @regions.size > 1 %>
      <div class="explore-filter-row">
        <span class="explore-filter-label">지역</span>
        <div class="explore-chips">
          <%= link_to explore_path(profession: @current_profession), class: ["explore-chip", ("is-active" unless @current_region)], aria: { pressed: !@current_region } do %>
            전체 <span class="impd-chip-count"><%= @total_count %></span>
          <% end %>
          <% @regions.each do |region, count| %>
            <% active = @current_region == region %>
            <%= link_to explore_path(profession: @current_profession, region: region), class: ["explore-chip", ("is-active" if active)], aria: { pressed: active } do %>
              <%= region %> <span class="impd-chip-count"><%= count %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @selected_profession || @current_region %>
    <div class="explore-result-heading">
      <p><%= [@selected_profession&.fetch(:label), @current_region].compact.join(" · ") %> — <%= @members.size %>명<%= " · 60명까지 보여요" if @more_members %></p>
      <%= link_to "필터 초기화", explore_path, class: "impd-link" %>
    </div>
  <% end %>
  <div class="explore-grid">
    <% if @members.any? %>
      <% @members.each do |member| %>
        <%= render "shared/member_card", member: member, cover: @cover_photo_by_member[member.id],
          service: @first_service_by_member[member.id]&.title %>
      <% end %>
    <% else %>
      <%= render "shared/empty_state", icon: "user-4", title: "조건에 맞는 회원이 없어요", text: "필터를 바꿔보세요.",
        action: (link_to("필터 초기화", explore_path, class: "impd-btn impd-btn-secondary") unless @selected_profession || @current_region) %>
    <% end %>
  </div>
  <% if brand_ops_public? %>
    <section class="explore-growth">
      <h2 class="impd-section-title">함께 자라는 imPD</h2>
      <p>회원들의 활동과 브랜드 이야기를 살펴보세요.</p>
      <a href="/growth" class="impd-link">imPD 성장 이야기 보기 →</a>
    </section>
  <% end %>
</section>
