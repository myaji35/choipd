<%
  member = local_assigns[:member]
  c = member ? { name: member.name.to_s, role: member.profession, region: member.region,
    bio: member.bio, image: member.profile_image, slug: member.slug, career: member.career_note } : local_assigns.fetch(:c)
  flow = local_assigns.fetch(:flow, false)
  loading = local_assigns.fetch(:loading, "lazy")
  label, icon = member_profession_details(c[:role])
  cover = local_assigns[:cover]
  defer_images = local_assigns.fetch(:defer_images, false)
  service = local_assigns[:service]
  career = c[:career].to_s.strip.lines.first&.strip
  example = c[:example] || example_member_slugs.include?(c[:slug])
%>
<%= content_tag(c[:example] ? :div : :a, href: member&.display_url,
    aria: (member && { label: "#{c[:name]} 페이지 보기" }),
    class: class_names("impd-member-card impd-home-member", "impd-flow-card": flow, "is-example": example)) do %>
  <% if cover %>
    <div class="impd-member-cover">
      <%= member_card_image cover.thumbnail_url, defer: defer_images, alt: "#{c[:name]}의 작업 사진", loading: loading, decoding: "async", width: 480, height: 320 %>
    </div>
  <% elsif flow %>
    <div class="impd-member-cover impd-flow-initial" aria-hidden="true"><%= c[:name].first %></div>
  <% end %>
  <% if example %><span class="impd-member-badge">예시</span><% end %>
  <div class="impd-member-identity">
    <% if c[:image].present? %>
      <%= member_card_image c[:image], defer: defer_images || (flow && cover), alt: "", class: "impd-member-avatar", loading: (cover && flow ? "lazy" : loading),
        decoding: "async", width: flow ? 40 : 48, height: flow ? 40 : 48 %>
    <% else %>
      <span class="impd-member-avatar" aria-hidden="true"><%= c[:name].first %></span>
    <% end %>
    <div>
      <div class="member-card-name"><%= c[:name] %></div>
      <div class="impd-member-meta"><%= lni_icon icon, size: 14 %> <%= label %></div>
    </div>
  </div>
  <% if c[:region].present? %><div class="impd-member-meta"><%= lni_icon "map-marker-5", size: 14 %> <%= c[:region] %></div><% end %>
  <% if c[:bio].present? %><p class="impd-member-bio"><%= c[:bio] %></p><% end %>
  <% if career.present? %><div class="impd-member-detail"><span>지금까지</span><span><%= truncate(career, length: 60) %></span></div><% end %>
  <% if service.present? %><div class="impd-member-detail"><span>지금</span><span><%= service %></span></div><% end %>
  <% unless flow || c[:example] %><div class="impd-member-more">페이지 보기 <%= lni_icon "arrow-right", size: 14 %></div><% end %>
<% end %>
