<% label, icon, tint = member_profession_details(c[:role]) %>
<% home_card = local_assigns.fetch(:home_card, false) %>
        <%= content_tag(c[:example] ? :div : :a, href: c[:example] ? nil : "/#{c[:slug]}", aria: c[:example] ? nil : { label: "#{c[:name]} 페이지 보기" }, class: ("impd-c2-card impd-home-member" if home_card), style: (unless home_card then "background: var(--impd-card); border: 1px #{c[:example] ? 'dashed' : 'solid'} var(--impd-rule); border-radius: 14px; box-shadow: 0 2px 10px rgba(0,0,0,.06); padding: 20px; color: var(--impd-ink); text-decoration: none; display: flex; flex-direction: column; gap: 12px; min-width: 0;" end)) do %>
          <div style="display: flex; align-items: center; gap: 12px;">
            <% if c[:image].present? %>
              <%= image_tag c[:image], alt: c[:name], loading: "lazy", decoding: "async", width: 48, height: 48, style: "width: 48px; height: 48px; border-radius: 50%; object-fit: cover; flex-shrink: 0;" %>
            <% else %>
              <div style="width: 48px; height: 48px; border-radius: 50%; background: <%= home_card ? "var(--impd-ceramic)" : tint %>; color: var(--impd-green-house); display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: <%= home_card ? 600 : 700 %>; flex-shrink: 0;"><%= c[:name].first %></div>
            <% end %>
            <div style="min-width: 0; flex: 1;">
              <div class="member-card-name" style="<%= "font-size: 17px; font-weight: 700;" unless home_card %>"><%= c[:name] %></div>
              <div style="font-size: 13px; color: var(--impd-muted); display: flex; align-items: center; gap: 4px;"><%= lni_icon icon, size: 14 %> <%= label %></div>
            </div>
            <% if c[:example] %><span style="font-size: <%= home_card ? "var(--impd-size-label)" : "12px" %>; color: var(--impd-muted); border: 1px solid var(--impd-rule); border-radius: 999px; padding: 3px 8px;">예시</span><% end %>
          </div>
          <% if c[:region].present? %><div style="font-size: 13px; color: var(--impd-muted); display: flex; align-items: center; gap: 4px;"><%= lni_icon "map-marker-5", size: 13 %> <%= c[:region] %></div><% end %>
          <% if c[:bio].present? %><div style="font-size: <%= home_card ? "var(--impd-size-body)" : "14px" %>; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= truncate(c[:bio], length: 60) %></div><% end %>
          <% unless c[:example] %><div style="margin-top: auto; font-size: 14px; font-weight: <%= home_card ? 600 : 700 %>; color: var(--impd-green-house); display: flex; align-items: center; gap: 4px;">페이지 보기 <%= lni_icon "arrow-right", size: 14 %></div><% end %>
        <% end %>
