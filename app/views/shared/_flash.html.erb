<% flash.each do |kind, message| %>
  <% next if message.blank? || !%w[notice success alert info].include?(kind.to_s) %>
  <% type = kind.to_s == "alert" ? "alert" : (kind.to_s == "info" ? "info" : "success") %>
  <% pending_guide = kind.to_s == "notice" && flash[:pending_guide] %>
  <div<%= " data-pending-notice" if pending_guide %> class="shared-flash shared-flash--<%= type %>" role="<%= type == 'alert' ? 'alert' : 'status' %>">
    <%= lni_icon(type == 'alert' ? 'xmark-circle' : 'check-circle-1') %>
    <span class="shared-flash-message">
      <%= message %>
      <% if pending_guide %>
        <span class="shared-flash-prep" data-pending-prep>기다리는 동안 준비해 두면 승인 뒤 바로 채울 수 있어요: 하는 일 한 가지(서비스 이름) · 자기소개 두세 줄 · 얼굴 사진</span>
        <%= link_to "기다리는 동안 예시 페이지 보기", example_profile_path, class: "shared-flash-link" %>
      <% end %>
    </span>
    <button type="button" aria-label="알림 닫기" onclick="this.parentElement.remove()"><%= lni_icon 'xmark' %></button>
  </div>
<% end %>
