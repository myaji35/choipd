<div class="public-member">
  <% if member.profession == "insurance_agent" %>
    <section class="public-member-inner"><h2>상담 안내</h2>
      <% if services.any? %><p>상담 분야</p><div class="public-actions"><% services.each do |service| %><span style="border: 1px solid var(--impd-rule); border-radius: 24px; padding: 6px 12px;"><%= service.title %></span><% end %></div><% end %>
      <% if member.career_note.present? %><p style="margin-top: 16px;">자격·경력: <%= member.career_note %></p><% end %>
      <p style="font-size: 13px; color: var(--impd-ink2); border: 1px solid var(--impd-rule); padding: 16px; margin-top: 16px;">보험설계사(모집인)의 안내입니다. 상품 가입 전 보험약관과 상품설명서를 반드시 확인하세요. 모집인 등록번호는 상담 시 안내해 드려요.</p>
    </section>
  <% end %>
  <section class="public-member-inner" id="contact"><h2>상담·문의하기</h2>
    <% if flash[:alert].present? %><p id="inquiry-alert" role="alert" tabindex="-1" style="border: 1px solid var(--impd-accent); padding: 12px; margin-top: 16px;"><%= flash[:alert] %></p><% end %>
    <% if flash[:inquiry_sent] %>
      <div id="inquiry-sent" role="status" tabindex="-1" style="border: 1px solid var(--impd-accent); padding: 20px; max-width: 640px; margin-top: 16px;">
        <p style="font-size: 18px; font-weight: 700;">보냈어요. 보통 24시간 안에 답장이 와요.</p>
        <p>남겨 주신 연락처로 <%= member.name %>님이 직접 답해 드려요.</p>
        <a href="<%= public_profile_path(slug: member.slug, anchor: "contact") %>" style="display: inline-flex; align-items: center; min-height: 44px; color: var(--impd-accent); text-decoration: underline;">다른 문의 더 보내기</a>
      </div>
      <script>
        (() => {
          const sent = document.getElementById('inquiry-sent');
          if (sent) {
            // Turbo applies its own scroll position after rendering the response.
            requestAnimationFrame(() => {
              sent.scrollIntoView({ block: 'center' });
              sent.focus({ preventScroll: true });
            });

            sent.querySelector('a').addEventListener('click', (event) => {
              if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

              // A fragment-only visit would leave the confirmation in place.
              event.preventDefault();
              history.replaceState(history.state, '', event.currentTarget.href);
              window.location.reload();
            });
          }
        })();
      </script>
    <% else %>
      <p style="color: var(--impd-ink2); margin-top: 4px;">남겨 주시면 <%= member.name %>님이 직접 확인하고 연락드려요.</p>
      <%= form_with model: MemberInquiry.new, url: member_inquiries_path(slug: member.slug), class: "public-form" do |form| %>
        <%= form.label :sender_name, "이름" %><%= form.text_field :sender_name, required: true, autocomplete: "name" %>
        <%= form.label :sender_email, "연락처 (전화 또는 이메일)" %><%= form.text_field :sender_email, required: true, autocomplete: "on", placeholder: "010-0000-0000 또는 메일 주소" %>
        <%= form.label :message, "문의 내용" %><%= form.text_area :message, required: true, minlength: 5, maxlength: 2000, rows: 5, placeholder: "궁금한 점이나 원하는 상담 내용을 적어 주세요." %>
        <label class="public-consent"><%= form.check_box :consent, { required: true }, "1", "0" %><span>이름과 연락처를 답변을 위해 <%= member.name %>님에게 전달하는 데 동의합니다. (필수)</span></label>
        <p class="public-consent-link"><a href="/privacy" target="_blank" rel="noopener">개인정보처리방침 보기</a></p>
        <%= hidden_field_tag :website, "", autocomplete: "off", tabindex: -1 %>
        <%= form.submit "문의 보내기" %>
        <p style="font-size: 14px; color: var(--impd-ink2); margin-top: 8px;">보통 24시간 안에 답장이 와요.</p>
      <% end %>
    <% end %>
  </section>
  <section class="public-member-inner"><h2>디지털 명함</h2><img src="/qr/<%= member.slug %>.svg" alt="<%= member.name %> QR 코드" width="160" height="160"><div class="public-actions"><a href="/qr/<%= member.slug %>.svg" download="<%= member.slug %>-qr.svg" aria-label="QR 저장">QR 저장</a><button type="button" aria-label="링크 복사" onclick="copyMemberLink(this)">링크 복사</button><a href="/card/<%= member.slug %>.svg" aria-label="명함 보기">명함 보기</a></div></section>
</div>
<script>
  (() => {
    const alert = document.getElementById('inquiry-alert');
    if (alert) {
      requestAnimationFrame(() => {
        alert.scrollIntoView({ block: 'center' });
        alert.focus({ preventScroll: true });
      });
    }
  })();

  (() => {
    const key = 'impd-inquiry-draft:' + location.pathname;
    const fields = ['member_inquiry_sender_name', 'member_inquiry_sender_email', 'member_inquiry_message']
      .map((id) => document.getElementById(id));
    let store, saved;
    try {
      store = window.sessionStorage;
      if (document.getElementById('inquiry-sent')) {
        store.removeItem(key);
        return;
      }
      saved = store.getItem(key);
    } catch (_) { return; }
    if (fields.some((field) => !field)) return;

    let draft;
    try { draft = JSON.parse(saved || '{}'); } catch (_) {}
    fields.forEach((field) => {
      if (field.value === '' && typeof draft?.[field.id] === 'string') field.value = draft[field.id];
    });
    const save = () => {
      try {
        store.setItem(key, JSON.stringify(Object.fromEntries(fields.map((field) => [field.id, field.value]))));
      } catch (_) {}
    };
    fields.forEach((field) => field.addEventListener('input', save));
    document.querySelectorAll('[data-inquiry-service]').forEach((link) => {
      link.addEventListener('click', () => requestAnimationFrame(save));
    });
  })();

  (() => {
    const message = document.getElementById('member_inquiry_message');
    if (!message) return;
    let lastPrefill;
    document.querySelectorAll('[data-inquiry-service]').forEach((link) => {
      link.addEventListener('click', () => {
        if (message.value === '' || message.value === lastPrefill) {
          lastPrefill = `'${link.dataset.inquiryService}' 문의드려요.\n`;
          message.value = lastPrefill;
        }
        requestAnimationFrame(() => {
          document.getElementById('member_inquiry_sender_name')?.focus({ preventScroll: true });
        });
      });
    });
  })();

  (() => {
    const bar = document.querySelector('.public-sticky');
    const contact = document.getElementById('contact');
    if (!bar || !contact || !('IntersectionObserver' in window)) return;
    // 문의 칸이 화면 아래 1/4 선 위로 올라오면 띠를 치우고, 벗어나면 다시 보여 준다.
    new IntersectionObserver(([entry]) => {
      bar.classList.toggle('is-away', entry.isIntersecting);
    }, { rootMargin: '0px 0px -25% 0px' }).observe(contact);
  })();
</script>
