<% faqs = local_assigns.fetch(:faqs, []) %>
<% reviews = local_assigns.fetch(:reviews, []) %>
<% portfolio = local_assigns.fetch(:portfolio, []) %>
<% content_for :title, "#{public_share_title(member)} | imPD" %>
<% content_for :description, public_share_description(member, services, 160) %>

<%
  grid_photos = moments.to_a.select { |photo| photo.image.attached? }.first(6)
  grid_services = services.to_a.first(6)
  grid_cases = portfolio.lazy.filter_map do |item|
    media = portfolio_media(item)
    next unless media[:link_url]

    [item, media[:link_url], media[:link_host]]
  end.first(3)
  social_entries = case (social = member.social)
  when Hash
    social.filter_map do |label, value|
      url = value.is_a?(Hash) ? (value["url"] || value[:url]) : value
      { label: label.to_s.humanize, url: url.to_s } if url.to_s.present?
    end
  when Array
    social.filter_map do |entry|
      next unless entry.is_a?(Hash)
      url = entry["url"] || entry[:url]
      label = entry["label"] || entry[:label] || entry["platform"] || entry[:platform] || "외부 링크"
      { label: label.to_s, url: url.to_s } if url.to_s.present?
    end
  else
    []
  end
  grid_qr_url = "/qr/#{member.slug}.svg"
%>

<style>
  .impd-grid-page { max-width: 1200px; margin: 0 auto; padding: 40px; font-family: var(--impd-font-sans); }
  .impd-bento { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); grid-auto-flow: dense; gap: 16px; }
  .impd-bento-tile { min-width: 0; overflow: hidden; background: var(--impd-card); border: 1px solid var(--impd-rule); border-radius: 12px; box-shadow: var(--impd-shadow-card); padding: 24px; }
  .impd-bento-profile { grid-column: span 2; display: flex; flex-direction: column; }
  .impd-bento-photo { min-height: 260px; padding: 0; position: relative; }
  .impd-bento-photo img, .impd-bento-photo video { width: 100%; height: 100%; min-height: 260px; object-fit: cover; display: block; }
  .impd-bento-photo figcaption { position: absolute; inset: auto 0 0; padding: 28px 16px 14px; color: var(--impd-on-dark); background: linear-gradient(transparent, var(--impd-ink)); }
  .impd-bento-heading { font-family: var(--impd-font-display); font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; }
  .impd-bento-case { word-break: keep-all; overflow-wrap: anywhere; }
  .impd-bento-faq details { border-top: 1px solid var(--impd-rule); }
  .impd-bento-faq details:first-of-type { margin-top: 12px; }
  .impd-bento-faq summary { min-height: 44px; display: flex; align-items: center; gap: 8px; padding: 8px 0; font-weight: 600; cursor: pointer; }
  .impd-bento-faq details p { margin: 0 0 12px; color: var(--impd-ink2); line-height: 1.7; white-space: pre-line; }
  .impd-bento-career, .impd-bento-review, .impd-bento-faq { word-break: keep-all; overflow-wrap: anywhere; }
  .impd-bento-link { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-top: 1px solid var(--impd-rule); color: var(--impd-ink); text-decoration: none; overflow-wrap: anywhere; }
  @media (max-width: 620px) {
    .impd-grid-page { padding: 20px; }
    .impd-bento { grid-template-columns: 1fr; }
    .impd-bento-profile { grid-column: span 1; }
  }
</style>

<%= render "public_profile/profile_intro", member: member, services: services, moments: moments, show_offer: grid_photos.any? %>
<main class="impd-grid-page">
  <div class="impd-bento">
    <% grid_photos.each do |photo| %>
      <figure class="impd-bento-tile impd-bento-photo">
        <a href="/p/<%= member.slug %>/<%= photo.id %>" style="display: block; height: 100%; color: var(--impd-on-dark); text-decoration: none;">
          <% if photo.video? %>
            <video src="<%= photo.display_url %>" controls preload="metadata"></video>
          <% else %>
            <img loading="lazy" decoding="async" src="<%= photo.thumbnail_url %>"
                 data-fallback="<%= photo.display_url %>"
                 onerror="if(this.dataset.fallback && this.src !== this.dataset.fallback){this.src=this.dataset.fallback;this.dataset.fallback='';}"
                 alt="<%= photo.caption.presence || member.name %> 사진"
                 loading="lazy">
          <% end %>
          <% if photo.caption.present? %><figcaption><%= photo.caption %></figcaption><% end %>
        </a>
      </figure>
    <% end %>

    <% grid_services.each_with_index do |service, index| %>
      <article class="impd-bento-tile"<%= ' id="classes"'.html_safe if index.zero? %> style="min-height: 220px; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <span class="impd-label">서비스</span>
          <h2 class="impd-bento-heading" style="font-size: 26px; margin-top: 12px;"><%= service.title %></h2>
          <% if service.description.present? %>
            <p style="margin-top: 12px; color: var(--impd-ink2); line-height: 1.6; white-space: pre-line; overflow-wrap: anywhere; word-break: keep-all;"><%= truncate(service.description, length: 160, separator: " ") %></p>
            <% if service.description.length > 160 %>
              <details class="public-service-more">
                <summary>설명 끝까지 보기</summary>
                <p><%= service.description %></p>
              </details>
            <% end %>
          <% end %>
        </div>
        <div>
          <p style="margin-top: 18px; font-family: var(--impd-font-sans); font-weight: 600; color: var(--impd-accent);"><%= service_price_text(service) %></p>
          <%= render "public_profile/service_action", service: service %>
        </div>
      </article>
    <% end %>

    <% grid_cases.each do |item, link_url, host| %>
      <a class="impd-bento-tile impd-bento-case" href="<%= link_url %>" target="_blank" rel="noopener" style="min-height: 160px; display: flex; flex-direction: column; justify-content: space-between; color: var(--impd-ink); text-decoration: none;">
        <div>
          <span class="impd-label"><%= item.category.presence || "작업 사례" %></span>
          <h2 class="impd-bento-heading" style="font-size: 22px; margin-top: 12px; word-break: keep-all; overflow-wrap: anywhere;"><%= item.title %></h2>
        </div>
        <p style="margin-top: 16px; min-height: 44px; display: flex; align-items: center; color: var(--impd-accent); font-weight: 600; overflow-wrap: anywhere;"><%= [host, "보러 가기 ↗"].compact.join(" ") %></p>
      </a>
    <% end %>

    <% if member.career_note.present? && member.profession != "insurance_agent" %>
      <section class="impd-bento-tile impd-bento-career">
        <span class="impd-label">경력 · 이력</span>
        <p style="margin-top: 12px; color: var(--impd-ink2); line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere;"><%= member.career_note %></p>
      </section>
    <% end %>

    <% review = reviews.find { |r| r.content.present? } %>
    <% if review %>
      <figure class="impd-bento-tile impd-bento-review" style="margin: 0;">
        <span class="impd-label">후기</span>
        <blockquote style="margin: 12px 0 0; line-height: 1.7; overflow-wrap: anywhere;">"<%= review.content %>"</blockquote>
        <figcaption style="margin-top: 12px; font-size: 14px; color: var(--impd-ink2);">— <%= review.reviewer_name %><% if review.rating.to_i.positive? %> · <% review.rating.to_i.times do %><%= lni_icon "star-fat" %><% end %><% end %></figcaption>
      </figure>
    <% end %>

    <% if faqs.any? %>
      <section class="impd-bento-tile impd-bento-faq">
        <span class="impd-label">자주 묻는 질문</span>
        <% faqs.first(5).each do |faq| %>
          <details>
            <summary><%= faq.question %></summary>
            <p><%= faq.answer %></p>
          </details>
        <% end %>
      </section>
    <% end %>

    <% if social_entries.any? %>
      <section class="impd-bento-tile">
        <span class="impd-label">링크</span>
        <h2 class="impd-bento-heading" style="font-size: 26px; margin: 12px 0 18px;">더 알아보기</h2>
        <% social_entries.each do |entry| %>
          <a class="impd-bento-link" href="<%= entry[:url] %>" target="_blank" rel="noopener"><span><%= entry[:label] %></span><%= lni_icon "arrow-angular-top-right" %></a>
        <% end %>
      </section>
    <% end %>


  </div>
</main>
<%= render "public_profile/profile_contact", member: member, services: services %>
