<!DOCTYPE html>
<html lang="ko">
  <head>
    <%= stylesheet_link_tag "lineicons", "data-turbo-track": "reload" %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for?(:title) ? yield(:title) + " | imPD admin" : "imPD admin" %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@700;800&family=Noto+Serif+KR:wght@400;500;700&family=JetBrains+Mono:wght@400;500;600&family=Caveat:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css" />
    <style>
      :root {
        --impd-paper: #efece4; --impd-card: #fbf8f1; --impd-ink: #0f0d0b;
        --impd-ink2: rgba(15,13,11,0.85); --impd-muted: #5c5a55;
        --impd-soft-muted: rgba(15,13,11,0.35); --impd-rule: rgba(15,13,11,0.15);
        --impd-accent: #00754A; --impd-accent-2: #CBA258;
        --impd-font-display: "Inter Tight","Pretendard Variable","Pretendard",system-ui,sans-serif;
        --impd-font-sans: "Pretendard Variable","Pretendard",system-ui,sans-serif;
        --impd-font-serif: "Noto Serif KR",serif; --impd-font-mono: "JetBrains Mono",ui-monospace,monospace;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body.impd-admin { display: block; width: 100%; background: var(--impd-paper); color: var(--impd-ink); font-family: var(--impd-font-sans); -webkit-font-smoothing: antialiased; }
      a { color: inherit; text-decoration: none; }
      .impd-admin .impd-label, .impd-admin .impd-label-muted {
        font-family: var(--impd-font-sans);
        font-size: 13px;
        letter-spacing: 0;
        text-transform: none;
        color: var(--impd-muted);
      }
      .impd-admin .impd-label { font-weight: 600; color: var(--impd-accent); }
      .impd-admin > main { display: block; width: 100%; min-width: 0; }
      .impd-admin .admin-page {
        width: 100%;
        max-width: var(--admin-page-max-width, 1400px);
        margin-inline: auto;
        padding: 40px;
        overflow-wrap: anywhere;
      }
      @media (max-width: 768px) {
        .impd-admin .admin-page { padding: 20px 16px; }
      }
      .impd-display { font-family: var(--impd-font-display); font-weight: 800; letter-spacing: -0.03em; word-spacing: 0.14em; line-height: 1.05; }
      .impd-section-header { display: flex; align-items: baseline; gap: 16px; border-top: 1px solid var(--impd-ink); padding-top: 14px; margin-bottom: 24px; }
      .impd-btn { display: inline-flex; align-items: center; gap: 8px; padding: 0 18px; height: 44px; font-family: var(--impd-font-sans); font-size: 14px; font-weight: 600; letter-spacing: -0.2px; cursor: pointer; border: none; border-radius: 0; }
      .impd-btn-primary { background: var(--impd-ink); color: var(--impd-paper); }
      .impd-btn-primary:hover { background: var(--impd-accent); }
      .impd-btn-accent { background: var(--impd-accent); color: white; }
      .impd-btn-secondary { background: transparent; color: var(--impd-ink); border: 1px solid var(--impd-ink); }
      .impd-btn-danger { background: transparent; color: var(--impd-accent-2); border: 1px solid var(--impd-accent-2); }
      .impd-btn-sm { height: 44px; padding: 0 12px; font-size: 13px; white-space: nowrap; }
      .impd-btn-quiet { background: transparent; color: var(--impd-ink2); border: 0; text-decoration: underline; text-underline-offset: 3px; padding: 0 8px; }
      .impd-btn-quiet:hover { color: var(--impd-ink); }
      .impd-item-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 14px; padding-top: 6px; border-top: 1px solid var(--impd-rule); }
      .impd-item-actions details[open] { flex: 1 1 100%; min-width: 0; }
      .impd-item-actions summary { cursor: pointer; display: inline-flex; align-items: center; gap: 6px; height: 44px; padding: 0 16px; border: 1px solid var(--impd-ink); color: var(--impd-ink); font-size: 13px; font-weight: 600; white-space: nowrap; list-style: none; }
      .impd-item-actions summary::-webkit-details-marker { display: none; }
      .impd-item-actions summary::after { content: "▾"; font-size: 11px; }
      .impd-item-actions details[open] > summary { width: fit-content; background: var(--impd-ink); color: var(--impd-paper); }
      .impd-item-actions details[open] > summary::after { content: "▴"; }
      .impd-item-actions .impd-item-delete { margin-left: auto; }
      .is-just-saved { border-color: var(--impd-accent) !important; box-shadow: inset 4px 0 0 var(--impd-accent); scroll-margin-top: 96px; }
      .impd-just-saved-tag { background: var(--impd-accent); color: var(--impd-card); padding: 3px 7px; font-size: 12px; font-weight: 700; white-space: nowrap; }
      .impd-card { background: var(--impd-card); border: 1px solid var(--impd-rule); padding: 24px; }
      .impd-field { margin-top: 16px; }
      .impd-field:first-child { margin-top: 0; }
      .impd-field > label, .impd-field-label { display: block; margin-bottom: 6px; color: var(--impd-ink2); font-size: 14px; font-weight: 600; }
      .impd-input { display: block; width: 100%; min-height: 48px; border: 1px solid var(--impd-rule); border-radius: 0; background: #fff; padding: 11px 12px; color: var(--impd-ink); font-family: var(--impd-font-sans); font-size: 16px; line-height: 1.5; }
      textarea.impd-input { resize: vertical; }
      .impd-input::placeholder { color: var(--impd-muted); opacity: .75; }
      .impd-input:focus { outline: 2px solid var(--impd-accent); outline-offset: 1px; border-color: var(--impd-accent); }
      .impd-field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; align-items: start; }
      .impd-field-row > .impd-field { min-width: 0; margin-top: 0; }
      .impd-field-help { margin-top: 6px; font-size: 13px; color: var(--impd-muted); line-height: 1.5; }
      .impd-check { display: flex; align-items: center; gap: 10px; min-height: 44px; margin-top: 8px; font-size: 14px; color: var(--impd-ink2); cursor: pointer; }
      .impd-check input[type="checkbox"] { width: 20px; height: 20px; flex-shrink: 0; accent-color: var(--impd-accent); }
      .impd-jump-new { display: none; }
      @media (max-width: 820px) {
        .impd-jump-new { display: flex; width: 100%; justify-content: center; margin-top: 16px; height: 48px; }
      }
      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    </style>
    <%= render "shared/feedback_styles" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="impd-admin">
    <a class="skip-link" href="#main-content">본문 바로가기</a>
    <style>
      .checklist-arrival { position: sticky; top: 0; z-index: 10; margin-bottom: 16px; padding: 8px 12px; border-inline-start: 3px solid var(--impd-accent); background: var(--impd-card); font-size: 13px; }
      .checklist-arrival a { color: var(--impd-accent); }
      .checklist-target { scroll-margin-top: 88px; }
      .checklist-target:target { animation: checklist-highlight 2s ease-out; }
      @keyframes checklist-highlight {
        0%, 40% { outline: 2px solid var(--impd-accent); outline-offset: 3px; }
        100% { outline: 2px solid transparent; outline-offset: 3px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .checklist-target:target { animation: none; outline: 2px solid var(--impd-accent); }
      }
      .admin-header { width: 100%; position: sticky; top: 0; z-index: 20; }
      .impd-admin:has(.checklist-arrival) .admin-header { position: relative; }
      .admin-impersonation-banner { padding: 10px 18px; background: var(--impd-ink); color: var(--impd-paper); font-size: 13px; line-height: 1.5; overflow-wrap: anywhere; }
      .admin-impersonation-banner a { display: inline-block; font-weight: 700; text-decoration: underline; }
      .admin-nav { background: var(--impd-paper); border-bottom: 1px solid var(--impd-rule); }
      .admin-nav-bar { padding: 14px 40px; display: flex; align-items: center; gap: 24px; }
      .admin-nav-links { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 22px; flex: 1; min-width: 0; }
      .admin-nav-link { display: flex; align-items: center; min-height: 44px; font-size: 13px; color: var(--impd-muted); padding: 8px 0; border-bottom: 2px solid transparent; }
      .admin-nav-link[aria-current="page"] { color: var(--impd-accent); border-bottom-color: var(--impd-accent); font-weight: 700; }
      .admin-subnav { max-width: 100%; display: flex; gap: 22px; padding: 0 40px; border-top: 1px solid var(--impd-rule); overflow-x: auto; white-space: nowrap; }
      .admin-subnav .admin-nav-link { flex: none; }
      .admin-identity { display: flex; flex-direction: column; align-items: flex-end; min-width: 0; font-size: 13px; overflow-wrap: anywhere; }
      .admin-email { max-width: 100%; font-size: 13px; color: var(--impd-muted); }
      .admin-menu-button, .admin-mobile-panel { display: none; }
      @media (max-width: 767px) {
        .admin-nav-bar { padding: 12px 18px; gap: 12px; }
        .admin-nav-links, .admin-email, .admin-logout { display: none; }
        .admin-identity { margin-left: auto; }
        .admin-menu-button { display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; border: 0; background: transparent; padding: 8px; font-size: 22px; }
        .admin-subnav { padding: 0 18px; }
        .admin-mobile-panel:not([hidden]) { display: block; padding: 0 18px 16px; max-height: 60dvh; overflow-y: auto; }
        .admin-mobile-panel h2 { margin-top: 12px; font-size: 13px; color: var(--impd-muted); }
        .admin-mobile-panel .admin-nav-link { min-height: 44px; display: flex; align-items: center; gap: 6px; }
      }
    </style>
    <% if @member %>
      <% slug = @member.slug
         nav_groups = {
           "대시보드" => [
             ["대시보드", slug_admin_dashboard_path(slug:), %w[dashboard]]
           ],
           "내 페이지" => [
             ["에디터", slug_admin_editor_path(slug:), %w[editor photos documents]],
             ["서비스", slug_admin_services_path(slug:), %w[services]],
             ["자주 묻는 질문", slug_admin_faqs_path(slug:), %w[faqs]],
             ["소식", slug_admin_posts_path(slug:), %w[posts]]
           ],
           "고객" => [
             ["문의함", slug_admin_inquiries_path(slug:), %w[inquiries]],
             ["후기", slug_admin_reviews_path(slug:), %w[reviews]],
             ["예약 링크", slug_admin_bookings_path(slug:), %w[bookings]]
           ],
           "홍보" => [
             ["내 브랜드", slug_admin_brand_path(slug:), %w[brands brand_channels]],
             ["노출·광고 동의", slug_admin_brand_consents_path(slug:), %w[brand_consents]]
           ]
         }
         active_item = nav_groups.values.flatten(1).find do |_, _, controllers|
           controllers.any? { |controller| controller_path == "member_admin/#{controller}" }
         end
         active_group = nav_groups.find { |_, items| items.include?(active_item) }&.first
         active_group = "홍보" if %w[member_admin/sns_accounts member_admin/sns_scheduled_posts member_admin/facebook_connections].include?(controller_path) %>
    <% end %>
    <% acting_user = impersonating_admin_user %>
    <header class="admin-header">
      <% if acting_user %>
        <div class="admin-impersonation-banner">
          <%= acting_user.admin? ? "운영자" : "PD" %> 권한으로 <%= @member.name %>님(/<%= @member.slug %>) 관리 화면을 보고 있습니다. 여기서 바꾼 내용은 회원 페이지에 바로 반영됩니다.
          <% if acting_user.admin? %>
            <%= link_to "운영자 화면으로 돌아가기", admin_member_path(@member) %>
          <% else %>
            <%= link_to "PD 대시보드로 돌아가기", pd_root_path %>
          <% end %>
        </div>
      <% end %>
      <nav class="admin-nav" data-controller="impd-nav" aria-label="회원 관리 메뉴">
        <div class="admin-nav-bar">
          <%= link_to "imPD.", (@member ? slug_admin_dashboard_path(slug: @member.slug) : root_path), style: "display: flex; align-items: center; min-height: 44px; font-family: var(--impd-font-display); font-weight: 800; font-size: 20px;" %>
          <% if @member %>
            <div class="admin-nav-links">
              <% nav_groups.each do |label, items| %>
                <%= link_to label, items.first[1], class: "admin-nav-link", aria: { current: ("page" if label == active_group) } %>
              <% end %>
              <%= link_to "/#{@member.slug}", target: "_blank", rel: "noopener", class: "admin-nav-link" do %>내 페이지 보기 <%= lni_icon "arrow-angular-top-right" %><% end %>
            </div>
            <div class="admin-identity">
              <span><%= @member.name %>님</span>
              <% if acting_user %>
                <span class="impd-label">대리 접속</span>
              <% else %>
                <span class="admin-email"><%= @member.email %></span>
              <% end %>
            </div>
            <% unless acting_user %>
              <div class="admin-logout"><%= button_to "로그아웃", logout_member_path(slug: @member.slug), method: :delete, class: "impd-btn impd-btn-secondary impd-btn-sm" %></div>
            <% end %>
            <button type="button" class="admin-menu-button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="admin-mobile-menu" data-impd-nav-target="button" data-action="impd-nav#toggle">
              <span data-impd-nav-target="menuIcon"><%= lni_icon "menu-hamburger-1" %></span><span data-impd-nav-target="closeIcon" hidden><%= lni_icon "xmark" %></span>
            </button>
          <% end %>
        </div>
        <% if @member %>
          <% if active_group && active_group != "대시보드" %>
            <div class="admin-subnav" role="group" aria-label="<%= active_group %> 메뉴">
              <% nav_groups.fetch(active_group).each do |item| %>
                <% label, path = item %>
                <%= link_to label, path, class: "admin-nav-link", aria: { current: ("page" if item == active_item) } %>
              <% end %>
            </div>
          <% end %>
          <div id="admin-mobile-menu" class="admin-mobile-panel" data-impd-nav-target="panel" data-action="click->impd-nav#closeOnLink" hidden>
            <% nav_groups.each do |heading, items| %>
              <h2><%= heading %></h2>
              <% items.each do |item| %>
                <% label, path = item %>
                <%= link_to label, path, class: "admin-nav-link", aria: { current: ("page" if item == active_item) } %>
              <% end %>
            <% end %>
            <%= link_to "/#{@member.slug}", target: "_blank", rel: "noopener", class: "admin-nav-link" do %>내 페이지 보기 <%= lni_icon "arrow-angular-top-right" %><% end %>
            <% unless acting_user %>
              <%= button_to "로그아웃", logout_member_path(slug: @member.slug), method: :delete, class: "impd-btn impd-btn-secondary" %>
            <% end %>
          </div>
        <% end %>
      </nav>
    </header>

    <%= render "shared/flash" %>

    <main id="main-content" tabindex="-1"><%= yield %></main>
    <script>
      (() => {
        if (window.impdSavedItemScrollInstalled) return;
        window.impdSavedItemScrollInstalled = true;

        const scrolledCards = new WeakSet();

        function scrollToSavedItem() {
          const card = document.querySelector(".is-just-saved");
          if (!card || scrolledCards.has(card)) return;

          const { top, bottom } = card.getBoundingClientRect();
          const headerBottom = document.querySelector(".admin-header")?.getBoundingClientRect().bottom ?? 0;
          if (bottom > Math.max(0, headerBottom) && top < window.innerHeight) return;

          const behavior = window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
          scrolledCards.add(card);
          card.scrollIntoView({ block: "center", behavior });
        }

        document.addEventListener("DOMContentLoaded", scrollToSavedItem, { once: true });
        document.addEventListener("turbo:load", scrollToSavedItem);
        document.addEventListener("turbo:before-cache", () => {
          const card = document.querySelector(".is-just-saved");
          card?.classList.remove("is-just-saved");
          card?.querySelector(".impd-just-saved-tag")?.remove();
        });
      })();
    </script>
  </body>
</html>
