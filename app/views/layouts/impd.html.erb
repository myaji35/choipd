<!DOCTYPE html>
<html lang="ko">
  <head>
    <%= stylesheet_link_tag "lineicons", "data-turbo-track": "reload" %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <% page_title = content_for?(:title) ? yield(:title).to_s : "imPD — 1인 사업자·크리에이터의 홍보 페이지" %>
    <title><%= page_title.include?("imPD") ? page_title : "#{page_title} | imPD" %></title>
    <% og_title = content_for?(:og_title) ? yield(:og_title) : page_title %>
    <% og_description = content_for?(:og_description) ? yield(:og_description) : (content_for?(:description) ? yield(:description) : '사진과 수료증만 올리면 자동으로 홍보 페이지가 완성됩니다.') %>
    <meta property="og:title" content="<%= og_title %>">
    <meta property="og:description" content="<%= og_description %>">
    <meta property="og:url" content="<%= public_base_url %><%= request.path %>">
    <%= render "shared/og_image", og_title: og_title %>
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : '사진과 수료증만 올리면 자동으로 홍보 페이지가 완성됩니다.' %>">

    <!-- imPD 디자인 시스템 폰트 — C2 Starbucks-inspired retail tone -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter+Tight:wght@700;800&family=Lora:ital@1&family=Noto+Serif+KR:wght@400;500;700&family=JetBrains+Mono:wght@400;500;600&family=Caveat:wght@400;500;700&family=Nanum+Pen+Script&family=Gaegu:wght@400;700&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css" />

    <style>
      :root {
        /* C2 palette (Starbucks-inspired warm retail) */
        --impd-size-display: clamp(48px, 8vw, 96px); --impd-size-h2: clamp(26px, 4vw, 36px); --impd-size-h3: 20px; --impd-size-body: 16px; --impd-size-small: 13px;
        --impd-paper: #f2f0eb;         /* Neutral Warm canvas */
        --impd-ceramic: #edebe9;       /* section separator */
        --impd-card: #ffffff;          /* card/white surface */
        --impd-gold-light: #faf6ee;

        --impd-ink: rgba(0,0,0,0.87);
        --impd-ink2: rgba(0,0,0,0.75);
        --impd-muted: rgba(0,0,0,0.58);
        --impd-soft-muted: rgba(0,0,0,0.38);
        --impd-rule: rgba(0,0,0,0.10);

        /* 4-tier green — Starbucks system */
        --impd-green: #006241;         /* headline / brand */
        --impd-green-accent: #00754A;  /* primary CTA */
        --impd-green-house: #1E3932;   /* dark feature band / footer */
        --impd-green-uplift: #2b5148;  /* secondary dark */
        --impd-green-mint: #d4e9e2;    /* pale wash */

        /* Gold reserved for ceremony (credentials, ratings, pro plan) */
        --impd-gold: #cba258;
        --impd-gold-soft: #dfc49d;

        /* 하위 호환: 기존 accent 이름을 C2 Green Accent로 재매핑 (부품 교체 최소화) */
        --impd-accent: #00754A;
        --impd-accent-2: #cba258;      /* was orange, now gold */

        --impd-on-dark: #ffffff;
        --impd-on-dark-soft: rgba(255,255,255,0.70);

        /* Fonts — Manrope = SoDoSans substitute, Lora italic ceremony */
        --impd-font-display: "Manrope", "Pretendard Variable", "Pretendard", system-ui, sans-serif;
        --impd-font-sans: "Manrope", "Pretendard Variable", "Pretendard", system-ui, sans-serif;
        --impd-font-serif: "Lora", "Noto Serif KR", serif;
        --impd-font-mono: "JetBrains Mono", ui-monospace, monospace;

        /* C2 shadows — whisper-soft */
        --impd-shadow-card: 0 0 0.5px rgba(0,0,0,0.14), 0 1px 1px rgba(0,0,0,0.24);
        --impd-shadow-nav: 0 1px 3px rgba(0,0,0,0.10), 0 2px 2px rgba(0,0,0,0.06), 0 0 2px rgba(0,0,0,0.07);
        --impd-shadow-frap: 0 0 6px rgba(0,0,0,0.24), 0 8px 12px rgba(0,0,0,0.14);
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        font-size: var(--impd-size-body); line-height: 1.7;
        word-break: keep-all;
        overflow-wrap: anywhere;
        background: var(--impd-paper);
        color: var(--impd-ink);
        font-family: var(--impd-font-sans);
        font-feature-settings: "ss01" on, "ss02" on;
        letter-spacing: -0.01em;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      a { color: inherit; text-decoration: none; }

      .impd-section-title { font-size: var(--impd-size-h2); font-weight: 800; }
      .impd-subtitle { font-size: var(--impd-size-h3); font-weight: 700; }
      .impd-small { font-size: var(--impd-size-small); }
      /* 핵심 클래스 */
      .impd-label { font-family: var(--impd-font-sans); font-size: 13px; font-weight: 600; letter-spacing: 0.02em; text-transform: none; color: var(--impd-green); }
      .impd-label-muted { font-family: var(--impd-font-sans); font-size: 12px; font-weight: 500; letter-spacing: 0.02em; text-transform: none; color: rgba(0,0,0,0.60); }
      .impd-display { font-family: var(--impd-font-display); font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; }
      .impd-hero { font-family: var(--impd-font-display); font-weight: 800; font-size: clamp(56px, 11vw, 128px); letter-spacing: -0.03em; line-height: 0.9; color: var(--impd-green); }
      .impd-serif { font-family: var(--impd-font-serif); font-style: italic; color: var(--impd-green); }
      .impd-section-header { display: flex; align-items: baseline; gap: 16px; border-top: 1px solid var(--impd-rule); padding-top: 14px; margin-bottom: 24px; }
      .impd-stat-num { font-size: 36px; flex: 1; }
      .impd-accent-text { color: var(--impd-accent); }
      .impd-field-spacing { margin-bottom: 8px; }
      .impd-profile-value { font-family: var(--impd-font-display); font-size: 20px; margin-top: 4px; }
      .impd-quick-panel { margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--impd-rule); }
      .impd-quick-label { margin-bottom: 6px; font-size: 12px; }
      .impd-media-cover { width: 100%; height: 100%; object-fit: cover; display: block; }
      .impd-video-cover { width: 100%; height: 100%; object-fit: cover; display: block; background: #000; }
      .impd-panel-paper { background: var(--impd-paper); padding: 28px 24px; }
      .impd-row-icon { margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
      .impd-kpi-value { font-size: 30px; line-height: 1; color: var(--impd-ink); }
      .impd-kpi-meta { margin-top: 8px; font-family: var(--impd-font-mono); font-size: 12px; color: var(--impd-ink2); }
      .impd-card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
      .impd-centered { text-align: center; }
      .impd-quote { font-size: clamp(28px, 4vw, 40px); line-height: 1.4; margin-top: 24px; max-width: 800px; margin-left: auto; margin-right: auto; }
      .impd-quote-source { color: rgba(239,236,228,.55); margin-top: 24px; }
      .impd-live-badge { display: inline-flex; align-items: center; gap: 6px; font-family: var(--impd-font-mono); font-size: 12px; letter-spacing: 1.4px; text-transform: uppercase; color: #fff; background: #16a34a; padding: 4px 10px; border-radius: 3px; }
      .impd-live-dot { width: 7px; height: 7px; background: #fff; border-radius: 50%; display: inline-block; animation: impd-pulse 1.8s ease-in-out infinite; }
      .impd-section-note { margin-top: 14px; font-size: 12px; color: var(--impd-muted); font-family: var(--impd-font-mono); text-align: right; }
      .impd-status-value { font-size: 22px; margin-top: 4px; }
      .impd-contact-stack { display: flex; flex-direction: column; gap: 8px; }
      .impd-contact-label { font-family: var(--impd-font-mono); font-size: 12px; letter-spacing: 1.3px; opacity: 0.65; }
      .impd-contact-value { font-weight: 600; }

      /* C2 full-pill button geometry — radius 50px, scale(0.95) active signature */
      .impd-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        padding: 0 22px; height: 44px; min-width: 120px;
        font-family: var(--impd-font-sans); font-size: 14px; font-weight: 600; letter-spacing: -0.01em;
        cursor: pointer; border: 1px solid transparent; border-radius: 50px;
        transition: transform .2s ease, background .2s ease, color .2s ease, box-shadow .2s ease;
      }
      .impd-btn:active { transform: scale(0.95); }
      .impd-btn-primary { background: var(--impd-green-accent); color: var(--impd-on-dark); border-color: var(--impd-green-accent); }
      .impd-btn-primary:hover { background: var(--impd-green); border-color: var(--impd-green); }
      .impd-btn-secondary { background: transparent; color: var(--impd-ink); border: 1px solid var(--impd-ink); }
      .impd-btn-secondary:hover { background: var(--impd-ink); color: var(--impd-paper); }
      .impd-btn-accent { background: var(--impd-green-accent); color: var(--impd-on-dark); border-color: var(--impd-green-accent); }
      .impd-btn-accent:hover { background: var(--impd-green); border-color: var(--impd-green); }
      .impd-btn-outlined { background: transparent; color: var(--impd-green-accent); border: 1.5px solid var(--impd-green-accent); }
      .impd-btn-outlined:hover { background: var(--impd-green-accent); color: var(--impd-on-dark); }
      .impd-btn-dark { background: #000; color: var(--impd-on-dark); border-color: #000; }
      .impd-btn-lg { height: 48px; padding: 0 26px; font-size: 16px; }
      .impd-btn-sm { height: 32px; padding: 0 14px; font-size: 13px; min-width: 80px; }

      /* C2 card — whisper-soft shadow, 12px radius */
      .impd-c2-card { background: var(--impd-card); border-radius: 12px; box-shadow: var(--impd-shadow-card); padding: 20px; }
      .impd-c2-band { background: var(--impd-green-house); color: var(--impd-on-dark); padding: 72px 40px; }
      .impd-c2-band .impd-label { color: #dfc49d; }
      .impd-c2-band .impd-display, .impd-c2-band h2, .impd-c2-band h3 { color: var(--impd-on-dark); }

      /* C2 Frap — floating CTA */
      .impd-frap {
        position: fixed; bottom: 24px; right: 24px; z-index: 50;
        height: 52px; padding: 0 20px 0 16px; border-radius: 999px;
        gap: 8px; font-size: 15px; font-weight: 700; text-decoration: none;
        background: var(--impd-green-accent); color: var(--impd-on-dark);
        border: none; cursor: pointer;
        box-shadow: var(--impd-shadow-frap);
        display: flex; align-items: center; justify-content: center;
        transition: transform .2s ease, box-shadow .2s ease;
      }
      .impd-frap:hover { background: var(--impd-green); }
      .impd-frap:active { transform: scale(0.95); box-shadow: 0 0 6px rgba(0,0,0,0.24); }

      .impd-main-with-frap { padding-bottom: 88px; }
      @media (max-width: 599px) {
        .impd-frap { left: 16px; right: 16px; width: calc(100% - 32px); max-width: 360px; margin: 0 auto; }
      }

      /* C2 Reward/credential top bar — colored accent */
      .impd-credential-card { background: var(--impd-card); border-radius: 12px; box-shadow: var(--impd-shadow-card); padding: 24px 20px; position: relative; overflow: hidden; }
      .impd-credential-card::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--impd-gold); }
      .impd-credential-card.tier-green::before { background: var(--impd-green-accent); }
      .impd-credential-card.tier-house::before { background: var(--impd-green-house); }
      .impd-credential-card.tier-uplift::before { background: var(--impd-green-uplift); }

      /* C2 stripe / pattern */
      .impd-stripe { background-image: repeating-linear-gradient(135deg, rgba(255,255,255,0.08) 0 3px, transparent 3px 10px); }

      @keyframes c1FadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
      @keyframes c1Pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
      .impd-fade-in { animation: c1FadeIn 700ms ease-out both; }
      .impd-pulse { animation: c1Pulse 2s infinite; }

      @media (prefers-reduced-motion: reduce) {
        .impd-fade-in, .impd-pulse { animation: none !important; }
        .impd-btn, .impd-frap { transition: none !important; }
      }
    </style>

    <% if defined?(@member) && @member.respond_to?(:theme_preset) && (tp = ThemePreset.find(@member.theme_preset)) %>
      <style>
        :root {
          --impd-accent: <%= tp[:accent] %>;
          --impd-ink: <%= tp[:ink] %>;
          --impd-paper: <%= tp[:paper] %>;
        }
      </style>
    <% end %>

    <%= render "shared/feedback_styles" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>
    <%# 공개 프로필/명함 등에서 OG 메타 주입 가능 %>
    <%= yield(:head) if content_for?(:head) %>
  </head>
  <body>
    <a class="skip-link" href="#main-content"><%= lni_icon "arrow-right" %>본문 바로가기</a>
    <!-- C2 Join Strip — 최상단 검정 bar (비로그인에만) -->
    <% unless member_signed_in? || %w[public_profile public_photos member_reviews].include?(controller_path) %>
      <div class="impd-joinstrip" style="background: #000; color: #fff; padding: 10px 24px; display: flex; align-items: center; gap: 14px; font-size: 13px; letter-spacing: -0.01em;">
        <span style="opacity: 0.9;">지금 가입하면 첫 페이지 제작 무료 · 수수료 없이 3개월</span>
        <span style="flex: 1;"></span>
        <%= link_to member_signup_path, style: "color: #fff; text-decoration: underline; font-weight: 600; white-space: nowrap;" do %>자세히 보기 <%= lni_icon "arrow-right" %><% end %>
      </div>
    <% end %>

    <!-- imPD TopNav — C2 whisper-soft shadow -->
    <% nav_links = [["홈", root_path, request.path == "/"], ["둘러보기", explore_path, request.path.start_with?("/explore")], ["예시", example_profile_path, false], ["가격", root_path(anchor: "pricing"), false], ["도움말", root_path(anchor: "faq"), false]] %>
    <% visitor_page = %w[public_profile public_photos member_reviews].include?(controller_path) && @member.present? && !member_signed_in? %>
    <style>
      .impd-topnav { position: sticky; top: 0; z-index: 20; background: var(--impd-card); box-shadow: var(--impd-shadow-nav); }
      .impd-topnav-bar { padding: 18px 24px; display: flex; align-items: center; gap: 20px; }
      .impd-topnav-links { display: flex; gap: 22px; flex: 1; }
      .impd-nav-link { color: var(--impd-ink2); font-size: 14px; font-weight: 500; white-space: nowrap; }
      .impd-nav-link[aria-current="page"] { color: var(--impd-green); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
      .impd-topnav-actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
      .impd-topnav-identity { display: inline-flex; flex-direction: column; align-items: flex-end; gap: 2px; white-space: nowrap; line-height: 1.2; }
      .impd-nav-toggle, .impd-mobile-panel { display: none; }
      .impd-topnav-visitor { display: flex; align-items: center; gap: 12px; margin-left: auto; min-width: 0; visibility: hidden; }
      .impd-topnav-visitor.is-on { visibility: visible; }
      .impd-topnav-visitor-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 15px; font-weight: 700; color: var(--impd-ink); }
      .impd-topnav-visitor-cta { flex: none; display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 16px; border-radius: 6px; background: var(--impd-accent); color: var(--impd-paper); font-size: 14px; font-weight: 700; text-decoration: none; white-space: nowrap; }
      @media (max-width: 768px) {
        .impd-topnav-bar { padding: 12px 16px; gap: 12px; }
        .impd-topnav-bar:has(> a:only-child) { min-height: 68px; }
        .impd-topnav-bar:has(> .impd-topnav-visitor) { min-height: 68px; }
        .impd-topnav-visitor-cta { display: none; }
        .impd-topnav-links, .impd-topnav-actions { display: none; }
        .impd-nav-toggle { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin-left: auto; border: 0; background: transparent; color: var(--impd-ink); cursor: pointer; }
        .impd-mobile-panel:not([hidden]) { display: block; padding: 0 16px 16px; }
        .impd-mobile-panel .impd-nav-link { display: flex; align-items: center; min-height: 48px; font-size: 16px; }
        .impd-mobile-actions { display: grid; gap: 8px; padding-top: 12px; }
        .impd-mobile-actions .impd-btn { width: 100%; min-height: 48px; font-size: 16px; }
      }
    </style>
    <div class="impd-topnav"<% unless visitor_page %> data-controller="impd-nav" data-action="keydown.esc@window->impd-nav#close"<% end %>>
      <div class="impd-topnav-bar">
        <%= link_to root_path, style: "font-family: var(--impd-font-display); font-weight: 800; font-size: 22px; letter-spacing: -0.02em; color: var(--impd-green); white-space: nowrap;" do %>
          imPD
        <% end %>
        <% if visitor_page && controller_path == "public_profile" && action_name == "show" %>
          <nav class="impd-topnav-visitor" aria-label="<%= @member.name %>님에게 연락">
            <span class="impd-topnav-visitor-name"><%= @member.name %></span>
            <a class="impd-topnav-visitor-cta" href="#contact" data-turbo="false">문의하기</a>
          </nav>
        <% end %>
        <% unless visitor_page %>
        <nav class="impd-topnav-links" aria-label="주요 메뉴">
          <% nav_links.each do |label, path, active| %>
            <%= link_to label, path, class: "impd-nav-link", aria: { current: ("page" if active) } %>
          <% end %>
        </nav>
        <% end %>
        <% if member_signed_in? %>
          <div class="impd-topnav-actions">
            <div class="impd-topnav-identity" title="<%= current_member.email %>">
              <span style="font-family: var(--impd-font-sans); font-size: 13px; color: var(--impd-muted);"><%= truncate(current_member.name.to_s, length: 12) %></span>
              <span style="font-family: var(--impd-font-sans); font-size: 10px; color: var(--impd-ink);"><%= truncate(current_member.email.to_s, length: 24) %></span>
            </div>
            <%= link_to "내 페이지", "/#{current_member.slug}", class: "impd-btn impd-btn-secondary", style: "height: 36px; padding: 0 14px; font-size: 13px; white-space: nowrap;" %>
            <%= button_to "로그아웃", member_logout_path, method: :delete, form: { data: { turbo_confirm: "로그아웃하시겠습니까?" }, style: "display: inline-flex; margin: 0;" }, class: "impd-btn impd-btn-secondary", style: "height: 36px; padding: 0 14px; font-size: 13px; white-space: nowrap;" %>
          </div>
        <% elsif !visitor_page %>
          <div class="impd-topnav-actions">
            <%= link_to "회원가입", member_signup_path, style: "font-size: 13px; color: var(--impd-muted); white-space: nowrap;" %>
            <%= link_to "로그인", member_login_path, class: "impd-btn impd-btn-secondary", style: "height: 36px; padding: 0 14px; font-size: 13px; white-space: nowrap;" %>
          </div>
        <% end %>
        <% unless visitor_page %>
        <button type="button" class="impd-nav-toggle" aria-label="메뉴 열기" aria-expanded="false" aria-controls="impd-mobile-menu" data-impd-nav-target="button" data-action="impd-nav#toggle">
          <span data-impd-nav-target="menuIcon"><%= lni_icon "menu-hamburger-1", size: 24 %></span>
          <span data-impd-nav-target="closeIcon" hidden><%= lni_icon "xmark", size: 24 %></span>
        </button>
        <% end %>
      </div>
      <% unless visitor_page %>
      <div id="impd-mobile-menu" class="impd-mobile-panel" data-impd-nav-target="panel" data-action="click->impd-nav#closeOnLink" hidden>
        <nav aria-label="모바일 주요 메뉴">
          <% nav_links.each do |label, path, active| %>
            <%= link_to label, path, class: "impd-nav-link", aria: { current: ("page" if active) } %>
          <% end %>
        </nav>
        <div class="impd-mobile-actions">
          <% if member_signed_in? %>
            <%= link_to "내 페이지 관리", "/#{current_member.slug}/admin/dashboard", class: "impd-btn impd-btn-primary" %>
            <%= button_to "로그아웃", member_logout_path, method: :delete, form: { data: { turbo_confirm: "로그아웃하시겠습니까?" } }, class: "impd-btn impd-btn-secondary" %>
          <% else %>
            <%= link_to "로그인", member_login_path, class: "impd-btn impd-btn-secondary" %>
            <%= link_to "무료로 시작하기", member_signup_path, class: "impd-btn impd-btn-primary" %>
          <% end %>
        </div>
      </div>
      <% end %>
    </div>

    <%= render "shared/flash" unless action_name == "new" && %w[member_auth member_sessions].include?(controller_path) %>

    <% hide_frap = %w[public_profile public_photos member_reviews growth member_brand_ops].include?(controller_path) || (action_name == "new" && %w[member_signups member_auth member_sessions].include?(controller_path)) || request.path.match?(%r{\A/[^/]+/admin(?:/|\z)}) %>
    <main id="main-content" tabindex="-1" class="<%= "impd-main-with-frap" unless hide_frap %>">
      <%= yield %>
    </main>

    <% unless controller_path == "chopd/home" && action_name == "index" %>
      <div style="padding: 16px 24px 22px; text-align: center; font-family: var(--impd-font-sans); font-size: 12px; color: var(--impd-soft-muted);">
        <%= link_to "개인정보처리방침", privacy_path, style: "color: inherit; text-decoration: underline; text-underline-offset: 3px;" %>
      </div>
    <% end %>

    <%# 홍보 영상 팝업 (data-promo-popup 트리거 + 첫 방문자 자동 재생) %>
    <%= render "shared/promo_popup" unless visitor_page %>

    <% unless hide_frap %>
      <% frap_href = member_signed_in? ? "/#{current_member.slug}/admin/dashboard" : member_signup_path %>
      <% frap_label = member_signed_in? ? "내 페이지 관리" : "내 페이지 만들기" %>
      <%= link_to frap_href, class: "impd-frap" do %>
        <%= lni_icon(member_signed_in? ? "pencil-1" : "plus", size: 20) %>
        <%= frap_label %>
      <% end %>
    <% end %>
  </body>
</html>
