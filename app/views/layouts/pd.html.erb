<!DOCTYPE html>
<html lang="ko">
  <head>
    <%= stylesheet_link_tag "lineicons", "data-turbo-track": "reload" %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for?(:title) ? yield(:title) + " | PD 대시보드" : "imPD Dashboard" %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: '#00A1E0',
              'primary-dark': '#0078A8',
              navy: '#16325C',
              surface: '#F3F2F2',
            }
          }
        }
      }
    </script>
    <style>
      .pd-menu-button { display: none; }
      .pd-menu-close { display: none; }
      .pd-mobile-links { display: none; }
      @media (max-width: 767px) {
        [data-pd-menu] { transform: translateX(-100%); transition: transform .2s; }
        body:has(.pd-backdrop:not([hidden])) [data-pd-menu] { transform: translateX(0); }
        .pd-backdrop:not([hidden]) { display: block; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 35; }
        .pd-main.ml-60 { margin-left: 0; }
        .pd-menu-button { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; flex: 0 0 44px; font-size: 22px; }
        .pd-menu-close { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; flex: 0 0 44px; font-size: 22px; }
        .pd-header-title { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        header .pd-header-links { display: none; }
        .pd-mobile-links { display: block; }
        .pd-main main { padding: 16px; }
      }
    </style>
    <%= render "shared/feedback_styles" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-surface min-h-screen flex" data-controller="impd-nav" data-action="keydown.esc@window->impd-nav#close">
    <div class="pd-backdrop" data-impd-nav-target="panel" data-action="click->impd-nav#close" hidden></div>
    <!-- 사이드바 -->
    <aside id="pd-navigation" data-pd-menu class="w-60 bg-white border-r text-gray-700 flex-shrink-0 fixed top-0 left-0 h-full overflow-y-auto z-40 shadow-sm">
      <div class="p-4 border-b flex items-center justify-between">
        <a href="<%= pd_root_path %>" class="flex items-center space-x-2 md:w-full">
          <div class="w-8 h-8 bg-primary rounded-full flex items-center justify-center">
            <span class="text-white font-bold text-xs">최</span>
          </div>
          <span class="font-bold text-navy text-sm">PD 대시보드</span>
        </a>
        <button type="button" class="pd-menu-close" aria-label="메뉴 닫기" aria-controls="pd-navigation" data-action="impd-nav#close"><%= lni_icon "xmark" %></button>
      </div>

      <nav class="p-3 space-y-1" data-action="click->impd-nav#closeOnLink">
        <%= link_to pd_root_path, class: "flex items-center space-x-2 px-3 py-2 rounded text-sm transition-colors #{request.path == pd_root_path ? 'bg-primary/10 text-primary font-medium' : 'text-gray-500 hover:text-navy hover:bg-gray-50'}" do %>
          <%= lni_icon "home-2", class: "w-4 h-4" %>
          <span>홈</span>
        <% end %>
        <%= link_to edit_pd_profile_path, class: "flex items-center space-x-2 px-3 py-2 rounded text-sm transition-colors #{request.path.include?('/pd/profile') ? 'bg-primary/10 text-primary font-medium' : 'text-gray-500 hover:text-navy hover:bg-gray-50'}" do %>
          <%= lni_icon "user-4", class: "w-4 h-4" %>
          <span>프로필</span>
        <% end %>
        <%= link_to pd_hero_images_path, class: "flex items-center space-x-2 px-3 py-2 rounded text-sm transition-colors #{request.path.include?('/pd/hero') ? 'bg-primary/10 text-primary font-medium' : 'text-gray-500 hover:text-navy hover:bg-gray-50'}" do %>
          <%= lni_icon "gallery", class: "w-4 h-4" %>
          <span>히어로 이미지</span>
        <% end %>
        <%= link_to pd_sns_accounts_path, class: "flex items-center space-x-2 px-3 py-2 rounded text-sm transition-colors #{request.path.include?('/pd/sns') ? 'bg-primary/10 text-primary font-medium' : 'text-gray-500 hover:text-navy hover:bg-gray-50'}" do %>
          <%= lni_icon "share-1", class: "w-4 h-4" %>
          <span>SNS 계정</span>
        <% end %>
        <%= link_to pd_profile_accounts_path, class: "flex items-center space-x-2 px-3 py-2 rounded text-sm transition-colors #{request.path.include?('/pd/people_accounts') ? 'bg-primary/10 text-primary font-medium' : 'text-gray-500 hover:text-navy hover:bg-gray-50'}" do %>
          <%= lni_icon "id-card", class: "w-4 h-4" %>
          <span>인물정보 계정</span>
        <% end %>
        <%= link_to pd_scheduled_posts_path, class: "flex items-center space-x-2 px-3 py-2 rounded text-sm transition-colors #{request.path.include?('/pd/scheduled') ? 'bg-primary/10 text-primary font-medium' : 'text-gray-500 hover:text-navy hover:bg-gray-50'}" do %>
          <%= lni_icon "calendar-days", class: "w-4 h-4" %>
          <span>예약 발행</span>
        <% end %>
        <%= link_to pd_kanban_projects_path, class: "flex items-center space-x-2 px-3 py-2 rounded text-sm transition-colors #{request.path.include?('/pd/kanban') ? 'bg-primary/10 text-primary font-medium' : 'text-gray-500 hover:text-navy hover:bg-gray-50'}" do %>
          <%= lni_icon "dashboard-square-1", class: "w-4 h-4" %>
          <span>칸반 보드</span>
        <% end %>
        <%= link_to pd_leads_path, class: "flex items-center space-x-2 px-3 py-2 rounded text-sm transition-colors #{request.path.include?('/pd/leads') ? 'bg-primary/10 text-primary font-medium' : 'text-gray-500 hover:text-navy hover:bg-gray-50'}" do %>
          <%= lni_icon "envelope-1", class: "w-4 h-4" %>
          <span>뉴스레터 구독</span>
        <% end %>

        <div class="pt-4 mt-4 border-t">
          <div class="pd-mobile-links">
            <%= link_to root_path, target: "_blank", rel: "noopener", class: "flex items-center space-x-2 px-3 py-2 rounded text-sm transition-colors text-gray-500 hover:text-navy hover:bg-gray-50" do %>
              <%= lni_icon "globe-1", class: "w-4 h-4" %>
              <span>공개 사이트 보기</span>
            <% end %>
            <% if current_admin_user&.admin? %>
              <%= link_to admin_root_path, class: "flex items-center space-x-2 px-3 py-2 rounded text-sm transition-colors text-gray-500 hover:text-navy hover:bg-gray-50" do %>
                <%= lni_icon "shield-2", class: "w-4 h-4" %>
                <span>Admin</span>
              <% end %>
            <% end %>
          </div>
          <%= link_to destroy_admin_user_session_path, data: { turbo_method: :delete },
              class: "flex items-center space-x-2 px-3 py-2 rounded text-sm text-gray-400 hover:text-red-500 hover:bg-red-50 transition-colors" do %>
            <%= lni_icon "exit", class: "w-4 h-4" %>
            <span>로그아웃</span>
          <% end %>
        </div>
      </nav>
    </aside>

    <!-- 메인 영역 -->
    <div class="pd-main ml-60 flex-1 flex flex-col min-h-screen min-w-0">
      <header class="bg-white border-b px-6 py-3 flex items-center justify-between sticky top-0 z-30">
        <button type="button" class="pd-menu-button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="pd-navigation" data-impd-nav-target="button" data-action="impd-nav#toggle"><span data-impd-nav-target="menuIcon"><%= lni_icon "menu-hamburger-1" %></span><span data-impd-nav-target="closeIcon" hidden><%= lni_icon "xmark" %></span></button>
        <div class="flex min-w-0 items-center gap-2">
          <span class="pd-header-title text-sm font-semibold text-gray-700"><%= content_for?(:title) ? yield(:title) : "대시보드" %></span>
          <span class="shrink-0 rounded-full bg-primary/10 px-2 py-0.5 text-xs font-semibold text-navy">PD</span>
        </div>
        <div class="pd-header-links flex items-center space-x-3">
          <%= link_to root_path, target: "_blank", class: "text-xs text-gray-500 hover:text-primary" do %>
            공개 사이트 보기
          <% end %>
          <% if current_admin_user&.admin? %>
            <%= link_to admin_root_path, class: "text-xs text-gray-500 hover:text-primary" do %>
              Admin
            <% end %>
          <% end %>
        </div>
      </header>

      <%= render "shared/flash" %>

      <main class="flex-1 p-6">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
