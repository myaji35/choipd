<% content_for :title, "imPD — 1인 사업자·크리에이터의 홍보 페이지" %>
<% content_for :description, "SNS 사진, 자격증, 그동안 쌓은 경력과 고객 후기 — 갖고 있는 그대로 올리기만 하세요. imPD가 정리해 믿음직한 홍보 페이지로 만들어 드립니다." %>

<% content_for :head do %>
  <%= stylesheet_link_tag "impd_home", "data-turbo-track": "reload" %>
<% end %>

<%
  primary_label = member_signed_in? ? "내 페이지 관리" : "내 페이지 만들기"
  primary_path = member_signed_in? ? "/#{current_member.slug}/admin/dashboard" : member_signup_path
  secondary_label = member_signed_in? ? "내 페이지 보기" : "예시 보기"
  secondary_path = member_signed_in? ? "/#{current_member.slug}" : example_profile_path
  primary_icon = member_signed_in? ? "pencil-1" : "arrow-right"
%>

<div class="impd-home">
  <section id="hero" class="impd-home-hero" aria-labelledby="home-title">
    <div class="impd-wrap impd-hero-grid impd-fade-in">
      <div>
        <h1 id="home-title" class="impd-hero">1인 사업자·크리에이터의 홍보 페이지</h1>
        <p class="impd-home-lead">SNS 사진, 자격증, 경력, 고객 후기를 가진 그대로 올리세요. imPD가 정리해 홍보 페이지로 만들어 드립니다.</p>
        <div class="impd-hero-actions">
          <%= link_to primary_path, class: "impd-btn impd-btn-primary", data: { home_actions_target: "primary" } do %>
            <%= primary_label %> <%= lni_icon primary_icon %>
          <% end %>
          <%= link_to secondary_path, class: "impd-btn impd-btn-secondary" do %>
            <%= secondary_label %> <%= lni_icon "arrow-right" %>
          <% end %>
        </div>
        <p class="impd-small impd-hero-fact">월 0원 · 카드 등록 없이 시작</p>
      </div>
      <%= render "hero_phone_preview" %>
    </div>
  </section>

  <section id="how" class="impd-home-section impd-home-ceramic" aria-labelledby="how-title">
    <div class="impd-wrap">
      <h2 id="how-title" class="impd-section-title">자료를 올리면 페이지가 됩니다</h2>
      <div class="impd-home-grid impd-home-stats">
        <% [
          ["0원", "무료로 시작", "카드 등록 없이 바로 만들어요"],
          ["5분", "첫 페이지 완성", "가진 자료를 올리면 정리는 저희가"],
          ["0%", "수수료 없음", "문의·예약은 고객과 직접 연결돼요"]
        ].each do |number, label, description| %>
          <div>
            <p class="impd-stat-num"><%= number %></p>
            <p class="impd-home-strong"><%= label %></p>
            <p><%= description %></p>
          </div>
        <% end %>
      </div>
      <ol class="impd-home-grid impd-home-steps">
        <% [
          ["01", "업로드", "사진·자격증·이력서·SNS 링크, 무엇이든 올려 주세요."],
          ["02", "자동 정리", "AI가 카테고리별로 분류하고 핵심 정보를 추출합니다."],
          ["03", "페이지 완성", "잡지처럼 다듬어진 당신만의 홍보 페이지가 열립니다."]
        ].each do |number, title, description| %>
          <li class="impd-c2-card">
            <span class="impd-label"><%= number %></span>
            <h3 class="impd-subtitle"><%= title %></h3>
            <p><%= description %></p>
          </li>
        <% end %>
      </ol>
      <%= link_to promo_watch_path, class: "impd-link impd-home-more", data: { promo_popup: true } do %>
        <%= lni_icon "play", size: 16 %> 홍보 영상 보기 (30초)
      <% end %>
    </div>
  </section>

  <section id="sources" class="impd-home-section" aria-labelledby="sources-title">
    <div class="impd-wrap">
      <h2 id="sources-title" class="impd-section-title">페이지가 되는 자료 6가지</h2>
      <div class="impd-home-grid">
        <% [
          ["camera-1", "현장 사진", "사진 갤러리"],
          ["book-1", "수료증·자격증", "달란트 배지"],
          ["camera-movie-1", "유튜브·SNS", "영상·SNS 모음"],
          ["pencil-1", "강의 이력", "경력 연표"],
          ["star-fat", "고객 후기", "후기 모음"],
          ["briefcase-1", "프로젝트", "작업 사례"]
        ].each do |icon, title, result| %>
          <article class="impd-c2-card impd-home-source">
            <%= lni_icon icon, size: 24 %>
            <h3 class="impd-subtitle"><%= title %></h3>
            <p><%= lni_icon "arrow-right" %> <%= result %></p>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <%
    fallback_cards = [
      { name: "보험설계사 예시", role: "insurance_agent", region: "분당", bio: "가족 보장을 쉽게 설명해 드려요", example: true },
      { name: "1인 크리에이터 예시", role: "freelancer", region: "마포", bio: "작은 가게의 이야기를 영상으로", example: true },
      { name: "동네 가게 예시", role: "shopowner", region: "정자동", bio: "가게 소개와 메뉴를 한 페이지에", example: true },
    ]
    real_cards = (@featured_members || []).map do |m|
      { name: m.name.to_s, role: m.profession.to_s, region: m.region, bio: m.bio, image: m.profile_image, slug: m.slug }
    end
    examples = fallback_cards.first([3 - real_cards.size, 0].max)
    cards = real_cards + examples
  %>
  <section id="people" class="impd-home-section impd-home-ceramic" aria-labelledby="people-title">
    <div class="impd-wrap">
      <h2 id="people-title" class="impd-section-title">imPD를 쓰는 사람들</h2>
      <% if @member_count.positive? %>
        <p class="impd-label impd-member-count">지금 <%= @member_count %>명이 운영 중</p>
      <% end %>
      <div class="impd-professions">
        <% [
          ["보험설계사", "insurance_agent", "shield-2-check"],
          ["동네 가게 사장님", "shopowner", "cart-1"],
          ["1인 크리에이터", "freelancer", "camera-1"],
          ["강사·코치", "educator", "book-1"],
          ["공인중개사", "realtor", "home-2"],
          ["작가", "author", "pencil-1"]
        ].each do |label, code, icon| %>
          <%= link_to explore_path(profession: code), class: "impd-profession-pill" do %>
            <%= lni_icon icon, size: 18 %> <%= label %>
          <% end %>
        <% end %>
      </div>
      <div class="impd-home-grid impd-member-grid">
        <% cards.each do |c| %>
          <%= render "shared/member_card", c: c, home_card: true %>
        <% end %>
      </div>
      <% if examples.any? %>
        <p class="impd-home-note">예시 카드는 실제 회원이 아니에요. 운영 중인 카드를 누르면 회원 페이지로 이동합니다.</p>
      <% end %>
    </div>
  </section>

  <% moments = @featured_moments.select { |photo| photo.image.attached? } %>
  <% if moments.any? %>
    <section id="moments" class="impd-home-section" aria-labelledby="moments-title">
      <div class="impd-wrap">
        <h2 id="moments-title" class="impd-section-title">회원들이 올린 사진과 영상</h2>
        <p class="impd-home-intro">imPD 회원들이 직접 올린 사진과 영상입니다.</p>
        <p class="impd-label"><%= moments.size %>장</p>
        <div class="impd-moments-grid">
          <% moments.each_with_index do |photo, index| %>
            <% media_label = "#{photo.member.name}의 #{photo.category}" %>
            <%= link_to "/#{photo.member.slug}", class: class_names("impd-moment", "impd-moment-tall": [0, 5].include?(index)),
                aria: (photo.video? ? { label: "#{media_label} 영상" } : nil) do %>
              <% if photo.video? %>
                <video src="<%= photo.display_url %>" class="impd-media-cover" aria-label="<%= media_label %> 영상"
                       preload="metadata" muted playsinline
                       data-action="pointerenter->home-actions#playPreview pointerleave->home-actions#resetPreview"></video>
              <% else %>
                <img loading="lazy" decoding="async" src="<%= photo.thumbnail_url %>"
                     data-fallback="<%= photo.display_url %>"
                     onerror="if (this.dataset.fallback) { this.src = this.dataset.fallback; this.dataset.fallback = ''; }"
                     alt="<%= media_label %>" class="impd-media-cover">
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <section id="examples" class="impd-home-section" aria-labelledby="examples-title">
    <div class="impd-wrap">
      <h2 id="examples-title" class="impd-section-title">직업별 활용 예시</h2>
      <div class="impd-home-grid">
        <% [
          ["보험설계사", "상담 분야와 자격을 한 페이지에 정리하고, 명함 QR로 고객이 바로 상담을 신청해요.", "na-seolgye"],
          ["1인 크리에이터", "작업물·채널·협업 문의를 한곳에 모아, 브랜드 담당자에게 링크 하나로 보내요.", "yujin-studio"],
          ["동네 가게 사장님", "가게 소개·메뉴·후기를 정리하고, 지역 주민에게 Townin 전단지로 알려요.", nil]
        ].each do |title, description, slug| %>
          <article class="impd-c2-card">
            <h3 class="impd-subtitle"><%= title %></h3>
            <p><%= description %></p>
            <% if slug && Member.publicly_visible.exists?(slug: slug) %>
              <%= link_to "/#{slug}", class: "impd-link impd-home-more" do %>
                예시 페이지 보기 <%= lni_icon "arrow-right" %>
              <% end %>
            <% end %>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section id="pricing" class="impd-home-section impd-home-ceramic" aria-labelledby="pricing-title">
    <div class="impd-wrap">
      <h2 id="pricing-title" class="impd-section-title">요금제</h2>
      <p class="impd-home-intro">무료 요금제는 월 0원입니다. 유료 요금제는 준비 중이에요. 열리면 알려 드려요.</p>
      <p class="impd-home-intro">첫 페이지를 연 순간부터 방문 수·후기·수료증이 쌓입니다. imPD는 그 기록을 성장 기록으로 페이지에 차곡차곡 쌓아 드려요.</p>
      <div class="impd-home-grid impd-pricing-grid">
        <% [
          ["FREE", "누구나 무료", "0원 / 월", ["공개 페이지 1개", "QR · 디지털 명함", "방문자 분석", "AI 자동 정리 · 3회"], false],
          ["PRO", "1인 사업가 기본", "9,900원 / 월", ["무제한 갤러리", "AI 자동 정리 · 무제한", "맞춤 도메인", "후기·예약 수집", "리워드 골드 배지"], true],
          ["STUDIO", "공방 · 소수팀", "29,000원 / 월", ["Pro 전부 +", "최대 5인 공동 편집", "클래스 예약·결제", "월간 성과 리포트"], false],
        ].each do |tag, title, price, features, highlight| %>
          <article class="impd-c2-card <%= "impd-plan-highlight" if highlight %>">
            <p class="impd-label"><%= tag %><% if tag != "FREE" %> <span class="impd-plan-status">준비 중</span><% end %></p>
            <h3 class="impd-subtitle"><%= title %></h3>
            <% amount, unit = price.split(" / ", 2) %>
            <p class="impd-plan-price"><span class="impd-stat-num"><%= amount %></span> / <%= unit %></p>
            <ul class="impd-plan-features">
              <% features.each do |feature| %>
                <li><%= lni_icon "check", size: 16 %><span><%= feature %></span></li>
              <% end %>
            </ul>
            <% if tag == "FREE" %>
              <%= link_to primary_label, primary_path, class: "impd-btn impd-btn-primary" %>
            <% end %>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <section id="faq" class="impd-home-section" aria-labelledby="faq-title">
    <div class="impd-wrap">
      <h2 id="faq-title" class="impd-section-title">자주 묻는 질문</h2>
      <div class="impd-faq">
        <% [
          ["정말 무료로 시작할 수 있나요?", "네. 무료 요금제는 월 0원이며 가입할 때 카드 정보를 입력하지 않습니다."],
          ["내 페이지 주소는 어떻게 되나요?", "공개 페이지 주소는 #{public_host}/내 주소 형식입니다. 가입할 때 주소를 직접 입력하거나 비워 두어 자동으로 만들 수 있어요."],
          ["언제든 탈퇴할 수 있나요?", "회원 관리 화면에서 탈퇴할 수 있어요. 탈퇴하면 공개 페이지가 닫히고 개인정보는 익명화되며 업로드한 문서와 사진은 삭제됩니다. 거래·후기·문의 기록은 남습니다."],
          ["외부 노출과 광고는 어떻게 동의하나요?", "회원 관리의 노출·광고 동의 화면에서 선택하고 철회할 수 있어요. SocialDoctors 브랜드 노출 정보에는 이메일과 전화번호가 포함되지 않습니다."],
          ["보험설계사도 쓸 수 있나요?", "네. 가입할 때 직업으로 보험설계사를 선택할 수 있어요."],
          ["사진이나 자료가 없어도 가입할 수 있나요?", "네. 이메일 가입에는 이름, 이메일, 비밀번호와 비밀번호 확인, 이용약관 및 개인정보처리방침 동의가 필요해요. 사진이나 자료는 가입 필수 항목이 아닙니다."]
        ].each do |question, answer| %>
          <details>
            <summary><%= question %><%= lni_icon "chevron-down", size: 20 %></summary>
            <p><%= answer %></p>
          </details>
        <% end %>
      </div>
    </div>
  </section>

  <% if brand_ops_public? %>
    <section id="growth" class="impd-home-section impd-home-growth" aria-labelledby="growth-title">
      <div class="impd-wrap">
        <h2 id="growth-title" class="impd-section-title">함께 자라는 imPD</h2>
        <p>회원들의 활동과 브랜드 이야기를 살펴보세요.</p>
        <a href="/growth" class="impd-link">imPD 성장 이야기 보기 →</a>
      </div>
    </section>
  <% end %>

  <section id="close" class="impd-home-section impd-home-close" aria-labelledby="close-title">
    <div class="impd-wrap">
      <h2 id="close-title" class="impd-section-title">지금 가지고 있는 자료 한 장으로 시작하세요</h2>
      <div class="impd-home-actions">
        <%= link_to primary_path, class: "impd-btn impd-btn-primary" do %>
          <%= primary_label %> <%= lni_icon primary_icon %>
        <% end %>
        <%= link_to secondary_label, secondary_path, class: "impd-btn impd-btn-secondary" %>
      </div>
      <p class="impd-small">카드 등록 불필요 · 언제든 비공개</p>
    </div>
  </section>

  <footer class="impd-home-footer">
    <div class="impd-wrap impd-home-footer-inner">
      <div>
        <strong>imPD.</strong>
        <p>혼자 일하는 사람을 위한 홍보 페이지</p>
        <p>운영: 주식회사 가가호호</p>
      </div>
      <nav aria-label="푸터 메뉴">
        <%= link_to "둘러보기", explore_path %>
        <%= link_to "가격", "/#pricing" %>
        <%= link_to "자주 묻는 질문", "/#faq" %>
        <%= link_to "문의하기", new_inquiry_path %>
        <%= link_to "이용약관", terms_path %>
        <%= link_to "개인정보처리방침", privacy_path %>
      </nav>
    </div>
  </footer>
</div>
