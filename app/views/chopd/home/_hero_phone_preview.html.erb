<div class="hero-phone-preview">
  <% sample_member = Member.publicly_visible.find_by(slug: "na-seolgye") %>
  <%= content_tag(sample_member ? :a : :div, class: "hero-phone-link", href: sample_member ? "/na-seolgye" : nil, aria: sample_member ? { label: "예시 페이지 보기" } : nil) do %>
    <div class="hero-phone">
      <div class="hero-phone-screen">
        <span class="hero-phone-badge">예시</span>
        <div class="hero-phone-avatar">나</div>
        <div class="hero-phone-name">나설계</div>
        <div class="hero-phone-role">보험설계사 · 분당 정자동</div>
        <p class="hero-phone-bio">꼭 필요한 보장만 쉽게 설명해 드려요.</p>
        <div class="hero-phone-actions">
          <div class="hero-phone-action hero-phone-action-primary">상담 신청하기</div>
          <div class="hero-phone-action">카카오톡 문의</div>
        </div>
        <div class="hero-phone-chips">
          <span class="hero-phone-chip">손해보험</span><span class="hero-phone-chip">생명보험</span><span class="hero-phone-chip">가족 보장 설계</span>
        </div>
        <div class="hero-phone-services">
          <strong class="hero-phone-services-title">서비스</strong>
          <div class="hero-phone-service"><span>가족 보장 점검 · 무료</span><%= lni_icon "arrow-right", class: "hero-phone-service-chevron" %></div>
          <div class="hero-phone-service"><span>보험금 청구 도움 · 무료</span><%= lni_icon "arrow-right", class: "hero-phone-service-chevron" %></div>
        </div>
        <div class="hero-phone-qr">
          <% if sample_member %>
            <%= image_tag "/qr/#{sample_member.slug}.svg", size: "48x48", alt: "" %>
          <% end %>
          <span>명함 QR</span>
        </div>
        <div class="hero-phone-footer">
          <span class="hero-phone-footer-action">전화</span>
          <span class="hero-phone-footer-action">문의</span>
        </div>
      </div>
    </div>
  <% end %>
</div>
